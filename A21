    $A12_UI = Get-Val "Межосевое расстояние (A12)" 136.476

    if ($null -eq $M -or $null -eq $UD -or $null -eq $H1 -or $null -eq $H -or $null -eq $SD1) {
        Add-Step $steps "Критическая ошибка" "Не заполнены базовые параметры" "Заполните M, UD, H1, H, SD1"
        return $steps
    }

    if ($M -le 0 -or $ZU -le 0 -or $DLU -le 0 -or $Z1 -le 0 -or $DL1 -le 0) {
        Add-Step $steps "Критическая ошибка" "Некорректная геометрия" "Модуль, зубья и диаметры должны быть больше нуля"
        return $steps
    }

    $helixSign = Get-HelixSign $NAPRText
    $B_abs = if ($null -ne $B) { [math]::Abs([double]$B) } else { 0.0 }
    $B_eff = $helixSign * $B_abs

    $AU = [double]$UD
    $AU_rad = $AU * [math]::PI / 180.0
    $MU = [double]$M
    $TU = [math]::PI * $MU
    $SU_no = $TU - $SD1
    $HU1 = $H - $H1
    $HU = $H + 0.3 * $M

    Add-Step $steps "Направление линии зуба" "SIGN = +1 для правого, -1 для левого" ("SIGN = {0}; B_эфф = {1}°" -f $helixSign, (Fmt $B_eff 6))
    Add-Step $steps "Расчет профильного угла по нормали" "AU = UD" ("AU = {0}°" -f (Fmt $AU 8))
    Add-Step $steps "Расчет модуля нормального" "MU = M" ("MU = {0}" -f (Fmt $MU 8))
    Add-Step $steps "Расчет шага нормального" "TU = π * MU" ("TU = {0} мм" -f (Fmt $TU 12))
    Add-Step $steps "Расчет толщины зуба без учета припуска" "SU = TU - SD1" ("SU = {0} мм" -f (Fmt $SU_no 12))
    Add-Step $steps "Получение расчетной высоты головки фрезы" "HU1 = H - H1" ("HU1 = {0} мм" -f (Fmt $HU1 12))
    Add-Step $steps "Получение полной высоты зуба" "HU = H + 0.3 * M" ("HU = {0} мм" -f (Fmt $HU 12))
    Add-Step $steps "Наружный диаметр фрезы" "DLU = заданное значение" ("DLU = {0} мм" -f (Fmt $DLU 8))
    Add-Step $steps "Число зубьев фрезы" "ZU = заданное значение" ("ZU = {0}" -f (Fmt $ZU 8))

    $AV_rad = $AV * [math]::PI / 180.0
    $K = ([math]::PI * $DLU / $ZU) * [math]::Tan($AV_rad)
    Add-Step $steps "Получение падения затылка" "K = (π * DLU / ZU) * tg(AV)" ("K = {0} мм" -f (Fmt $K 12))

    $DU = $DLU - 2.0 * $HU1 - 0.5 * $K
    $asinArg = Clamp (Safe-Div ($MU * $U) $DU 0.0) -1.0 1.0
    $W_rad = [math]::Asin($asinArg)
    $W = $W_rad * 180.0 / [math]::PI
    Add-Step $steps "Получение диаметра начальной окружности фрезы" "DU = DLU - 2*HU1 - 0.5*K" ("DU = {0} мм" -f (Fmt $DU 12))
    Add-Step $steps "Получение угла подъема витков на начальной окружности" "W = arcsin((MU * U) / DU)" ("W = {0}°" -f (Fmt $W 12))

    $cosW = [math]::Cos($W_rad)
    $T0 = Safe-Div $TU $cosW 0.0
    $tanW = [math]::Tan($W_rad)
    if ([math]::Abs($tanW) -lt 1e-15) {
        $T = [double]::PositiveInfinity
    } else {
        $T = $T0 * [math]::Pow((1.0 / $tanW), 2)
    }

    $TX = Safe-Div ($TU * $U) $cosW 0.0
    Add-Step $steps "Получение хода витков по оси" "TX = (TU * U) / cos(W)" ("TX = {0} мм" -f (Fmt $TX 12))
    Add-Step $steps "Определение направления витков фрезы" "Направление спирали режущей части" ("NAPR = {0}" -f $NAPRText)
    Add-Step $steps "Направление винтовых стружечных канавок" "Положение канавок для вывода стружки" "NKAN = Осевые"

    $DT = $DLU - 2 * $HU1 - 0.2 * $K
    $K1 = 1.3 * $K
    $HK = $HU + (($K + $K1) / 2.0) + 0.7
    Add-Step $steps "Получение среднего расчетного диаметра" "DT = DLU - 2*HU1 - 0.2*K" ("DT = {0} мм" -f (Fmt $DT 12))
    Add-Step $steps "Получение двойного затылования" "K1 = 1.3 * K" ("K1 = {0} мм" -f (Fmt $K1 12))
    Add-Step $steps "Получение глубины канавки" "HK = HU + (K + K1)/2 + 0.7" ("HK = {0} мм" -f (Fmt $HK 12))

    $R1 = Safe-Div (0.12 * $MU) (1.0 - [math]::Sin($AU_rad)) 0.0
    $R2 = 0.3 * $M
    Add-Step $steps "Получение радиуса закругления головки зуба" "R1 = (0.12*MU)/(1-sin(AU))" ("R1 = {0}" -f (Fmt $R1 12))
    Add-Step $steps "Получение радиуса закругления у ножки зуба" "R2 = 0.3 * M" ("R2 = {0}" -f (Fmt $R2 12))
    Add-Step $steps "Получение шага по оси" "T0 = TU / cos(W)" ("T0 = {0} мм" -f (Fmt $T0 12))
    Add-Step $steps "Получение осевого шага винтовой стружечной канавки" "T = T0 * ctg²(W)" ("T = {0}" -f (Fmt $T 9))

    $AOC_rad = [math]::Atan(Safe-Div ([math]::Tan($AU_rad)) ([math]::Cos($W_rad)) 0.0)
    $AOC = $AOC_rad * 180.0 / [math]::PI
    Add-Step $steps "Получение профильного угла по оси" "AOC = arctg(tg(AU)/cos(W))" ("AOC = {0}°" -f (Fmt $AOC 12))

    $SOC = Safe-Div $TU (2.0 * [math]::Cos($W_rad)) 0.0
    Add-Step $steps "Получение толщины зуба исходной рейки по оси" "SOC = TU / (2 * cos(W))" ("SOC = {0} мм" -f (Fmt $SOC 12))

    $HUR = Safe-Div (($SOC - Safe-Div $SU_no ([math]::Cos($W_rad)) 0.0)) (2.0 * [math]::Tan($AOC_rad)) 0.0 + $HU1
    Add-Step $steps "Получение высоты головки зуба исходной рейки" "HUR = ((SOC - SU/cos(W)) / (2*tg(AOC))) + HU1" ("HUR = {0} мм" -f (Fmt $HUR 12))

    $Z1i = [double]$Z1
    $Z2i = [double]$Z2
    $inv_UD = Get-Inv $AU_rad

    $inv_AW = $null
    $AW_z_rad = $null
    $AW_z = $null
    $A12_calc = $null

    if ($null -ne $Z2 -and $null -ne $X2 -and $null -ne $X1) {
        $den = ($Z2i + $Z1i)
        $inv_AW = Safe-Div ((2.0 * ($X2 + $X1) * [math]::Tan($AU_rad))) $den 0.0 + $inv_UD
        $AW_z_rad = Get-AlphaFromInv $inv_AW
        $AW_z = $AW_z_rad * 180.0 / [math]::PI
        $A12_calc = 0.5 * $M * ($Z2i + $Z1i) * Safe-Div ([math]::Cos($AU_rad)) ([math]::Cos($AW_z_rad)) 0.0

        Add-Step $steps "Получение эвольвенты угла зацепления" "inv(AW) = (2*(X2+X1)*tg(UD))/(Z2+Z1) + inv(UD)" ("inv(AW) = {0}" -f (Fmt $inv_AW 12))
        Add-Step $steps "Получение угла зацепления" "AW = inv⁻¹(inv(AW))" ("AW = {0}°" -f (Fmt $AW_z 12))
        Add-Step $steps "Получение межосевого расстояния" "A12 = 0.5*M*(Z2+Z1)*(cos(UD)/cos(AW))" ("A12 = {0} мм" -f (Fmt $A12_calc 12))
    } else {
        Add-Step $steps "Шаги 25-27" "Нет данных для сопряженной пары" "Пропущено"
    }

    $DD1 = $M * $Z1i
    Add-Step $steps "Получение делительного диаметра детали" "DD1 = M * Z1" ("DD1 = {0} мм" -f (Fmt $DD1 12))

    $DD2 = $null
    if ($null -ne $Z2) {
        $DD2 = $M * $Z2i
        Add-Step $steps "Получение делительного диаметра сопряженной детали" "DD2 = M * Z2" ("DD2 = {0} мм" -f (Fmt $DD2 12))
    } else {
        Add-Step $steps "Получение делительного диаметра сопряженной детали" "DD2 = M * Z2" "Пропущено"
    }

    $DO1 = $DD1 * [math]::Cos($AU_rad)
    Add-Step $steps "Получение основного диаметра детали" "DO1 = DD1 * cos(UD)" ("DO1 = {0} мм" -f (Fmt $DO1 12))

    $DO2 = $null
    if ($null -ne $DD2) {
        $DO2 = $DD2 * [math]::Cos($AU_rad)
        Add-Step $steps "Получение основного диаметра сопряженной детали" "DO2 = DD2 * cos(UD)" ("DO2 = {0} мм" -f (Fmt $DO2 12))
    } else {
        Add-Step $steps "Получение основного диаметра сопряженной детали" "DO2 = DD2 * cos(UD)" "Пропущено"
    }

    $P1 = $null
    $HY = $null
    $C = $null
    $A_val = $null

    if ($null -ne $A12_calc -and $null -ne $DL2 -and $null -ne $DO2) {
        $sqrtArg = [math]::Max(0.0, ([math]::Pow($DL2, 2) - [math]::Pow($DO2, 2)))
        $P1 = $A12_calc * [math]::Sin($AW_z_rad) - 0.5 * [math]::Sqrt($sqrtArg)
        Add-Step $steps "Получение радиуса кривизны эвольвенты" "P1 = A12*sin(AW) - 0.5*sqrt(DL2²-DO2²)" ("P1 = {0} мм" -f (Fmt $P1 12))

        $sd2Val = if ($null -ne $SD2) { $SD2 } else { $SD1 }
        $HY = $HU1 - (($DD1 / 2.0) * [math]::Sin($AU_rad) - $P1 - (($sd2Val - $SD1) / 2.0) * [math]::Sin($AU_rad))
        Add-Step $steps "Получение расстояния до активного участка" "HY = HU1 - (DD1/2*sin(AU) - P1 - (SD2-SD1)/2*sin(AU))" ("HY = {0} мм" -f (Fmt $HY 12))

        $C = Safe-Div $HY ([math]::Cos($AOC_rad)) 0.0
        Add-Step $steps "Получение длины усика" "C = HY / cos(AOC)" ("C = {0} мм" -f (Fmt $C 12))

        $A_val = (($sd2Val - $SD1) / 2.0) + 0.05
        Add-Step $steps "Получение значения высоты усика" "A = (SD2 - SD1)/2 + 0.05" ("A = {0} мм" -f (Fmt $A_val 12))
    } else {
        Add-Step $steps "Шаги 32-35" "Нет данных для фланкирования" "Пропущено"
    }

    $F = 0.75
    Add-Step $steps "Величина фаски зуба фрезы" "F = 0.75" ("F = {0} мм" -f (Fmt $F 8))

    $AUF = $AU + 10.0
    $AUF_rad = $AUF * [math]::PI / 180.0
    Add-Step $steps "Получение значения угла фланка" "AUF = AU + 10" ("AUF = {0}°" -f (Fmt $AUF 12))

    $DC = $DL1 - 2.0 * $F
    Add-Step $steps "Получение диаметра начала фланка" "DC = DL1 - 2*F" ("DC = {0} мм" -f (Fmt $DC 12))

    $acArg = Clamp (Safe-Div ($DD1 * [math]::Cos($AU_rad)) $DC 0.0) -1.0 1.0
    $AC_rad = [math]::Acos($acArg)
    $AC = $AC_rad * 180.0 / [math]::PI
    Add-Step $steps "Получение угла давления на диаметре DC" "AC = arccos((DD1*cos(AU))/DC)" ("AC = {0}°" -f (Fmt $AC 12))

    $afcArg = Clamp (Safe-Div ($DD1 * [math]::Cos($AUF_rad)) $DC 0.0) -1.0 1.0
    $AFC_rad = [math]::Acos($afcArg)
    $AFC = $AFC_rad * 180.0 / [math]::PI
    Add-Step $steps "Получение угла давления на диаметре DC фланка" "AFC = arccos((DD1*cos(AUF))/DC)" ("AFC = {0}°" -f (Fmt $AFC 12))

    $num_HF = $DD1 * (
        [math]::Tan($AU_rad) - $AU_rad
        - [math]::Tan($AC_rad) + $AC_rad
        - [math]::Tan($AUF_rad) + $AUF_rad
        + [math]::Tan($AFC_rad) - $AFC_rad
    )
    $den_HF = 2.0 * ([math]::Tan($AU_rad) - [math]::Tan($AUF_rad))
    $HF = Safe-Div $num_HF $den_HF 0.0
    Add-Step $steps "Получение расстояния от начала фланка до делительной прямой" "HF = сложная функция углов" ("HF = {0} мм" -f (Fmt $HF 12))

    $E = Safe-Div ($HU1 + $HF) ([math]::Cos($AU_rad)) 0.0
    Add-Step $steps "Получение чертежного размера фланка" "E = (HU1 + HF) / cos(AU)" ("E = {0} мм" -f (Fmt $E 12))

    $aeArg = Clamp (Safe-Div ($DD1 * [math]::Cos($AU_rad)) $DL1 0.0) -1.0 1.0
    $AE_rad = [math]::Acos($aeArg)
    $AE = $AE_rad * 180.0 / [math]::PI
    Add-Step $steps "Получение угла давления на головке зуба шестерни" "AE = arccos((DD1*cos(AU))/DL1)" ("AE = {0}°" -f (Fmt $AE 12))

    $sd2Val2 = if ($null -ne $SD2) { $SD2 } else { $SD1 }
    $inv_AE = Get-Inv $AE_rad
    $SE = $DL1 * (($sd2Val2 / $DD1) + $inv_UD - $inv_AE)
    Add-Step $steps "Получение толщины головки зуба шестерни" "SE = DL1*(SD2/DD1 + inv(UD) - inv(AE))" ("SE = {0} мм" -f (Fmt $SE 12))

    $inv_AC = Get-Inv $AC_rad
    $SC = $DC * (($sd2Val2 / $DD1) + $inv_UD - $inv_AC)
    Add-Step $steps "Получение толщины зуба на диаметре DC" "SC = DC*(SD2/DD1 + inv(UD) - inv(AC))" ("SC = {0} мм" -f (Fmt $SC 12))

    $afeArg = Clamp (Safe-Div ($DD1 * [math]::Cos($AUF_rad)) $DL1 0.0) -1.0 1.0
    $AFE_rad = [math]::Acos($afeArg)
    $AFE = $AFE_rad * 180.0 / [math]::PI
    Add-Step $steps "Получение угла давления на головке зуба для фланка" "AFE = arccos((DD1*cos(AUF))/DL1)" ("AFE = {0}°" -f (Fmt $AFE 12))

    $inv_AFC = Get-Inv $AFC_rad
    $inv_AFE = Get-Inv $AFE_rad
    $SFE = $DL1 * (($SC / $DC) + $inv_AFC - $inv_AFE)
    Add-Step $steps "Получение толщины головки зуба шестерни для фланка" "SFE = DL1*(SC/DC + inv(AFC) - inv(AFE))" ("SFE = {0} мм" -f (Fmt $SFE 12))

    $Q = ($SE - $SFE) / 2.0
    Add-Step $steps "Получение среза головки зуба на одну сторону" "Q = (SE - SFE) / 2" ("Q = {0} мм" -f (Fmt $Q 12))

    $DPOS = if ($DLU -ge 90) { 32 } elseif ($DLU -ge 70) { 27 } else { 22 }
    $DZAKR = $DPOS + 18
    $LZAKR = 4
    $LPOL = 20

    Add-Step $steps "Получение посадочного диаметра фрезы" "DPOS = выбран конструктивно" ("DPOS = {0} мм" -f $DPOS)
    Add-Step $steps "Получение диаметра выступающей части фрезы" "DZAKR = DPOS + 18" ("DZAKR = {0} мм" -f $DZAKR)
    Add-Step $steps "Получение ширины выступающей части фрезы" "LZAKR = 4" ("LZAKR = {0} мм" -f $LZAKR)
    Add-Step $steps "Получение ширины слева и справа до полости" "LPOL = 20" ("LPOL = {0} мм" -f $LPOL)

    if ($null -ne $A12_UI) {
        Add-Step $steps "Контроль межосевого расстояния" "A12 (ввод)" ("A12 = {0} мм" -f (Fmt $A12_UI 12))
    }

    return $steps
}

function Get-CalculationSteps {
    return Get-DynamicSteps
}

# ==============================================================================
# ВИЗУАЛИЗАЦИЯ
# ==============================================================================

function New-Point2D {
    param([double]$X, [double]$Y)
    [pscustomobject]@{ X = $X; Y = $Y }
}

function Get-GearEnvelopeRadius {
    param(
        [double]$M,
        [int]$Z,
        [double]$Da,
        [double]$Df
    )

    if ($M -le 0 -or $Z -le 0) { return 50.0 }

    $r = ($M * $Z) / 2.0
    $a = if ($Da -gt 0) { $Da / 2.0 } else { $r }
    $f = if ($Df -gt 0) { $Df / 2.0 } else { $r * 0.75 }

    return ([math]::Max($r, [math]::Max($a, $f)) + $M * 2.5 + 15.0)
}

function Get-GearOutlinePoints {
    param(
        [double]$Cx,
        [double]$Cy,
        [double]$M,
        [int]$Z,
        [double]$XCoeff = 0.0,
        [double]$AlphaDeg = 30.0,
        [object]$DaOverride = $null,
        [object]$DfOverride = $null,
        [double]$HelixDeg = 0.0,
        [int]$HelixSign = 1
    )

    $pts = New-Object 'System.Collections.Generic.List[object]'

    if ($Z -lt 3 -or $M -le 0) { return $pts }

    $R = ($M * $Z) / 2.0
    $alphaRad = $AlphaDeg * [math]::PI / 180.0
    $Rb = $R * [math]::Cos($alphaRad)
    if ($Rb -le 0) { $Rb = 0.1 }

    if ($null -ne $DaOverride -and "$DaOverride" -ne "") {
        $Ra = ([double]$DaOverride) / 2.0
    } else {
        $Ra = $R + $M * (1.0 + $XCoeff)
    }

    if ($null -ne $DfOverride -and "$DfOverride" -ne "") {
        $Rf = ([double]$DfOverride) / 2.0
    } else {
        $Rf = $R - $M * (1.25 - $XCoeff)
    }

    # Небольшая технологическая разгрузка для визуализации,
    # чтобы зубья не накладывались друг на друга при вращении
    $visualClearance = [math]::Max(0.08 * $M, 0.15)
    $Ra = $Ra - $visualClearance
    $Rf = $Rf + $visualClearance

    if ($Rf -lt 0.1) { $Rf = 0.1 }
    if ($Ra -le $Rf) { $Ra = $Rf + $M * 0.8 }
    if ($Ra -le $Rb) { $Ra = $Rb + $M * 0.2 }

    $s_thick = $M * ([math]::PI / 2.0 + 2.0 * $XCoeff * [math]::Tan($alphaRad))
    $angle_per_tooth = (2.0 * [math]::PI) / $Z

    # Уменьшение ширины зуба для спокойной визуализации
    $backlashRad = 0.7 * [math]::PI / 180.0
    $skewFactor = $HelixSign * ([math]::Abs($HelixDeg) * [math]::PI / 180.0) * 0.18

    for ($i = 0; $i -lt $Z; $i++) {
        $tooth_center_angle = $i * $angle_per_tooth
        $flank1 = New-Object 'System.Collections.Generic.List[object]'
        $flank2 = New-Object 'System.Collections.Generic.List[object]'

        for ($step = 0; $step -le 8; $step++) {
            $f = $step / 8.0
            $rVal = $Rf + ($Ra - $Rf) * $f

            if ($rVal -lt $Rb) { $rVal = $Rb }

            $val_under_sqrt = [math]::Pow($rVal / $Rb, 2) - 1.0
            $inv_val = [math]::Sqrt([math]::Max(0.0, $val_under_sqrt))

            $acos_arg = $Rb / $rVal
            if ($acos_arg -gt 1.0) { $acos_arg = 1.0 }
            if ($acos_arg -lt -1.0) { $acos_arg = -1.0 }
            $theta_inv = $inv_val - [math]::Acos($acos_arg)

            $inv_alpha = [math]::Tan($alphaRad) - $alphaRad
            $inv_alpha_r = [math]::Tan([math]::Acos($acos_arg)) - [math]::Acos($acos_arg)
            $theta_r = ($s_thick / (2.0 * $R)) + $inv_alpha - $inv_alpha_r

            # Общее смещение по направлению линии зуба
            $twistShift = $skewFactor * (($rVal - $Rf) / [math]::Max(1e-9, ($Ra - $Rf)))

            $a1 = $tooth_center_angle - $theta_r - $backlashRad + $twistShift
            $flank1.Add((New-Point2D -X ($Cx + $rVal * [math]::Cos($a1)) -Y ($Cy + $rVal * [math]::Sin($a1))))

            $a2 = $tooth_center_angle + $theta_r + $backlashRad + $twistShift
            $flank2.Add((New-Point2D -X ($Cx + $rVal * [math]::Cos($a2)) -Y ($Cy + $rVal * [math]::Sin($a2))))
        }

        foreach ($p in $flank1) { [void]$pts.Add($p) }

        # Дуга вершины
        $p1 = $flank1[$flank1.Count - 1]
        $p2 = $flank2[$flank2.Count - 1]
        $ang1 = [math]::Atan2(($p1.Y - $Cy), ($p1.X - $Cx))
        $ang2 = [math]::Atan2(($p2.Y - $Cy), ($p2.X - $Cx))

        for ($arc = 1; $arc -le 4; $arc++) {
            $t = $arc / 4.0
            $ang = $ang1 + (($ang2 - $ang1) * $t)
            [void]$pts.Add((New-Point2D -X ($Cx + $Ra * [math]::Cos($ang)) -Y ($Cy + $Ra * [math]::Sin($ang))))
        }

        for ($k = $flank2.Count - 1; $k -ge 0; $k--) {
            [void]$pts.Add($flank2[$k])
        }

        # Впадина между зубьями
        if ($i -lt ($Z - 1)) {
            $nextCenter = ($i + 1) * $angle_per_tooth
            $midGap = $tooth_center_angle + ($angle_per_tooth / 2.0)
            for ($arc = 1; $arc -le 4; $arc++) {
                $t = $arc / 4.0
                $ang = $midGap + (($nextCenter - $midGap) * $t) - ($angle_per_tooth * 0.15)
                [void]$pts.Add((New-Point2D -X ($Cx + $Rf * [math]::Cos($ang)) -Y ($Cy + $Rf * [math]::Sin($ang))))
            }
        }
    }

    if ($pts.Count -gt 0) {
        [void]$pts.Add($pts[0])
    }

    return $pts
}

function Show-Visualizer {
    $m = Get-Val "Модуль нормальный (M)" 5.0
    $z1_raw = Get-Val "Число зубьев (Z1)" 27.0
    $z1 = [int]$z1_raw
    $x1 = Get-Val "Коэффициент смещения (X1)" 0.0
    $da1 = Get-Val "Наружный диаметр (DL1)" 145.0
    $h = Get-Val "Полная высота зуба (H)" 8.5
    $df1 = $da1 - 2.0 * $h

    $z2_raw = Get-Val "Число зубьев (Z2)" $null
    $z2 = if ($null -ne $z2_raw) { [int]$z2_raw } else { $null }
    $da2 = Get-Val "Наружный диаметр (DL2)" $null
    $x2 = Get-Val "Коэф. смещения (X2)" 0.0
    $a12 = Get-Val "Межосевое расстояние (A12)" $null
    $ud = Get-Val "Угол профиля (UD)" 30.0
    $naprText = Get-TextVal "Напр. линии зуба (NAPR, при левом пишем - )" "Правое"
    $helixSign = Get-HelixSign $naprText
    $helixAngle = Get-Val "Угол наклона линии зуба (B)" 0.0

    $windowWidth = 1000
    $windowHeight = 800

    $gear1Pts = Get-GearOutlinePoints -Cx 0 -Cy 0 -M $m -Z $z1 -XCoeff $x1 -AlphaDeg $ud -DaOverride $da1 -DfOverride $df1 -HelixDeg $helixAngle -HelixSign $helixSign
    $gear2Pts = $null

    if ($null -ne $z2 -and $null -ne $da2 -and $null -ne $a12) {
        $df2 = $da2 - 2.0 * $h
        $gear2Pts = Get-GearOutlinePoints -Cx $a12 -Cy 0 -M $m -Z $z2 -XCoeff $x2 -AlphaDeg $ud -DaOverride $da2 -DfOverride $df2 -HelixDeg $helixAngle -HelixSign (-$helixSign)
    }

    $r1 = Get-GearEnvelopeRadius -M $m -Z $z1 -Da $da1 -Df $df1
    $r2 = if ($null -ne $gear2Pts) { Get-GearEnvelopeRadius -M $m -Z $z2 -Da $da2 -Df ($da2 - 2.0 * $h) } else { $r1 }

    $minX = -$r1 - 20
    $maxX = if ($null -ne $gear2Pts) { $a12 + $r2 + 20 } else { $r1 + 20 }
    $minY = -([math]::Max($r1, $r2)) - 20
    $maxY = [math]::Max($r1, $r2) + 20

    $width = $maxX - $minX
    $height = $maxY - $minY
    if ($width -le 1) { $width = 1 }
    if ($height -le 1) { $height = 1 }

    $vForm = New-Object System.Windows.Forms.Form
    $vForm.Text = "Визуализация зубчатой геометрии"
    $vForm.Width = $windowWidth
    $vForm.Height = $windowHeight
    $vForm.StartPosition = 'CenterParent'
    $vForm.BackColor = [System.Drawing.Color]::White

    $pic = New-Object System.Windows.Forms.PictureBox
    $pic.SizeMode = 'Zoom'
    $pic.Left = 0
    $pic.Top = 0
    $pic.Width = $vForm.ClientSize.Width
    $pic.Height = $vForm.ClientSize.Height
    $vForm.Controls.Add($pic)

    $penLine = New-Object System.Drawing.Pen([System.Drawing.Color]::Black, 1.5)
    $penLine2 = New-Object System.Drawing.Pen([System.Drawing.Color]::Blue, 1.2)
    $penCenter = New-Object System.Drawing.Pen([System.Drawing.Color]::Red, 2)
    $fontData = New-Object System.Drawing.Font('Segoe UI', 9, [System.Drawing.FontStyle]::Bold)
    $brushBlack = [System.Drawing.Brushes]::Black

    $scaleX = ($windowWidth - 2 * 100) / $width
    $scaleY = ($windowHeight - 2 * 100) / $height
    $scale = [Math]::Min($scaleX, $scaleY)
    if ($scale -le 0) { $scale = 1 }

    $padX = ($windowWidth - ($width * $scale)) / 2
    $padY = ($windowHeight - ($height * $scale)) / 2

    $ConvertPoint = {
        param([double]$X, [double]$Y)
        $sx = $padX + (($X - $minX) * $scale)
        $sy = ($windowHeight - $padY) - (($Y - $minY) * $scale)
        return New-Object System.Drawing.PointF([float]$sx, [float]$sy)
    }

    $DrawCanvas = {
        param([System.Drawing.Graphics]$g, [double]$angle)

        $g.SmoothingMode = [System.Drawing.Drawing2D.SmoothingMode]::AntiAlias
        $g.Clear([System.Drawing.Color]::White)

        $pCenter1 = & $ConvertPoint 0 0

        # Деталь 1
        $saved = $g.Save()
        $g.TranslateTransform($pCenter1.X, $pCenter1.Y)
        $g.RotateTransform([float]$angle)
        $g.TranslateTransform(-$pCenter1.X, -$pCenter1.Y)

        for ($idx = 0; $idx -lt ($gear1Pts.Count - 1); $idx++) {
            $pa = & $ConvertPoint $gear1Pts[$idx].X $gear1Pts[$idx].Y
            $pb = & $ConvertPoint $gear1Pts[$idx + 1].X $gear1Pts[$idx + 1].Y
            $g.DrawLine($penLine, $pa, $pb)
        }
        $g.Restore($saved)

        # Деталь 2
        if ($null -ne $gear2Pts) {
            $pCenter2 = & $ConvertPoint $a12 0

            $saved = $g.Save()
            $g.TranslateTransform($pCenter2.X, $pCenter2.Y)

            $ratio = -1.0
            if ($z2 -gt 0) {
                $ratio = -($z1 / [double]$z2)
            }

            # Мягкий фазовый сдвиг, но без чрезмерного наложения
            $phaseShift = 180.0 / [double]$z2
            $g.RotateTransform([float](($angle * $ratio) + $phaseShift))
            $g.TranslateTransform(-$pCenter2.X, -$pCenter2.Y)

            for ($idx = 0; $idx -lt ($gear2Pts.Count - 1); $idx++) {
                $pa = & $ConvertPoint $gear2Pts[$idx].X $gear2Pts[$idx].Y
                $pb = & $ConvertPoint $gear2Pts[$idx + 1].X $gear2Pts[$idx + 1].Y
                $g.DrawLine($penLine2, $pa, $pb)
            }
            $g.Restore($saved)

            $g.DrawLine($penCenter, $pCenter1, $pCenter2)
            $g.DrawString(("Межосевое расстояние A12: {0} мм" -f (Fmt $a12 4)), $fontData, $brushBlack,
                (($pCenter1.X + $pCenter2.X) / 2 - 120),
                (($pCenter1.Y + $pCenter2.Y) / 2 + 10))
        }

        $g.DrawLine($penCenter, ($pCenter1.X - 8), $pCenter1.Y, ($pCenter1.X + 8), $pCenter1.Y)
        $g.DrawLine($penCenter, $pCenter1.X, ($pCenter1.Y - 8), $pCenter1.X, ($pCenter1.Y + 8))
        $g.DrawString(("Деталь Z={0}, m={1}, линия: {2}" -f $z1, (Fmt $m 2), $naprText), $fontData, $brushBlack, ($pCenter1.X - 95), ($pCenter1.Y - 30))
    }

    $script:visAngle = 0.0
    $vBmp = New-Object System.Drawing.Bitmap($windowWidth, $windowHeight)

    $vTimer = New-Object System.Windows.Forms.Timer
    $vTimer.Interval = 20
    $vTimer.Add_Tick({
        $script:visAngle += 0.8
        $g = [System.Drawing.Graphics]::FromImage($vBmp)
        try {
            & $DrawCanvas $g $script:visAngle
        } finally {
            $g.Dispose()
        }
        $pic.Image = $vBmp
    })

    $btnSave = New-Object System.Windows.Forms.Button
    $btnSave.Text = "Сохранить JPG"
    $btnSave.Width = 110
    $btnSave.Height = 25
    $btnSave.Top = 15
    $btnSave.Left = $vForm.ClientSize.Width - 140
    $btnSave.Anchor = [System.Windows.Forms.AnchorStyles]::Top -bor [System.Windows.Forms.AnchorStyles]::Right
    $vForm.Controls.Add($btnSave)
    $btnSave.BringToFront()

    $btnSave.Add_Click({
        $vTimer.Stop()
        $sfd = New-Object System.Windows.Forms.SaveFileDialog
        $sfd.Filter = "JPEG Image|*.jpg"
        $sfd.FileName = "gear_visualization.jpg"
        if ($sfd.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) {
            $vBmp.Save($sfd.FileName, [System.Drawing.Imaging.ImageFormat]::Jpeg)
        }
        $vTimer.Start()
    })

    $vForm.Add_FormClosing({
        $vTimer.Stop()
        try { if ($vBmp) { $vBmp.Dispose() } } catch {}
    })

    $vTimer.Start()
    $vForm.ShowDialog() | Out-Null
}

