            $txtOutput.Text = "Параметры загружены из файла:`r`n$($ofd.FileName)"
            $script:currentStep = 1
            $script:cachedSteps = @()
        } catch {
            [System.Windows.Forms.MessageBox]::Show("Не удалось прочитать файл.", "Ошибка импорта")
        }
    } else {
        Apply-DefaultValues
        $txtOutput.Text = "Загружены эталонные параметры.`r`nНажмите [Результаты] для вывода расчета."
