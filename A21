function Add-InputRow {
    param(
        [System.Windows.Forms.GroupBox]$Parent,
        [string]$LabelText,
        [int]$Y,
        [int]$InputX,
        [string]$ControlType = "TextBox",
        [string]$DefaultValue = "",
        [string[]]$ComboItems = @()
    )

    $lbl = New-Object System.Windows.Forms.Label
    $lbl.Text = $LabelText
    $lbl.Location = New-Object System.Drawing.Point(10, $Y)
    $lbl.Font = New-Object System.Drawing.Font("Tahoma", 8)
    $lbl.AutoSize = $true
    $Parent.Controls.Add($lbl)

    if ($ControlType -eq "ComboBox") {
        $input = New-Object System.Windows.Forms.ComboBox
        $input.DropDownStyle = [System.Windows.Forms.ComboBoxStyle]::DropDownList
        $input.Font = New-Object System.Drawing.Font("Tahoma", 8)
        if ($ComboItems.Count -gt 0) {
            [void]$input.Items.AddRange($ComboItems)
        }
        if (-not [string]::IsNullOrWhiteSpace($DefaultValue)) {
            $idx = $input.FindStringExact($DefaultValue)
            if ($idx -ge 0) {
                $input.SelectedIndex = $idx
            } else {
                [void]$input.Items.Insert(0, $DefaultValue)
                $input.SelectedIndex = 0
            }
        } elseif ($input.Items.Count -gt 0) {
            $input.SelectedIndex = 0
        }
    } else {
        $input = New-Object System.Windows.Forms.TextBox
        $input.Font = New-Object System.Drawing.Font("Tahoma", 8)
        $input.Text = $DefaultValue
    }

    $input.Location = New-Object System.Drawing.Point($InputX, ($Y - 3))
    $input.Size = New-Object System.Drawing.Size(100, 20)
    $Parent.Controls.Add($input)

    $script:UI_Elements[$LabelText] = $input
}

