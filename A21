function Clamp {
    param(
        [double]$Value,
        [double]$Min,
        [double]$Max
    )
    if ($Value -lt $Min) { return $Min }
    if ($Value -gt $Max) { return $Max }
    return $Value
}

function Safe-Div {
    param(
        [double]$Numerator,
        [double]$Denominator,
        [double]$Fallback = 0.0
    )
    if ([math]::Abs($Denominator) -lt 1e-15) { return $Fallback }
    return $Numerator / $Denominator
}

function Fmt {
    param(
        [double]$Value,
        [int]$Digits = 6
    )

    if ([double]::IsNaN($Value)) { return "NaN" }
    if ([double]::IsPositiveInfinity($Value)) { return "∞" }
    if ([double]::IsNegativeInfinity($Value)) { return "-∞" }

    return $Value.ToString("F$Digits", [System.Globalization.CultureInfo]::InvariantCulture)
}

function Get-TextVal {
    param(
        [string]$Key,
        [string]$Default = ""
    )

    if ($script:UI_Elements.ContainsKey($Key)) {
        $text = [string]$script:UI_Elements[$Key].Text
        if ([string]::IsNullOrWhiteSpace($text)) { return $Default }
        return $text.Trim()
    }
    return $Default
}

function Get-Val {
    param(
        [string]$Key,
        [nullable[double]]$Default = $null
    )

    if ($script:UI_Elements.ContainsKey($Key)) {
        $text = [string]$script:UI_Elements[$Key].Text
        if ([string]::IsNullOrWhiteSpace($text)) { return $Default }

        $text = $text.Trim().Replace(',', '.')
        $val = $null
        if ([double]::TryParse(
                $text,
                [System.Globalization.NumberStyles]::Float,
                [System.Globalization.CultureInfo]::InvariantCulture,
                [ref]$val
            )) {
            return [double]$val
        }
    }

    return $Default
}

function Get-AlphaFromInv {
    param([double]$InvVal)

    if ($InvVal -le 0) { return 0.0 }

    $x = [math]::Pow((3.0 * $InvVal), (1.0 / 3.0))
    if ($x -le 0) { $x = 0.1 }

    for ($i = 0; $i -lt 40; $i++) {
        $tanx = [math]::Tan($x)
        $fx = $tanx - $x - $InvVal
        $dfx = [math]::Pow($tanx, 2)

        if ([math]::Abs($dfx) -lt 1e-18) { break }

        $xNew = $x - ($fx / $dfx)

        if ([math]::Abs($xNew - $x) -lt 1e-14) {
            return $xNew
        }
        $x = $xNew
    }

    return $x
}

function Get-Inv {
    param([double]$AngleRad)
    return ([math]::Tan($AngleRad) - $AngleRad)
}

function Get-HelixSign {
    param([string]$Text)

    if ([string]::IsNullOrWhiteSpace($Text)) { return 1 }

    $t = $Text.ToLowerInvariant()
    if ($t -match "-" -or $t -match "лев") { return -1 }
    return 1
}

function Add-Step {
    param(
        [System.Collections.ArrayList]$Steps,
        [string]$Title,
        [string]$Formula,
        [string]$Result
    )

    $n = $Steps.Count + 1
    [void]$Steps.Add(@("$n. $Title", $Formula, $Result))
}

function Build-ReportText {
    param([System.Collections.ArrayList]$Steps)

    $report = New-Object System.Text.StringBuilder
    [void]$report.AppendLine("=== ПОДРОБНЫЙ МАТЕМАТИЧЕСКИЙ ОТЧЕТ ===")
    [void]$report.AppendLine("")

    foreach ($s in $Steps) {
        [void]$report.AppendLine($s[0])
        [void]$report.AppendLine("Формула: $($s[1])")
        [void]$report.AppendLine("Результат: $($s[2])")
        [void]$report.AppendLine("------------------------------------------------------------")
    }

    return $report.ToString()
}

