# ==============================================================================
# Скрипт пробития шлюза UIPI для FANUC в Windows 10 (PowerShell 5.1)
# ==============================================================================

# 1. Объявляем системные API Windows через C#
$Win32Api = Add-Type -MemberDefinition @'
[DllImport("user32.dll", SetLastError = true)]
public static extern bool ChangeWindowMessageFilterEx(IntPtr hWnd, uint message, uint action, IntPtr pChangeFilterStruct);

[DllImport("user32.dll")]
public static extern bool EnumThreadWindows(int dwThreadId, EnumThreadDelegate lpfn, IntPtr lParam);
public delegate bool EnumThreadDelegate(IntPtr hWnd, IntPtr lParam);
'@ -Name "UipiController" -Namespace "FanucFix" -PassThru

# Константы сообщений
$MSGFLT_ALLOW = 1
$WM_COPYDATA  = 0x004A # Передача структур данных между окнами FANUC

# 2. Запускаем главный процесс
Write-Host "[*] Запуск Mgimanager.exe..." -ForegroundColor Cyan
Set-Location -Path "C:\fanuc"
$process = Start-Process -FilePath "C:\fanuc\Mgimanager.exe" -PassThru

# 3. Ждем 3 секунды, пока подгрузится дочернее окно CNCScrn.exe
Write-Host "[*] Ожидание инициализации окон..." -ForegroundColor Gray
Start-Sleep -Seconds 3

# 4. Ищем все запущенные процессы FANUC
$fanucProcesses = Get-Process -Name "Mgimanager", "CNCScrn" -ErrorAction SilentlyContinue

if (-not $fanucProcesses) {
    Write-Host "[-] Ошибки: процессы FANUC не найдены в памяти!" -ForegroundColor Red
    Exit
}

# 5. Функция снятия UIPI-блокировки с конкретного дескриптора (HWND)
function Unblock-WindowUIPI([IntPtr]$hWnd, [string]$procName) {
    if ($hWnd -eq [IntPtr]::Zero) { return }

    # Разрешаем главное сообщение обмена данными WM_COPYDATA
    $resCopyData = [FanucFix.UipiController]::ChangeWindowMessageFilterEx($hWnd, $WM_COPYDATA, $MSGFLT_ALLOW, [IntPtr]::Zero)
    
    # Разрешаем диапазон пользовательских сообщений WM_USER (от 0x0400 до 0x0430), используемый ЧПУ
    $userSuccess = 0
    for ($msg = 0x0400; $msg -le 0x0430; $msg++) {
        if ([FanucFix.UipiController]::ChangeWindowMessageFilterEx($hWnd, $msg, $MSGFLT_ALLOW, [IntPtr]::Zero)) {
            $userSuccess++
        }
    }

    if ($resCopyData) {
        Write-Host "[+] УСПЕХ: Шлюз UIPI открыт для $procName (HWND: $hWnd)" -ForegroundColor Green
    } else {
        $err = [System.Runtime.InteropServices.Marshal]::GetLastWin32Error()
        Write-Host "[-] Ошибка снятия UIPI для $procName (HWND: $hWnd, Код ошибки: $err)" -ForegroundColor Yellow
    }
}

# 6. Обходим все потоки и окна обоих процессов и пробиваем фильтр
foreach ($proc in $fanucProcesses) {
    foreach ($thread in $proc.Threads) {
        [FanucFix.UipiController]::EnumThreadWindows($thread.Id, {
            param($h, $l)
            Unblock-WindowUIPI $h $proc.ProcessName
            return $true
        }, [IntPtr]::Zero)
    }
}

Write-Host "`n[*] Готово! Окна связаны в обход UIPI." -ForegroundColor Cyan
