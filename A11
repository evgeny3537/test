# ==============================================================================
# ЛОГИКА РАСЧЕТА (Привязка к кнопке "Результаты")
# ==============================================================================
$btnResults.Add_Click({
    try {
        $m_str = $script:UI_Elements["Модуль нормальный (M)"].Text.Replace(',', '.')
        $z_str = $script:UI_Elements["Число зубьев (Z1)"].Text.Replace(',', '.')
        $x_str = $script:UI_Elements["Коэффициент смещения (X1)"].Text.Replace(',', '.')
        $alpha_str = $script:UI_Elements["Угол профиля (UD)"].Text.Replace(',', '.')
        $dp_str = $script:UI_Elements["Диаметр ролика (DRD)"].Text.Replace(',', '.')

        if ([string]::IsNullOrWhiteSpace($m_str) -or [string]::IsNullOrWhiteSpace($z_str)) {
            [System.Windows.Forms.MessageBox]::Show("Заполните Модуль и Число зубьев (Z1)!", "Внимание")
            return
        }

        $m = [double]$m_str
        $z = [double]$z_str
        $x = if ([string]::IsNullOrWhiteSpace($x_str)) { 0.0 } else { [double]$x_str }
        $alpha_deg = if ([string]::IsNullOrWhiteSpace($alpha_str)) { 30.0 } else { [double]$alpha_str }
        $Dp = if ([string]::IsNullOrWhiteSpace($dp_str)) { 0.0 } else { [double]$dp_str }

        $alpha_rad = Deg2Rad $alpha_deg

        $d = $m * $z                                      
        $db = $d * [math]::Cos($alpha_rad)                
        $p = [math]::PI * $m                              
        $s = ($p / 2) + (2 * $x * $m * [math]::Tan($alpha_rad))

        $resText = "=== РЕЗУЛЬТАТЫ РАСЧЕТА ===`r`n"
        $resText += "Делительный диаметр (d): " + [math]::Round($d, 3) + " мм`r`n"
        $resText += "Основной диаметр (db):   " + [math]::Round($db, 3) + " мм`r`n"
        $resText += "Шаг (p):                 " + [math]::Round($p, 3) + " мм`r`n"
        $resText += "Толщина зуба (s):        " + [math]::Round($s, 3) + " мм`r`n"

        if ($Dp -gt 0) {
            $inv_alpha = Get-Involute $alpha_rad
            $inv_alpha_p = ($s / $d) + $inv_alpha + ($Dp / $db) - ([math]::PI / $z)
            $alpha_p_rad = Get-AngleFromInvolute $inv_alpha_p
            
            if ($z % 2 -eq 0) {
                $MR = ($db / [math]::Cos($alpha_p_rad)) + $Dp
            } else {
                $MR = ($db / [math]::Cos($alpha_p_rad)) * [math]::Cos([math]::PI / (2 * $z)) + $Dp
            }
            $resText += "--------------------------`r`n"
            $resText += "Размер по роликам (MR):  " + [math]::Round($MR, 3) + " мм`r`n"
            
            $script:UI_Elements["Размер по роликам (оконч.) (MR1)"].Text = [math]::Round($MR, 3).ToString()
        }

        $txtOutput.Text = $resText

    } catch {
        $txtOutput.Text = "ОШИБКА РАСЧЕТА:`r`nПроверьте правильность ввода числовых данных."
    }
})

