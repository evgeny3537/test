        if ($fTerm.Length -eq 0) {
            $grid.DataSource = $dt
            $lblCount.Text   = "Показано: $($dt.Rows.Count)"
            return
        }
        $filtered = $dt.Clone()
        $cmp      = [StringComparison]::OrdinalIgnoreCase
        foreach ($row in $dt.Rows) {
            $found = $false
            foreach ($col in $dt.Columns) {
                if (([string]$row[$col.ColumnName]).IndexOf($fTerm, $cmp) -ge 0) { $found = $true; break }
            }
            if ($found) { $filtered.ImportRow($row) }
        }
        $grid.DataSource = $filtered
        $lblCount.Text   = "Найдено: $($filtered.Rows.Count) из $($dt.Rows.Count)"
        foreach ($row in $grid.Rows) {
            foreach ($cell in $row.Cells) {
                if ($cell.Value -and ([string]$cell.Value).IndexOf($fTerm, $cmp) -ge 0) {
                    $cell.Style.BackColor = [System.Drawing.Color]::FromArgb(255,220,80)
                }
            }
        }
    }

    $btnFind.Add_Click($doFilter)
    $txtFind.Add_KeyDown({
        param($s,$e)
        if ($e.KeyCode -eq [System.Windows.Forms.Keys]::Return) { & $doFilter }
    })
    $btnReset.Add_Click({
        $txtFind.Text = ''
        $dt = $script:vDt
        if ($dt) { $grid.DataSource = $dt; $lblCount.Text = "Показано: $($dt.Rows.Count)" }
    })

    $grid.Add_CellDoubleClick({
        param($s,$e)
        if ($e.RowIndex -lt 0) { return }
        $parts = [System.Collections.Generic.List[string]]::new()
        foreach ($cell in $grid.Rows[$e.RowIndex].Cells) {
            $parts.Add("$($cell.OwningColumn.HeaderText): $($cell.Value)")
        }
        [System.Windows.Forms.Clipboard]::SetText($parts -join "`r`n")
        $statusLbl.Text = 'Строка скопирована в буфер обмена'
    })

    $btnExport.Add_Click({
        $dt = $script:vDt
        if (-not $dt) { return }
        $dlg          = New-Object System.Windows.Forms.SaveFileDialog
        $dlg.Filter   = 'CSV файлы (*.csv)|*.csv'
        $dlg.FileName = [System.IO.Path]::GetFileNameWithoutExtension($script:vFilePath) + '.csv'
        if ($dlg.ShowDialog() -ne 'OK') { return }
        $sb = New-Object System.Text.StringBuilder
        [void]$sb.AppendLine(($dt.Columns | ForEach-Object { '"' + $_.ColumnName + '"' }) -join ';')
        foreach ($row in $dt.Rows) {
            [void]$sb.AppendLine(($dt.Columns | ForEach-Object { '"' + ([string]$row[$_.ColumnName]).Replace('"','""') + '"' }) -join ';')
        }
        [System.IO.File]::WriteAllText($dlg.FileName, $sb.ToString(), [System.Text.Encoding]::UTF8)
        $statusLbl.Text = "Экспорт: $($dlg.FileName)"
    })

    [void]$vForm.ShowDialog()
    $vForm.Dispose()
}

