        [void]$dt.Columns.Add('#',   [string])
        [void]$dt.Columns.Add('Del', [string])
        foreach ($f in $m.Fields) { [void]$dt.Columns.Add($f.Name, [string]) }

        foreach ($rec in $dbfData.Records) {
            $row = $dt.NewRow()
            foreach ($p in $rec.PSObject.Properties) {
                if ($dt.Columns.Contains($p.Name)) {
                    $row[$p.Name] = if ($null -eq $p.Value) { '' } else { [string]$p.Value }
