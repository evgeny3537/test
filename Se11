$btnClear.Add_Click({
    $listView.Items.Clear()
    $progress.Value     = 0
    $statusLbl2.Text    = "Каталог: $scriptDir"
    $btnOpenDbf.Enabled = $false
})

$listView.Add_SelectedIndexChanged({
    $sel = $listView.SelectedItems
    if ($sel.Count -gt 0) {
        $btnOpenDbf.Enabled = ([System.IO.Path]::GetExtension($sel[0].Text).ToLowerInvariant() -eq '.dbf')
    } else { $btnOpenDbf.Enabled = $false }
})

function Open-SelectedDbf {
    $sel = $listView.SelectedItems
    if ($sel.Count -eq 0) { return }
    $item = $sel[0]
    if ([System.IO.Path]::GetExtension($item.Text).ToLowerInvariant() -ne '.dbf') { return }
    $recNo = 0
    try { $recNo = [int]$item.SubItems[2].Text } catch {}
    Show-DbfViewer `
        -FilePath       $item.Text `
        -HighlightRecNo $recNo `
        -SearchTerm     $txtTerm.Text.Trim() `
        -Encodings      (Get-TestEncodings)
}

$listView.Add_DoubleClick({ Open-SelectedDbf })
$btnOpenDbf.Add_Click({    Open-SelectedDbf })

$btnSearch.Add_Click({
    $term = $txtTerm.Text.Trim()
    if ([string]::IsNullOrWhiteSpace($term)) {
        [System.Windows.Forms.MessageBox]::Show('Введите текст для поиска.','Проверка',
            [System.Windows.Forms.MessageBoxButtons]::OK,
            [System.Windows.Forms.MessageBoxIcon]::Warning) | Out-Null
        return
    }

    $listView.Items.Clear()
    $progress.Value     = 0
    $btnSearch.Enabled  = $false
    $btnClear.Enabled   = $false
    $btnOpenDbf.Enabled = $false
    $form.UseWaitCursor = $true

    $encodings = Get-TestEncodings
    $exts      = '.dbf','.cdx','.fpt','.fpw','.mem','.fp','.tmp'

    $files = @(
        Get-ChildItem -LiteralPath $scriptDir -Recurse -File -ErrorAction SilentlyContinue |
        Where-Object { $exts -contains $_.Extension.ToLowerInvariant() }
    )

    $total = $files.Count
    if ($total -eq 0) {
        $statusLbl2.Text    = 'Файлы не найдены.'
        $btnSearch.Enabled  = $true
        $btnClear.Enabled   = $true
        $form.UseWaitCursor = $false
        return
    }

    $found  = 0
    $i      = 0
    $colorA = [System.Drawing.Color]::White
    $colorB = [System.Drawing.Color]::FromArgb(240,248,255)

    foreach ($file in $files) {
        $i++
        $ext  = $file.Extension.ToLowerInvariant()
        $hits = @()

        if ($ext -eq '.dbf') {
            $hits = @(Search-DbfFile -Path $file.FullName -Term $term -Encodings $encodings)
            if ($hits.Count -eq 0) {
                $raw = @(Search-RawFile -Path $file.FullName -Term $term -Encodings $encodings)
                if ($raw.Count -gt 0) { $hits = $raw }
            }
        } else {
            $raw = @(Search-RawFile -Path $file.FullName -Term $term -Encodings $encodings)
            if ($raw.Count -gt 0) { $hits = $raw }
        }

        foreach ($hit in $hits) {
            $found++
            $lvi = New-Object System.Windows.Forms.ListViewItem($hit.Path)
            [void]$lvi.SubItems.Add($hit.Source)
            [void]$lvi.SubItems.Add($(if ($hit.RecNo -gt 0) { [string]$hit.RecNo } else { '-' }))
            [void]$lvi.SubItems.Add($hit.Preview)
            $lvi.BackColor = if ($found % 2 -eq 0) { $colorB } else { $colorA }
            [void]$listView.Items.Add($lvi)
        }

        $progress.Value  = [Math]::Min(100, [int](($i / $total) * 100))
        $statusLbl2.Text = "Проверено: $i / $total  |  Найдено: $found"
        [System.Windows.Forms.Application]::DoEvents()
    }

    $statusLbl2.Text    = "Готово. Найдено: $found (файлов: $total) | Двойной клик — просмотр"
    $btnSearch.Enabled  = $true
    $btnClear.Enabled   = $true
    $form.UseWaitCursor = $false
    $progress.Value     = 100
})

