# Обработка пошаговых сценариев
function Show-Step-Report {
    $data = Calculate-FullHobData
    $report = ""
    switch ($script:currentStep) {
        1 {
            $report += "Шаг 1: Расчет шага и профиля зуба`r`n"
            $report += " Шаг нормальный TU = pi * M = $([math]::Round($data.TU, 6)) мм`r`n"
            $report += " Нарезаемая толщина SU (без прип.) = TU - SD1 = $([math]::Round($data.SU_no, 6)) мм"
        }
        2 {
            $report += "Шаг 2: Расчет параметров витка фрезы`r`n"
            $report += " Средний диаметр DT = DLU - 2*HU1 = $($data.DT) мм`r`n"
            $report += " Угол витков W = $([math]::Round($data.W, 5))°"
        }
        3 {
            $report += "Шаг 3: Конструктивные параметры затылования`r`n"
            $report += " Высота зуба HU = H + 0.3*M = $($data.HU) мм`r`n"
            $report += " Высота головки фрезы HU1 = $($data.HU1) мм`r`n"
            $report += " Глубина канавки HK = $($data.HK) мм"
        }
        4 {
            $report += "Шаг 4: Посадочные и крепежные элементы`r`n"
            $report += " Диаметр посадочный DPOS = $($data.DPOS) мм`r`n"
            $report += " Диаметр бурта DZAKR = $($data.DZAKR) мм"
        }
    }
    $txtOutput.Text = $report
}

$btnNext.Add_Click({
    if ($script:currentStep -lt 4) {
        $script:currentStep++
        Show-Step-Report
    }
})

$btnBack.Add_Click({
    if ($script:currentStep -gt 1) {
        $script:currentStep--
        Show-Step-Report
    }
})

