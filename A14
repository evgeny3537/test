function Get-UIValue ($key, $default) {
    if ($script:UI_Elements.ContainsKey($key)) {
        $val = $script:UI_Elements[$key].Text.Replace(',', '.')
        if ([string]::IsNullOrWhiteSpace($val)) { return $default }
        return [double]$val
    }
    return $default
}

function Calculate-FullHobData {
    # Считывание параметров фрезы и детали
    $M = Get-UIValue "Модуль нормальный (M)" 5.0
    $ZU = Get-UIValue "Число зубьев фрезы (ZU)" 10.0
    $DLU = Get-UIValue "Наружный диаметр фрезы (DLU)" 90.0
    $U = Get-UIValue "Число заходов (U)" 1.0
    $DL = Get-UIValue "Длина фрезы (DL)" 85.0
    $CL = if ($script:UI_Elements.ContainsKey("Класс точности (CL)")) { $script:UI_Elements["Класс точности (CL)"].Text } else { "B" }
    $AU = Get-UIValue "Угол профиля (UD)" 30.0
    
    $Z1 = Get-UIValue "Число зубьев (Z1)" 27.0
    $DL1 = Get-UIValue "Наружный диаметр (DL1)" 145.0
    $H1 = Get-UIValue "Высота головки зуба (H1)" 5.0
    $H = Get-UIValue "Полная высота зуба (H)" 8.5
    $SD1 = Get-UIValue "Толщина зуба по I оконч. (SD1)" 7.578
    
    # Расчет параметров фрезы по формулам ГОСТ 6033-80
    $TU = [math]::PI * $M
    $SU_no_allowance = $TU - $SD1
    $SU = $SU_no_allowance - (0.532559265 * $M) # Припуск под чистовую обработку
    
    $HU1 = $H - $H1
    $HU = $H + 0.3 * $M
    
    $DT = $DLU - 2 * $HU1
    $W_rad = [math]::Asin(($M * $U) / $DT)
    $W = $W_rad * 180 / [math]::PI
    
    $HK = $HU + 0.14 * $M
    $R1 = 0.24 * $M
    $R2 = 0.3 * $M
    
    $T0 = $TU / [math]::Cos($W_rad)
    $T = ([math]::PI * $DT) / [math]::Tan($W_rad)
    
    # Прямой перевод тригонометрии без вызова Get-Rad/Get-Deg для стабильности парсера
    $AU_rad = $AU * [math]::PI / 180
    $AW_rad = [math]::Atan([math]::Tan($AU_rad) / [math]::Cos($W_rad))
    $AW = $AW_rad * 180 / [math]::PI
    
    $DPOS = if ($DLU -ge 90) { 32 } elseif ($DLU -ge 70) { 27 } else { 22 }
    $DZAKR = $DPOS + 18
    
    return @{
        "M" = $M; "ZU" = $ZU; "DLU" = $DLU; "U" = $U; "DL" = $DL; "CL" = $CL; "AU" = $AU;
        "TU" = $TU; "SU" = $SU; "HU1" = $HU1; "HU" = $HU; "W" = $W; "DT" = $DT;
        "HK" = $HK; "R1" = $R1; "R2" = $R2; "T0" = $T0; "T" = $T; "AW" = $AW;
        "DPOS" = $DPOS; "DZAKR" = $DZAKR; "SU_no" = $SU_no_allowance
    }
}

# Форматирование и вывод полной технологической карты
function Show-FullReport {
    $data = Calculate-FullHobData
    
    $report = "[Нормальный модуль фрезы]`r`nM=$($data.M)`r`n"
    $report += "[Число зубьев фрезы]`r`nZU=$($data.ZU)`r`n"
    $report += "[Наружный диаметр фрезы]`r`nDLU=$($data.DLU)`r`n"
    $report += "[Число заходов]`r`nU=$($data.U)`r`n"
    $report += "[Длина фрезы]`r`nDL=$($data.DL)`r`n"
    $report += "[Класс точности]`r`nCL=$($data.CL)`r`n"
    $report += "[Профильный угол по нормали]`r`nAU=$($data.AU)`r`n"
    $report += "[Шаг нормальный между соседними профилями]`r`nTU=$([math]::Round($data.TU, 12))`r`n"
    $report += "[Толщина зуба по нормали с учетом припуска]`r`nSU=$([math]::Round($data.SU, 12))`r`n"
    $report += "[Расчетная высота головки фрезы]`r`nHU1=$($data.HU1)`r`n"
    $report += "[Полная высота зуба]`r`nHU=$($data.HU)`r`n"
    $report += "[Падение затылка]`r`nK=0`r`n"
    $report += "[Угол подъема витков на начальной окружности]`r`nW=$([math]::Round($data.W, 12))`r`n"
    $report += "[Направление витков фрезы]`r`nNAPR=Правое`r`n"
    $report += "[Направление канавок фрезы]`r`nNKAN=Левое`r`n"
    $report += "[Средний расчетный диаметр]`r`nDT=$($data.DT)`r`n"
    $report += "[Двойное затылование]`r`nK1=0`r`n"
    $report += "[Глубина канавки]`r`nHK=$($data.HK)`r`n"
    $report += "[Радиус закругления головки зуба]`r`nR1=$($data.R1)`r`n"
    $report += "[Радиус закругления у ножки зуба]`r`nR2=$($data.R2)`r`n"
    $report += "[Шаг по оси]`r`nT0=$([math]::Round($data.T0, 12))`r`n"
    $report += "[Шаг стружечной канавки]`r`nT=$([math]::Round($data.T, 9))`r`n"
    $report += "[Угол зацепления]`r`nAW=$([math]::Round($data.AW, 12))`r`n"
    $report += "[Посадочный диаметр фрезы]`r`nDPOS=$($data.DPOS)`r`n"
    $report += "[Диаметр выступающей части для закрепления фрезы]`r`nDZAKR=$($data.DZAKR)`r`n"
    $report += "[Ширина выступающей части фрезы]`r`nLZAKR=4`r`n"
    $report += "[Ширина слева и справа до полости]`r`nLPOL=20`r`n"
    $report += "[Толщина зуба по нормали без учета припуска]`r`nSU=$([math]::Round($data.SU_no, 12))`r`n"
    
    $txtOutput.Text = $report
}

$btnResults.Add_Click({
