# --- Функция для автоматической генерации полей ввода ---
function Add-InputFields {
    param (
        [System.Windows.Forms.GroupBox]$ParentGroup,
        [string[]]$Labels,
        [int]$StartX,
        [int]$StartY,
        [int]$LabelWidth,
        [int]$InputWidth
    )
    $currentY = $StartY
    foreach ($labelText in $Labels) {
        # Создание надписи
        $lbl = New-Object System.Windows.Forms.Label
        $lbl.Text = $labelText
        $lbl.Location = New-Object System.Drawing.Point($StartX, $currentY)
        $lbl.Size = New-Object System.Drawing.Size($LabelWidth, 20)
        $ParentGroup.Controls.Add($lbl)

        # Проверка, нужен ли ComboBox (выпадающий список) вместо TextBox
        if ($labelText -eq "Число зубьев фрезы (ZU)" -or $labelText -eq "Наружный диаметр фрезы (DLU)") {
            $input = New-Object System.Windows.Forms.ComboBox
            $input.DropDownStyle = "DropDownList"
        } else {
            $input = New-Object System.Windows.Forms.TextBox
        }
        
        $input.Location = New-Object System.Drawing.Point(($StartX + $LabelWidth), $currentY - 3)
        $input.Size = New-Object System.Drawing.Size($InputWidth, 20)
        $ParentGroup.Controls.Add($input)

        $currentY += 25
    }
}

