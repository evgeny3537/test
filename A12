# Функция безопасного парсинга полей ввода
function Get-UIValue ($key, $default) {
    if ($script:UI_Elements.ContainsKey($key)) {
        $val = $script:UI_Elements[$key].Text.Replace(',', '.')
        if ([string]::IsNullOrWhiteSpace($val)) { return $default }
        return [double]$val
    }
    return $default
}

# Общая функция математического анализа
function Calculate-SplineData {
    # Считываем входные параметры
    $m = Get-UIValue "Модуль нормальный (M)" 5.0
    $z = Get-UIValue "Число зубьев (Z1)" 27.0
    $sd = Get-UIValue "Толщина зуба по I оконч. (SD1)" 7.578
    $alpha_deg = Get-UIValue "Угол профиля (UD)" 30.0
    $dr = Get-UIValue "Диаметр ролика (DRD)" 8.4
    $DLU = Get-UIValue "Наружный диаметр фрезы (DLU)" 90.0
    $u = Get-UIValue "Число заходов (U)" 1.0

    $alpha_rad = Get-Rad $alpha_deg

    # Геометрия вала по ГОСТ 6033-80
    $d = $m * $z
    $db = $d * [math]::Cos($alpha_rad)
    $p = [math]::PI * $m
    $s_nom = $p / 2 # Номинальная делительная толщина зуба

    # Определение точного смещения по заданной толщине SD1
    $x1 = ($sd - $s_nom) / (2.0 * $m * [math]::Tan($alpha_rad))

    # Вычисление размера по роликам
    $inv_alpha = Get-Inv $alpha_rad
    $inv_alpha_x = ($sd / $d) + $inv_alpha + ($dr / $db) - ([math]::PI / $z)
    $alpha_x = Get-AlphaFromInv $inv_alpha_x

    if ($z % 2 -eq 0) {
        $MR = ($db / [math]::Cos($alpha_x)) + $dr
    } else {
        $MR = ($db / [math]::Cos($alpha_x)) * [math]::Cos([math]::PI / (2.0 * $z)) + $dr
    }

    # Геометрия инструмента (фрезы)
    $d0 = $DLU - 2.5 * $m # Делительный диаметр фрезы
    $gamma_rad = [math]::Asin(($m * $u) / $d0) # Угол подъема витка
    $px = ([math]::PI * $m) / [math]::Cos($gamma_rad) # Осевой шаг витка фрезы

    return @{
        "m" = $m; "z" = $z; "sd" = $sd; "alpha_deg" = $alpha_deg; "dr" = $dr; "x1" = $x1;
        "d" = $d; "db" = $db; "p" = $p; "MR" = $MR; "d0" = $d0; "gamma" = (Get-Deg $gamma_rad);
        "px" = $px; "inv_ax" = $inv_alpha_x; "ax" = (Get-Deg $alpha_x)
    }
}

