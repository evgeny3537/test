# Сценарий пошагового вывода
function Update-Step {
    $data = Calculate-SplineData
    $report = ""

    switch ($script:currentStep) {
        1 {
            $report += "Шаг 1: Геометрия делительной окружности вала`r`n`r`n"
            $report += "Формулы:`r`n"
            $report += " d = m * z = $($data.m) * $($data.z) = $($data.d) мм`r`n"
            $report += " db = d * cos(a) = $($data.d) * cos($($data.alpha_deg)°) = $([math]::Round($data.db, 4)) мм`r`n"
            $report += " p = pi * m = 3.14159 * $($data.m) = $([math]::Round($data.p, 4)) мм"
        }
        2 {
            $report += "Шаг 2: Расчет фактического профильного смещения`r`n`r`n"
            $report += "Формула:`r`n"
            $report += " x1 = (SD1 - (pi * m)/2) / (2 * m * tg(a))`r`n"
            $report += " x1 = ($($data.sd) - $([math]::Round(($data.p/2), 3))) / (2 * $($data.m) * tg($($data.alpha_deg)°))`r`n"
            $report += " Результат:`r`n"
            $report += " x1 = $([math]::Round($data.x1, 5))"
        }
        3 {
            $report += "Шаг 3: Размер по роликам (Тригонометрическое уравнение)`r`n`r`n"
            $report += "inv(ax) = SD1/d + inv(a) + Dr/db - pi/z`r`n"
            $report += "inv(ax) = $($data.sd)/$($data.d) + 0.053751 + $($data.dr)/$([math]::Round($data.db, 3)) - 3.14159/$($data.z)`r`n"
            $report += "Получено: inv(ax) = $([math]::Round($data.inv_ax, 6))`r`n"
            $report += "Угол на роликах ax = $([math]::Round($data.ax, 3))°`r`n"
            $report += "Итоговый расчет MR (нечетный зуб):`r`n"
            $report += " MR = $([math]::Round($data.MR, 3)) мм"
        }
        4 {
            $report += "Шаг 4: Геометрические параметры фрезы`r`n`r`n"
            $report += "Делительный диаметр фрезы d0:`r`n"
            $report += " d0 = DLU - 2.5 * m = 90 - 12.5 = $($data.d0) мм`r`n"
            $report += "Угол подъема витка фрезы:`r`n"
            $report += " gamma = arcsin((m * U)/d0) = arcsin((5*1)/77.5) = $([math]::Round($data.gamma, 4))°"
        }
        5 {
            $report += "Шаг 5: Профиль витков фрезы`r`n`r`n"
            $report += "Осевой шаг витка фрезы px:`r`n"
            $report += " px = (pi * m) / cos(gamma) = 15.7079 / cos($([math]::Round($data.gamma, 3))°)`r`n"
            $report += " px = $([math]::Round($data.px, 4)) мм`r`n"
            $report += "Высота зуба фрезы h0 = 2.75 * m = 13.75 мм"
        }
    }
    $txtOutput.Text = $report
}

