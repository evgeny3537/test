# Конвертация градусов в радианы и обратно
function Get-Rad ([double]$deg) { return $deg * [math]::PI / 180 }
function Get-Deg ([double]$rad) { return $rad * 180 / [math]::PI }

# Функция инвалюты угла (эвольвентная функция)
function Get-Inv ([double]$alpha_rad) {
    return [math]::Tan($alpha_rad) - $alpha_rad
}

# Численный поиск угла по значению его инвалюты (Метод Ньютона-Рафсона)
function Get-AlphaFromInv ([double]$inv_val) {
    if ($inv_val -le 0) { return 0.0 }
    $x = [math]::Pow((3.0 * $inv_val), (1.0/3.0)) # Первое приближение
    for ($i = 0; $i -lt 15; $i++) {
        $fx = [math]::Tan($x) - $x - $inv_val
        $dfx = [math]::Pow([math]::Tan($x), 2) # Производная tg(x) - x
        if ($dfx -eq 0) { break }
        $x_new = $x - ($fx / $dfx)
        if ([math]::Abs($x_new - $x) -lt 0.0000001) { return $x_new }
        $x = $x_new
    }
    return $x
}

