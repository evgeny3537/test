    }
})

# Экспорт параметров геометрии в TXT
$btnSaveFile.Add_Click({
    $sfd = New-Object System.Windows.Forms.SaveFileDialog
    $sfd.Filter = "Текстовые файлы (*.txt)|*.txt"
    $sfd.FileName = "hob_input_parameters.txt"
    if ($sfd.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) {
        $fileText = ""
        foreach ($key in $script:UI_Elements.Keys) {
            $fileText += "$key=$($script:UI_Elements[$key].Text)`r`n"
        }
        [System.IO.File]::WriteAllText($sfd.FileName, $fileText)
        [System.Windows.Forms.MessageBox]::Show("Параметры успешно сохранены в файл.", "Успех")
    }
})

# Экспорт подробного пошагового математического отчета
$btnSaveReport.Add_Click({
    try {
        $steps = Get-CalculationSteps
        $sfd = New-Object System.Windows.Forms.SaveFileDialog
        $sfd.Filter = "Отчеты по расчетам (*.txt)|*.txt"
        $sfd.FileName = "mathematical_calculation_report.txt"
        if ($sfd.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) {
            $report = "=== ТЕХНОЛОГИЧЕСКИЙ ОТЧЕТ ПОЛНОГО МАТЕМАТИЧЕСКОГО РАСЧЕТА ===`r`n`r`n"
            foreach ($s in $steps) {
                $report += "$($s[0])`r`n Формула: $($s[1])`r`n Результат: $($s[2])`r`n------------------------------------------------------------`r`n"
            }
            [System.IO.File]::WriteAllText($sfd.FileName, $report)
            [System.Windows.Forms.MessageBox]::Show("Математический отчет успешно сохранен.", "Успех")
        }
    } catch {
        [System.Windows.Forms.MessageBox]::Show("Сначала введите корректные параметры для генерации отчета.", "Ошибка отчета")
    }
})

# Запуск расчета всей динамической карты
$btnResults.Add_Click({
    try {
        $steps = Get-DynamicSteps
        $report = "=== РЕЗУЛЬТАТ ДИНАМИЧЕСКИХ РАСЧЕТОВ КАРТЫ (Шагов: $($steps.Count)) ===`r`n`r`n"
        foreach ($s in $steps) {
            $report += "$($s[0]): $($s[2])`r`n"
        }
        $txtOutput.Text = $report
        $script:calculatedStepsCached = $steps
    } catch {
        $txtOutput.Text = "КРИТИЧЕСКАЯ ОШИБКА ДИНАМИЧЕСКИХ ВЫЧИСЛЕНИЙ.`r`nПроверьте, все ли необходимые поля заполнены числами."
    }
})

# Пошаговая навигация
$btnNext.Add_Click({
    try {
        $steps = Get-DynamicSteps
        if ($script:currentStep -lt $steps.Count) {
            $script:currentStep++
            $step_data = $steps[$script:currentStep - 1]
            $txtOutput.Text = "$($step_data[0])`r`n`r`nФормула:`r`n$($step_data[1])`r`n`r`nЗначение:`r`n$($step_data[2])"
        }
    } catch {}
})

$btnBack.Add_Click({
    try {
        $steps = Get-DynamicSteps
        if ($script:currentStep -gt 1) {
            $script:currentStep--
            $step_data = $steps[$script:currentStep - 1]
            $txtOutput.Text = "$($step_data[0])`r`n`r`nФормула:`r`n$($step_data[1])`r`n`r`nЗначение:`r`n$($step_data[2])"
        }
    } catch {}
})

