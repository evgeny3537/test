# Загрузка данных (Импорт из файлов через проводник)
$btnLoad.Add_Click({
    $ofd = New-Object System.Windows.Forms.OpenFileDialog
    $ofd.Filter = "Текстовые файлы (*.txt)|*.txt|Все файлы (*.*)|*.*"
    $ofd.Title = "Выберите файл с сохраненными геометрическими данными"
    
    if ($ofd.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) {
        try {
            $lines = Get-Content $ofd.FileName
            foreach ($line in $lines) {
                if ($line -match "(.+)=(.+)") {
                    $key = $Matches[1].Trim()
                    $val = $Matches[2].Trim()
                    if ($script:UI_Elements.ContainsKey($key)) {
                        $script:UI_Elements[$key].Text = $val
                    }
                }
            }
            $txtOutput.Text = "Параметры успешно импортированы из файла: $($ofd.FileName)"
        } catch {
            [System.Windows.Forms.MessageBox]::Show("Не удалось прочитать файл.", "Ошибка импорта")
        }
    } else {
        # Если пользователь отменил диалог - загружаем эталонную деталь из Word-документа
        $script:UI_Elements["Модуль нормальный (M)"].Text = "5"
        $script:UI_Elements["Угол профиля (UD)"].Text = "30"
        $script:UI_Elements["Число зубьев фрезы (ZU)"].Text = "10"
        $script:UI_Elements["Наружный диаметр фрезы (DLU)"].Text = "90"
        $script:UI_Elements["Число заходов (U)"].Text = "1"
        $script:UI_Elements["Длина фрезы (DL)"].Text = "85"
        $script:UI_Elements["Задний угол (AV)"].Text = "4"
        $script:UI_Elements["Класс точности (CL)"].Text = "B"
        $script:UI_Elements["Число зубьев (Z1)"].Text = "27"
        $script:UI_Elements["Наружный диаметр (DL1)"].Text = "145"
        $script:UI_Elements["Высота головки зуба (H1)"].Text = "5"
        $script:UI_Elements["Полная высота зуба (H)"].Text = "8.5"
        $script:UI_Elements["Толщина зуба по I оконч. (SD1)"].Text = "7.578"
        $script:UI_Elements["Дуга дел. окр. I под шевинг. (SD2)"].Text = "7.578"
