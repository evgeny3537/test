# ==============================================================================
# БАЗОВЫЕ МАТЕМАТИЧЕСКИЕ ИНСТРУМЕНТЫ
# ==============================================================================
function Get-Rad ([double]$deg) { return $deg * [math]::PI / 180.0 }
function Get-Deg ([double]$rad) { return $rad * 180.0 / [math]::PI }
function Get-Inv ([double]$alpha_rad) { return [math]::Tan($alpha_rad) - $alpha_rad }

# Итерационный поиск угла по инвалюте (Метод Ньютона-Рафсона)
function Get-AlphaFromInv ([double]$inv_val) {
    if ($inv_val -le 0) { return 0.0 }
    $x = [math]::Pow((3.0 * $inv_val), (1.0/3.0))
    for ($i = 0; $i -lt 30; $i++) {
        $fx = [math]::Tan($x) - $x - $inv_val
        $dfx = [math]::Pow([math]::Tan($x), 2)
        if ($dfx -eq 0) { break }
        $x_new = $x - ($fx / $dfx)
        if ([math]::Abs($x_new - $x) -lt 0.000000000001) { return $x_new }
        $x = $x_new
    }
    return $x
}

# Вспомогательная функция безопасного извлечения числовых данных из GUI
function Get-Val ($key, $default = $null) {
    if ($script:UI_Elements.ContainsKey($key)) {
        $text = $script:UI_Elements[$key].Text.Replace(',', '.')
        if ([string]::IsNullOrWhiteSpace($text)) { return $default }
        try {
            return [double]$text
        } catch {
            return $default
        }
    }
    return $default
}

