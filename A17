# ==============================================================================
# ФУНКЦИЯ ПРОЦЕДУРНОГО ПОСТРОЕНИЯ ЭВОЛЬВЕНТНОЙ ГЕОМЕТРИИ (ДЛЯ ВИЗУАЛИЗАЦИИ)
# ==============================================================================
function New-Point2D {
    param([double]$X, [double]$Y)
    [pscustomobject]@{ X = $X; Y = $Y }
}

function Get-ProceduralGearPoints {
    param(
        [double]$Cx, [double]$Cy,
        [double]$m, [int]$z, [double]$x_coeff = 0,
        [double]$alpha_deg = 30.0,
        [double]$Da_override = $null,
        [double]$Df_override = $null
    )
    $R = ($m * $z) / 2.0
    $alpha_rad = $alpha_deg * [math]::PI / 180.0
    $Rb = $R * [math]::Cos($alpha_rad)
    
    $Ra = if ($null -ne $Da_override) { $Da_override / 2.0 } else { $R + $m * (1.0 + $x_coeff) }
    $Rf = if ($null -ne $Df_override) { $Df_override / 2.0 } else { $R - $m * (1.25 - $x_coeff) }
    if ($Rf -lt $Rb) { $Rb = $Rf * 0.95 } # коррекция базового диаметра
    
    $s_thick = $m * ([math]::PI / 2.0 + 2.0 * $x_coeff * [math]::Tan($alpha_rad))
    $theta_s = $s_thick / $R 
    
    $pts = New-Object 'System.Collections.Generic.List[object]'
    $angle_per_tooth = (2.0 * [math]::PI) / $z
    
    for ($i = 0; $i -lt $z; $i++) {
        $tooth_center_angle = $i * $angle_per_tooth
        $flank1 = New-Object 'System.Collections.Generic.List[object]'
        $flank2 = New-Object 'System.Collections.Generic.List[object]'
        
        for ($step = 0; $step -le 6; $step++) {
            $f = $step / 6.0
            $r_val = $Rf + ($Ra - $Rf) * $f
            if ($r_val -lt $Rb) { $r_val = $Rb }
            
            $inv_val = [math]::Sqrt([math]::Max(0.0, [math]::Pow($r_val / $Rb, 2) - 1.0))
            $theta_inv = $inv_val - [math]::Acos($Rb / $r_val)
            
            $inv_alpha = [math]::Tan($alpha_rad) - $alpha_rad
            $inv_alpha_r = [math]::Tan([math]::Acos($Rb / $r_val)) - [math]::Acos($Rb / $r_val)
            $theta_r = ($s_thick / (2.0 * $R)) + $inv_alpha - $inv_alpha_r
            
            $a1 = $tooth_center_angle - $theta_r
            $flank1.Add((New-Point2D -X ($Cx + $r_val * [math]::Cos($a1)) -Y ($Cy + $r_val * [math]::Sin($a1))))
            
            $a2 = $tooth_center_angle + $theta_r
            $flank2.Add((New-Point2D -X ($Cx + $r_val * [math]::Cos($a2)) -Y ($Cy + $r_val * [math]::Sin($a2))))
        }
        
        foreach ($p in $flank1) { $pts.Add($p) }
        for ($k = $flank2.Count - 1; $k -ge 0; $k--) { $pts.Add($flank2[$k]) }
        
        $a_gap = $tooth_center_angle + $angle_per_tooth / 2.0
        $pts.Add((New-Point2D -X ($Cx + $Rf * [math]::Cos($a_gap)) -Y ($Cy + $Rf * [math]::Sin($a_gap))))
    }
    
    if ($pts.Count -gt 0) { $pts.Add($pts[0]) }
    return $pts
}

# ==============================================================================
# СИСТЕМА ИНТЕРАКТИВНОЙ ВИЗУАЛИЗАЦИИ И АНИМАЦИИ (3D RENDER ENGINE)
# ==============================================================================
function Show-Visualizer {
    # Сбор актуальных геометрических данных из расчетов
    $m = Get-Val "Модуль нормальный (M)" 5.0
    $z1 = [int](Get-Val "Число зубьев (Z1)" 27)
    $x1 = Get-Val "Коэффициент смещения (X1)" 0.0
    $da1 = Get-Val "Наружный диаметр (DL1)" 145.0
    $H1 = Get-Val "Высота головки зуба (H1)" 5.0
    $H = Get-Val "Полная высота зуба (H)" 8.5
    $df1 = $da1 - 2 * $H # Диаметр впадин

    # Данные сопряженного зацепления
    $z2 = [int](Get-Val "Число зубьев (Z2)")
    $da2 = Get-Val "Наружный диаметр (DL2)")
    $x2 = Get-Val "Коэф. смещения (X2)" 0.0
    $a12 = Get-Val "Межосевое расстояние (A12)"

    $WindowWidth = 1000
    $WindowHeight = 800
    $Padding = 100

    # Процедурная генерация деталей
    $gear1_pts = Get-ProceduralGearPoints -Cx 0 -Cy 0 -m $m -z $z1 -x_coeff $x1 -Da_override $da1 -Df_override $df1
    $gear2_pts = $null
    
    if ($null -ne $z2 -and $null -ne $da2 -and $null -ne $a12) {
        # Вторая шестерня сдвинута по оси X на величину межосевого расстояния A12
        $gear2_pts = Get-ProceduralGearPoints -Cx $a12 -Cy 0 -m $m -z $z2 -x_coeff $x2 -Da_override $da2
    }

    # Расчет общих габаритов сцены
    $minX = -($da1/2) - 10
    $maxX = if ($null -ne $gear2_pts) { $a12 + ($da2/2) + 10 } else { ($da1/2) + 10 }
    $minY = -([Math]::Max($da1, $da2)/2) - 10
    $maxY = ([Math]::Max($da1, $da2)/2) + 10
    
    $width = $maxX - $minX
    $height = $maxY - $minY

    # Окно рендера
    $vForm = New-Object System.Windows.Forms.Form
    $vForm.Text = "Визуализация и контроль эвольвентного зацепления"
    $vForm.Width = $WindowWidth
    $vForm.Height = $WindowHeight
    $vForm.StartPosition = 'CenterParent'
    $vForm.BackColor = [System.Drawing.Color]::White

    $pic = New-Object System.Windows.Forms.PictureBox
    $pic.SizeMode = 'Zoom'
    $pic.Width = $vForm.Width
    $pic.Height = $vForm.Height
    $pic.Left = 0; $pic.Top = 0
    $vForm.Controls.Add($pic)

    # --- Контрольная панель ---
    $gbType = New-Object System.Windows.Forms.GroupBox
    $gbType.Text = "Режим анализа профиля"
    $gbType.Width = 240; $gbType.Height = 80; $gbType.Top = 15; $gbType.Left = 15
    $gbType.BackColor = [System.Drawing.Color]::FromArgb(235, 245, 255)

    $rbGost = New-Object System.Windows.Forms.RadioButton
    $rbGost.Text = "Шлицы ГОСТ 6033-80"
    $rbGost.Top = 20; $rbGost.Left = 10; $rbGost.Width = 220; $rbGost.Checked = ($script:ProfileType -eq "GOST")
    $rbGear = New-Object System.Windows.Forms.RadioButton
    $rbGear.Text = "Эвольвентные шестерни"
    $rbGear.Top = 45; $rbGear.Left = 10; $rbGear.Width = 220; $rbGear.Checked = ($script:ProfileType -eq "Gear")

    $rbGost.Add_CheckedChanged({ if ($rbGost.Checked) { $script:ProfileType = "GOST" } })
    $rbGear.Add_CheckedChanged({ if ($rbGear.Checked) { $script:ProfileType = "Gear" } })
    $gbType.Controls.AddRange(@($rbGost, $rbGear))
    $pic.Controls.Add($gbType)

    # --- Рендеринг сцены ---
    $penLine = New-Object System.Drawing.Pen([System.Drawing.Color]::Black, 1.5)
    $penLine2 = New-Object System.Drawing.Pen([System.Drawing.Color]::Blue, 1.2)
    $penCenter = New-Object System.Drawing.Pen([System.Drawing.Color]::Red, 2)
    $fontData = New-Object System.Drawing.Font('Segoe UI', 9, [System.Drawing.FontStyle]::Bold)
    $brushBlack = [System.Drawing.Brushes]::Black

    $scaleX = ($WindowWidth - 2 * $Padding) / $width
    $scaleY = ($WindowHeight - 2 * $Padding) / $height
    $scale = [Math]::Min($scaleX, $scaleY)
    $padX = ($WindowWidth - ($width * $scale)) / 2
    $padY = ($WindowHeight - ($height * $scale)) / 2

    # Внутренняя функция преобразования в экранные координаты
    $ConvertPoint = {
        param([double]$X, [double]$Y)
        $sx = $padX + (($X - $minX) * $scale)
        $sy = ($WindowHeight - $padY) - (($Y - $minY) * $scale)
        return New-Object System.Drawing.PointF([float]$sx, [float]$sy)
    }

    $DrawCanvas = {
        param([System.Drawing.Graphics]$g, [double]$angle)
        $g.SmoothingMode = [System.Drawing.Drawing2D.SmoothingMode]::AntiAlias
        $g.Clear([System.Drawing.Color]::White)

        # Отрисовка детали 1 (ведущая)
        $saved = $g.Save()
        $pCenter1 = &$ConvertPoint 0 0
        $g.TranslateTransform($pCenter1.X, $pCenter1.Y)
        $g.RotateTransform([float]$angle)
        $g.TranslateTransform(-$pCenter1.X, -$pCenter1.Y)

        for ($idx = 0; $idx -lt $gear1_pts.Count - 1; $idx++) {
            $pa = &$ConvertPoint $gear1_pts[$idx].X $gear1_pts[$idx].Y
            $pb = &$ConvertPoint $gear1_pts[$idx+1].X $gear1_pts[$idx+1].Y
            $g.DrawLine($penLine, $pa, $pb)
        }
        $g.Restore($saved)

        # Отрисовка детали 2 (ведомая)
        if ($null -ne $gear2_pts) {
            $saved = $g.Save()
            $pCenter2 = &$ConvertPoint $a12 0
            $g.TranslateTransform($pCenter2.X, $pCenter2.Y)
            # Вращение в обратную сторону с учетом передаточного числа
            $ratio = -($z1 / $z2)
            $g.RotateTransform([float]($angle * $ratio))
            $g.TranslateTransform(-$pCenter2.X, -$pCenter2.Y)

            for ($idx = 0; $idx -lt $gear2_pts.Count - 1; $idx++) {
                $pa = &$ConvertPoint $gear2_pts[$idx].X $gear2_pts[$idx].Y
                $pb = &$ConvertPoint $gear2_pts[$idx+1].X $gear2_pts[$idx+1].Y
                $g.DrawLine($penLine2, $pa, $pb)
            }
            $g.Restore($saved)

            # Линия межосевого расстояния
            $g.DrawLine($penCenter, $pCenter1, $pCenter2)
            $g.DrawString("Межосевое расстояние А12: $a12 мм", $fontData, $brushBlack, (($pCenter1.X + $pCenter2.X)/2 - 80), (($pCenter1.Y + $pCenter2.Y)/2 + 10))
        }

        # Отрисовка центров вращения
        $g.DrawLine($penCenter, ($pCenter1.X - 8), $pCenter1.Y, ($pCenter1.X + 8), $pCenter1.Y)
        $g.DrawLine($penCenter, $pCenter1.X, ($pCenter1.Y - 8), $pCenter1.X, ($pCenter1.Y + 8))
        $g.DrawString("Деталь Z=$z1, m=$m", $fontData, $brushBlack, ($pCenter1.X - 50), ($pCenter1.Y - 30))
    }

    # Таймер анимации вращения
    $script:visAngle = 0.0
    $vBmp = New-Object System.Drawing.Bitmap($WindowWidth, $WindowHeight)
    $vTimer = New-Object System.Windows.Forms.Timer
    $vTimer.Interval = 20
    $vTimer.Add_Tick({
        $script:visAngle += 0.8
        $g = [System.Drawing.Graphics]::FromImage($vBmp)
        &$DrawCanvas $g $script:visAngle
        $g.Dispose()
        $pic.Image = $vBmp
    })

    # Сохранение в JPG
    $btnSave = New-Object System.Windows.Forms.Button
    $btnSave.Text = "Сохранить JPG"
    $btnSave.Width = 110; $btnSave.Height = 25; $btnSave.Top = 15; $btnSave.Left = $vForm.Width - 140
    $btnSave.Add_Click({
        $vTimer.Stop()
        $sfd = New-Object System.Windows.Forms.SaveFileDialog
        $sfd.Filter = "JPEG Image|*.jpg"
        if ($sfd.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) {
            $vBmp.Save($sfd.FileName, [System.Drawing.Imaging.ImageFormat]::Jpeg)
        }
        $vTimer.Start()
    })
    $vForm.Controls.Add($btnSave)
    $btnSave.BringToFront()

    $vForm.Add_FormClosing({ $vTimer.Stop() })
    $vTimer.Start()
    $vForm.ShowDialog() | Out-Null
}

