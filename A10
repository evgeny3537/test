# СТРОГО ТИПИЗИРОВАННАЯ ФУНКЦИЯ (Исправляет ошибку op_Subtraction)
function Add-InputRow {
    param(
        [System.Windows.Forms.GroupBox]$Parent,
        [string]$LabelText,
        [int]$Y,             # Жестко указываем, что это число
        [int]$InputX,        # Жестко указываем, что это число
        [string]$ControlType = "TextBox",
        [string]$DefaultValue = ""
    )
    
    $lbl = New-Object System.Windows.Forms.Label
    $lbl.Text = $LabelText
    $lbl.Location = New-Object System.Drawing.Point(10, $Y)
    $lbl.AutoSize = $true
    $Parent.Controls.Add($lbl)

    if ($ControlType -eq "ComboBox") {
        $input = New-Object System.Windows.Forms.ComboBox
        $input.DropDownStyle = [System.Windows.Forms.ComboBoxStyle]::DropDownList
    } else {
        $input = New-Object System.Windows.Forms.TextBox
        $input.Text = $DefaultValue
    }
    
    # Математика с координатами теперь безопасна
    $input.Location = New-Object System.Drawing.Point($InputX, ([int]$Y - 3))
    $input.Size = New-Object System.Drawing.Size(80, 20)
    $Parent.Controls.Add($input)
    
    # Сохраняем элемент в глобальный массив по его имени
    $script:UI_Elements[$LabelText] = $input
}

