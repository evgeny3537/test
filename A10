# ==============================================================================
# МАТЕМАТИЧЕСКИЕ ФУНКЦИИ (ГОСТ 6033-80)
# ==============================================================================
function Deg2Rad ([double]$deg) { return $deg * [math]::PI / 180 }
function Rad2Deg ([double]$rad) { return $rad * 180 / [math]::PI }

function Get-Involute ([double]$alpha_rad) {
    return [math]::Tan($alpha_rad) - $alpha_rad
}

function Get-AngleFromInvolute ([double]$inv_val) {
    $x = [math]::Pow((3 * $inv_val), (1.0/3.0))
    for ($i = 0; $i -lt 20; $i++) {
        $fx = [math]::Tan($x) - $x - $inv_val
        $dfx = [math]::Pow([math]::Tan($x), 2)
        if ($dfx -eq 0) { break }
        $x_new = $x - ($fx / $dfx)
        if ([math]::Abs($x_new - $x) -lt 0.000001) { return $x_new }
        $x = $x_new
    }
    return $x
}

