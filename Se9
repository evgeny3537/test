$btnClear             = New-Object System.Windows.Forms.Button
$btnClear.Text        = 'Очистить'
$btnClear.Location    = New-Object System.Drawing.Point(540, 147)
$btnClear.Size        = New-Object System.Drawing.Size(90, 28)
$btnClear.FlatStyle   = 'Flat'

$btnOpenDbf             = New-Object System.Windows.Forms.Button
$btnOpenDbf.Text        = 'Открыть DBF'
$btnOpenDbf.Location    = New-Object System.Drawing.Point(640, 147)
$btnOpenDbf.Size        = New-Object System.Drawing.Size(120, 28)
$btnOpenDbf.FlatStyle   = 'Flat'
$btnOpenDbf.BackColor   = [System.Drawing.Color]::FromArgb(144, 238, 144)
$btnOpenDbf.Enabled     = $false

$progress           = New-Object System.Windows.Forms.ProgressBar
$progress.Location  = New-Object System.Drawing.Point(12, 185)
$progress.Size      = New-Object System.Drawing.Size(1060, 18)
$progress.Minimum   = 0
$progress.Maximum   = 100

$pnlTop.Controls.AddRange(@(
    $lblTerm, $txtTerm,
    $btnSearch, $btnClear, $btnOpenDbf,
    $progress
))

$statusBar2 = New-Object System.Windows.Forms.StatusStrip
$statusLbl2 = New-Object System.Windows.Forms.ToolStripStatusLabel
$statusLbl2.Text = "Каталог поиска: $scriptDir"
[void]$statusBar2.Items.Add($statusLbl2)

$listView               = New-Object System.Windows.Forms.ListView
$listView.Dock          = 'Fill'
$listView.View          = 'Details'
$listView.FullRowSelect = $true
$listView.GridLines     = $true
$listView.Font          = New-Object System.Drawing.Font('Consolas', 9)

[void]$listView.Columns.Add('Файл',       400)
[void]$listView.Columns.Add('Источник',   140)
[void]$listView.Columns.Add('№',           50)
[void]$listView.Columns.Add('Фрагмент',   480)

$form.Controls.AddRange(@($pnlTop, $listView, $statusBar2))

$btnClear.Add_Click({
    $listView.Items.Clear()
    $progress.Value     = 0
    $statusLbl2.Text    = "Каталог: $scriptDir"
    $btnOpenDbf.Enabled = $false
})

$listView.Add_SelectedIndexChanged({
    $sel = $listView.SelectedItems
    if ($sel.Count -gt 0) {
        $ext = [System.IO.Path]::GetExtension($sel[0].Text).ToLowerInvariant()
        $btnOpenDbf.Enabled = ($ext -eq '.dbf')
    }
    else {
        $btnOpenDbf.Enabled = $false
    }
})

function Open-SelectedDbf {
    $sel = $listView.SelectedItems
    if ($sel.Count -eq 0) { return }
    $item  = $sel[0]
    $ext   = [System.IO.Path]::GetExtension($item.Text).ToLowerInvariant()
    if ($ext -ne '.dbf') { return }
    $recNo = 0
    try { $recNo = [int]$item.SubItems[2].Text } catch {}
    Show-DbfViewer `
        -FilePath       $item.Text `
        -HighlightRecNo $recNo `
        -SearchTerm     $txtTerm.Text.Trim() `
        -Encodings      (Get-TestEncodings)
}

$listView.Add_DoubleClick({ Open-SelectedDbf })
$btnOpenDbf.Add_Click({    Open-SelectedDbf })

$btnSearch.Add_Click({
    $term = $txtTerm.Text.Trim()

    if ([string]::IsNullOrWhiteSpace($term)) {
        [System.Windows.Forms.MessageBox]::Show(
            'Введите текст для поиска.', 'Проверка',
            [System.Windows.Forms.MessageBoxButtons]::OK,
            [System.Windows.Forms.MessageBoxIcon]::Warning) | Out-Null
        return
    }

    $listView.Items.Clear()
    $progress.Value      = 0
    $btnSearch.Enabled   = $false
    $btnClear.Enabled    = $false
    $btnOpenDbf.Enabled  = $false
    $form.UseWaitCursor  = $true

    $encodings = Get-TestEncodings
    $exts      = '.dbf','.cdx','.fpt','.fpw','.mem','.fp','.tmp'

    $files = @(
        Get-ChildItem -LiteralPath $scriptDir -Recurse -File -ErrorAction SilentlyContinue |
        Where-Object { $exts -contains $_.Extension.ToLowerInvariant() }
    )

    $total = $files.Count
    if ($total -eq 0) {
        $statusLbl2.Text    = 'Файлы не найдены.'
        $btnSearch.Enabled  = $true
        $btnClear.Enabled   = $true
        $form.UseWaitCursor = $false
        return
    }

    $found = 0
    $i     = 0

    $colorA = [System.Drawing.Color]::White
    $colorB = [System.Drawing.Color]::FromArgb(240, 248, 255)

    foreach ($file in $files) {
        $i++
        $ext  = $file.Extension.ToLowerInvariant()
        $hits = @()

        if ($ext -eq '.dbf') {
            $hits = @(Search-DbfFile -Path $file.FullName -Term $term -Encodings $encodings)
            if ($hits.Count -eq 0) {
                $raw = @(Search-RawFile -Path $file.FullName -Term $term -Encodings $encodings)
                if ($raw.Count -gt 0) { $hits = $raw }
            }
        }
        else {
            $raw = @(Search-RawFile -Path $file.FullName -Term $term -Encodings $encodings)
            if ($raw.Count -gt 0) { $hits = $raw }
        }

        foreach ($hit in $hits) {
            $found++
            $recStr = if ($hit.RecNo -gt 0) { [string]$hit.RecNo } else { '-' }

            $lvi = New-Object System.Windows.Forms.ListViewItem($hit.Path)
            [void]$lvi.SubItems.Add($hit.Source)
            [void]$lvi.SubItems.Add($recStr)
            [void]$lvi.SubItems.Add($hit.Preview)
            $lvi.BackColor = if ($found % 2 -eq 0) { $colorB } else { $colorA }
            [void]$listView.Items.Add($lvi)
        }

        $progress.Value = [Math]::Min(100, [int](($i / $total) * 100))
        $statusLbl2.Text = "Проверено: $i / $total  |  Найдено: $found"
        [System.Windows.Forms.Application]::DoEvents()
    }

    $statusLbl2.Text    = "Готово. Найдено: $found (файлов: $total) | Двойной клик — просмотр"
    $btnSearch.Enabled  = $true
    $btnClear.Enabled   = $true
    $form.UseWaitCursor = $false
    $progress.Value     = 100
})

$form.AcceptButton = $btnSearch
[void]$form.ShowDialog()
$form.Dispose()
