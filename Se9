$txtTerm.Font       = New-Object System.Drawing.Font('Segoe UI', 9)

$btnSearch            = New-Object System.Windows.Forms.Button
$btnSearch.Text       = 'Поиск'
$btnSearch.Location   = New-Object System.Drawing.Point(430, 147)
$btnSearch.Size       = New-Object System.Drawing.Size(100, 28)
$btnSearch.BackColor  = [System.Drawing.Color]::FromArgb(70, 130, 180)
$btnSearch.ForeColor  = [System.Drawing.Color]::White
