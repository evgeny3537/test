# ─────────────────────────────────────────────
#  ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ
# ─────────────────────────────────────────────

function Get-TestEncodings {
    $codes = 866, 1251, 65001
    $list  = [System.Collections.Generic.List[System.Text.Encoding]]::new()
    foreach ($cp in $codes) {
        try { $list.Add([System.Text.Encoding]::GetEncoding($cp)) } catch {}
    }
    return $list.ToArray()
}

function Copy-ByteSlice {
    param([byte[]]$Source, [int]$Offset, [int]$Length)
    if ($Length -le 0 -or $Offset -lt 0 -or ($Offset + $Length) -gt $Source.Length) {
        return [byte[]]::new(0)
    }
    $buf = [byte[]]::new($Length)
    [System.Buffer]::BlockCopy($Source, $Offset, $buf, 0, $Length)
    return $buf
}

function Find-BytePattern {
    param([byte[]]$Haystack, [byte[]]$Needle)
    if (-not $Needle -or $Needle.Length -eq 0) { return -1 }
    if ($Haystack.Length -lt $Needle.Length)   { return -1 }
    $first = $Needle[0]
    $limit = $Haystack.Length - $Needle.Length
    for ($i = 0; $i -le $limit; $i++) {
        if ($Haystack[$i] -ne $first) { continue }
        $ok = $true
        for ($j = 1; $j -lt $Needle.Length; $j++) {
            if ($Haystack[$i + $j] -ne $Needle[$j]) { $ok = $false; break }
        }
        if ($ok) { return $i }
    }
    return -1
}

function Get-ByteSnippet {
    param([byte[]]$Bytes, [int]$Index, [int]$Context = 60)
    if ($Index -lt 0) { return '' }
    $start = [Math]::Max(0, $Index - $Context)
    $len   = [Math]::Min($Context * 2 + 20, $Bytes.Length - $start)
    if ($len -le 0) { return '' }
    $slice = Copy-ByteSlice $Bytes $start $len
    foreach ($cp in 866, 1251, 65001) {
        try {
            $enc = [System.Text.Encoding]::GetEncoding($cp)
            $txt = $enc.GetString($slice) -replace '[\x00-\x1F\x7F]+', ' ' -replace '\s{2,}', ' '
            if ($txt.Trim().Length -gt 10) { return $txt.Trim() }
        } catch {}
    }
    return [BitConverter]::ToString($slice).Replace('-', ' ')
}

# ─────────────────────────────────────────────
#  ПОИСК В БИНАРНОМ ФАЙЛЕ
# ─────────────────────────────────────────────

function Search-RawFile {
    param(
        [string]$Path,
        [string]$Term,
        [System.Text.Encoding[]]$Encodings
    )
    $results = [System.Collections.Generic.List[object]]::new()
    try {
        $bytes = [System.IO.File]::ReadAllBytes($Path)
    }
    catch {
        return $results
    }

    foreach ($enc in $Encodings) {
        try {
            $needle = $enc.GetBytes($Term)
            $idx    = Find-BytePattern -Haystack $bytes -Needle $needle
            if ($idx -ge 0) {
                $obj = New-Object PSObject -Property @{
                    Path    = $Path
                    Source  = "RAW ($($enc.WebName))"
                    Preview = Get-ByteSnippet -Bytes $bytes -Index $idx
                    RecNo   = -1
                }
                $results.Add($obj)
                return $results
            }
        } catch {}
    }
    return $results
}

# ─────────────────────────────────────────────
#  РАЗБОР ЗАГОЛОВКА DBF
# ─────────────────────────────────────────────

function Read-DbfMeta {
    param([byte[]]$Bytes)
    if ($Bytes.Length -lt 32) { return $null }

    $headerLen = [System.BitConverter]::ToUInt16($Bytes, 8)
    $recordLen = [System.BitConverter]::ToUInt16($Bytes, 10)
    $numRecs   = [System.BitConverter]::ToUInt32($Bytes, 4)

    if ($headerLen -lt 64 -or $recordLen -lt 1 -or $headerLen -gt $Bytes.Length) {
        return $null
    }

    $fields      = [System.Collections.Generic.List[object]]::new()
    $offset      = 32
    $fieldOffset = 1

    while (($offset + 32) -le $headerLen) {
        if ($Bytes[$offset] -eq 0x0D -or $Bytes[$offset] -eq 0x00) { break }

        $nameRaw = Copy-ByteSlice $Bytes $offset 11
        $name    = [System.Text.Encoding]::ASCII.GetString($nameRaw).Trim([char]0, ' ')
        $type    = [char]$Bytes[$offset + 11]
        $fldLen  = [int]$Bytes[$offset + 16]
        $dec     = [int]$Bytes[$offset + 17]

        if ($fldLen -gt 0 -and $name.Length -gt 0) {
            $fobj = New-Object PSObject -Property @{
                Name        = $name
                Type        = [string]$type
                Length      = $fldLen
                Decimals    = $dec
                FieldOffset = $fieldOffset
            }
            $fields.Add($fobj)
            $fieldOffset += $fldLen
        }
        $offset += 32
    }

    if ($fields.Count -eq 0) { return $null }

    $meta = New-Object PSObject -Property @{
        HeaderLength = [int]$headerLen
        RecordLength = [int]$recordLen
        NumRecords   = [int]$numRecs
        Fields       = $fields
    }
    return $meta
}

# ─────────────────────────────────────────────
#  ЧТЕНИЕ ВСЕХ ЗАПИСЕЙ DBF (лимит 10000)
# ─────────────────────────────────────────────

function Get-FieldValue {
    param(
        [byte[]]$Fb,
        [string]$FType,
        [System.Text.Encoding]$BestEnc
    )

    if ($FType -eq 'C' -or $FType -eq 'M' -or $FType -eq 'V') {
        try { return $BestEnc.GetString($Fb).Trim() } catch { return '' }
    }
    elseif ($FType -eq 'N' -or $FType -eq 'F') {
        try { return [System.Text.Encoding]::ASCII.GetString($Fb).Trim() } catch { return '' }
    }
    elseif ($FType -eq 'D') {
        try {
            $ds = [System.Text.Encoding]::ASCII.GetString($Fb).Trim()
            if ($ds.Length -eq 8) {
                return "$($ds.Substring(6,2)).$($ds.Substring(4,2)).$($ds.Substring(0,4))"
            }
            return $ds
        } catch { return '' }
    }
    elseif ($FType -eq 'L') {
        try {
            $lv = [System.Text.Encoding]::ASCII.GetString($Fb).Trim().ToUpper()
            if ($lv -eq 'T' -or $lv -eq 'Y') { return 'Да' }
            if ($lv -eq 'F' -or $lv -eq 'N') { return 'Нет' }
            return $lv
        } catch { return '' }
    }
    else {
        try { return $BestEnc.GetString($Fb).Trim() } catch { return '' }
    }
}

function Read-DbfAllRecords {
    param(
        [string]$Path,
        [System.Text.Encoding[]]$Encodings,
        [int]$MaxRecords = 10000
    )
    try {
        $bytes = [System.IO.File]::ReadAllBytes($Path)
    }
    catch { return $null }

    $meta = Read-DbfMeta -Bytes $bytes
    if (-not $meta) { return $null }

    $headerLen = $meta.HeaderLength
    $recordLen = $meta.RecordLength
    $fields    = @($meta.Fields)

    $bestEnc = $null
    foreach ($e in $Encodings) {
        if ($e.CodePage -eq 866) { $bestEnc = $e; break }
    }
    if (-not $bestEnc) { $bestEnc = $Encodings[0] }

    $records = [System.Collections.Generic.List[object]]::new()
    $pos     = $headerLen
    $recNo   = 0
    $maxPos  = $bytes.Length - $recordLen
    $count   = 0

    while ($pos -le $maxPos -and $count -lt $MaxRecords) {
        $recNo++
        $deleted  = ($bytes[$pos] -eq 0x2A)
        $fieldPos = $pos + 1

        $rowHash = @{}
        $rowHash['#']   = [string]$recNo
        $rowHash['Del'] = if ($deleted) { '*' } else { '' }

        foreach ($f in $fields) {
            if (($fieldPos + $f.Length) -gt $bytes.Length) {
                $rowHash[$f.Name] = ''
                continue
            }
            $fb  = Copy-ByteSlice $bytes $fieldPos $f.Length
            $val = Get-FieldValue -Fb $fb -FType $f.Type -BestEnc $bestEnc
            $rowHash[$f.Name] = $val -replace '[\x00-\x08\x0B\x0C\x0E-\x1F\x7F]', ''
            $fieldPos += $f.Length
        }

        $records.Add([pscustomobject]$rowHash)
        $pos += $recordLen
        $count++
    }

    $result = New-Object PSObject -Property @{
        Meta    = $meta
        Records = $records
        Path    = $Path
        Enc     = $bestEnc
    }
    return $result
}

# ─────────────────────────────────────────────
#  ПОИСК В DBF
# ─────────────────────────────────────────────

function Search-DbfFile {
    param(
        [string]$Path,
        [string]$Term,
        [System.Text.Encoding[]]$Encodings
    )
    $results = [System.Collections.Generic.List[object]]::new()

    try {
        $bytes = [System.IO.File]::ReadAllBytes($Path)
    }
    catch { return $results }

    $meta = Read-DbfMeta -Bytes $bytes
    if (-not $meta) { return $results }

    $headerLen = $meta.HeaderLength
    $recordLen = $meta.RecordLength
    $fields    = @($meta.Fields)
    $cmp       = [StringComparison]::OrdinalIgnoreCase

    $bestEnc = $null
    foreach ($e in $Encodings) {
        if ($e.CodePage -eq 866) { $bestEnc = $e; break }
    }
    if (-not $bestEnc) { $bestEnc = $Encodings[0] }

    $pos    = $headerLen
    $recNo  = 0
    $maxPos = $bytes.Length - $recordLen

    while ($pos -le $maxPos) {
        $recNo++
        if ($bytes[$pos] -eq 0x2A) { $pos += $recordLen; continue }

        $fieldPos = $pos + 1
        $hits     = [System.Collections.Generic.List[string]]::new()

        foreach ($f in $fields) {
            if (($fieldPos + $f.Length) -gt $bytes.Length) { break }
            $fb = Copy-ByteSlice $bytes $fieldPos $f.Length

            try {
                $v = $bestEnc.GetString($fb).Trim()
                if ($v.Length -gt 0 -and $v.IndexOf($Term, $cmp) -ge 0) {
                    $hits.Add("$($f.Name)=[$v]")
                }
            } catch {}

            $fieldPos += $f.Length
        }

        if ($hits.Count -gt 0) {
            $obj = New-Object PSObject -Property @{
                Path    = $Path
                Source  = "Запись №$recNo"
                Preview = ($hits -join ' | ')
                RecNo   = $recNo
            }
            $results.Add($obj)
        }
        $pos += $recordLen
    }
    return $results
}

