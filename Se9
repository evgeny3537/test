function Show-DbfViewer {
    param(
        [string]$FilePath,
        [int]$HighlightRecNo = -1,
        [string]$SearchTerm  = '',
        [System.Text.Encoding[]]$Encodings
    )

    $typeDesc = @{
        'C' = 'Character — строка'
        'N' = 'Numeric — число'
        'F' = 'Float — число с плавающей точкой'
        'D' = 'Date — дата (ГГГГММДД)'
        'T' = 'DateTime — дата и время'
        'L' = 'Logical — логическое (T/F)'
        'M' = 'Memo — длинный текст (FPT)'
        'G' = 'General — OLE-объект'
        'P' = 'Picture — изображение'
        'B' = 'Double — двойная точность'
        'I' = 'Integer — целое'
        'Y' = 'Currency — валюта'
        'V' = 'VarChar — переменная длина'
    }

    $vForm = New-Object System.Windows.Forms.Form
    $vForm.Text          = "DBF: $([System.IO.Path]::GetFileName($FilePath))"
    $vForm.Size          = New-Object System.Drawing.Size(1200, 700)
    $vForm.StartPosition = 'CenterScreen'
    $vForm.MinimumSize   = New-Object System.Drawing.Size(800, 500)

    # Панель сверху (220px = 90 + 130)
    $pnlInfo             = New-Object System.Windows.Forms.Panel
    $pnlInfo.Dock        = 'Top'
    $pnlInfo.Height      = 220
    $pnlInfo.BackColor   = [System.Drawing.Color]::FromArgb(240, 248, 255)

    $lblFilePath           = New-Object System.Windows.Forms.Label
    $lblFilePath.Text      = "Файл: $FilePath"
    $lblFilePath.Location  = New-Object System.Drawing.Point(8, 138)
    $lblFilePath.Size      = New-Object System.Drawing.Size(1160, 16)
    $lblFilePath.Font      = New-Object System.Drawing.Font('Consolas', 8)
    $lblFilePath.ForeColor = [System.Drawing.Color]::DarkBlue

    $lblMeta1          = New-Object System.Windows.Forms.Label
    $lblMeta1.Location = New-Object System.Drawing.Point(8, 158)
    $lblMeta1.Size     = New-Object System.Drawing.Size(1100, 18)
    $lblMeta1.Font     = New-Object System.Drawing.Font('Segoe UI', 9)

    $lblFind          = New-Object System.Windows.Forms.Label
    $lblFind.Text     = 'Фильтр:'
    $lblFind.Location = New-Object System.Drawing.Point(8, 184)
    $lblFind.AutoSize = $true

    $txtFind          = New-Object System.Windows.Forms.TextBox
    $txtFind.Location = New-Object System.Drawing.Point(65, 181)
    $txtFind.Size     = New-Object System.Drawing.Size(260, 22)
    $txtFind.Text     = $SearchTerm

    $btnFind          = New-Object System.Windows.Forms.Button
    $btnFind.Text     = 'Найти'
    $btnFind.Location = New-Object System.Drawing.Point(335, 179)
    $btnFind.Size     = New-Object System.Drawing.Size(70, 26)

    $btnReset          = New-Object System.Windows.Forms.Button
    $btnReset.Text     = 'Сброс'
    $btnReset.Location = New-Object System.Drawing.Point(415, 179)
    $btnReset.Size     = New-Object System.Drawing.Size(70, 26)

    $lblCount            = New-Object System.Windows.Forms.Label
    $lblCount.Location   = New-Object System.Drawing.Point(495, 184)
    $lblCount.AutoSize   = $true
    $lblCount.ForeColor  = [System.Drawing.Color]::DarkRed

    $btnExport            = New-Object System.Windows.Forms.Button
    $btnExport.Text       = 'CSV'
    $btnExport.Location   = New-Object System.Drawing.Point(680, 179)
    $btnExport.Size       = New-Object System.Drawing.Size(60, 26)

    $pnlInfo.Controls.AddRange(@(
        $lblFilePath, $lblMeta1,
        $lblFind, $txtFind, $btnFind, $btnReset, $lblCount, $btnExport
    ))

    # Вкладки
    $tabs      = New-Object System.Windows.Forms.TabControl
    $tabs.Dock = 'Fill'

    $tabData      = New-Object System.Windows.Forms.TabPage
    $tabData.Text = 'Данные'

    $tabStruct      = New-Object System.Windows.Forms.TabPage
    $tabStruct.Text = 'Структура'

    $tabs.TabPages.AddRange(@($tabData, $tabStruct))

    # DataGridView
    $grid = New-Object System.Windows.Forms.DataGridView
    $grid.Dock                    = 'Fill'
    $grid.ReadOnly                = $true
    $grid.AllowUserToAddRows      = $false
    $grid.AllowUserToDeleteRows   = $false
    $grid.AllowUserToResizeRows   = $false
    $grid.AutoSizeColumnsMode     = 'None'
    $grid.SelectionMode           = 'FullRowSelect'
    $grid.BackgroundColor         = [System.Drawing.Color]::White
    $grid.EnableHeadersVisualStyles = $false
    $grid.Font                    = New-Object System.Drawing.Font('Consolas', 9)
    $grid.RowHeadersWidth         = 50

    $altStyle          = New-Object System.Windows.Forms.DataGridViewCellStyle
    $altStyle.BackColor = [System.Drawing.Color]::FromArgb(245, 250, 255)
    $grid.AlternatingRowsDefaultCellStyle = $altStyle

    $hdrStyle           = New-Object System.Windows.Forms.DataGridViewCellStyle
    $hdrStyle.BackColor = [System.Drawing.Color]::FromArgb(70, 130, 180)
    $hdrStyle.ForeColor = [System.Drawing.Color]::White
    $hdrStyle.Font      = New-Object System.Drawing.Font('Segoe UI', 9, [System.Drawing.FontStyle]::Bold)
    $grid.ColumnHeadersDefaultCellStyle = $hdrStyle

    # Структура
    $structView               = New-Object System.Windows.Forms.ListView
    $structView.Dock          = 'Fill'
    $structView.View          = 'Details'
    $structView.FullRowSelect = $true
    $structView.GridLines     = $true
    $structView.Font          = New-Object System.Drawing.Font('Consolas', 10)

    [void]$structView.Columns.Add('#',         40)
    [void]$structView.Columns.Add('Поле',     160)
    [void]$structView.Columns.Add('Тип',       50)
    [void]$structView.Columns.Add('Длина',     60)
    [void]$structView.Columns.Add('Дес.',      50)
    [void]$structView.Columns.Add('Описание', 380)

    $tabData.Controls.Add($grid)
    $tabStruct.Controls.Add($structView)

    $statusBar  = New-Object System.Windows.Forms.StatusStrip
    $statusLbl  = New-Object System.Windows.Forms.ToolStripStatusLabel
    $statusLbl.Text = 'Загрузка...'
    [void]$statusBar.Items.Add($statusLbl)

    $vForm.Controls.AddRange(@($pnlInfo, $tabs, $statusBar))

    $script:vDt      = $null
    $script:vMeta    = $null
    $script:vFilePath = $FilePath

    $vForm.Add_Shown({
        $vForm.UseWaitCursor = $true
        $statusLbl.Text      = 'Загрузка данных...'
        [System.Windows.Forms.Application]::DoEvents()

        $dbfData = Read-DbfAllRecords -Path $FilePath -Encodings $Encodings -MaxRecords 10000
        if (-not $dbfData) {
            $statusLbl.Text      = 'Ошибка чтения или файл повреждён.'
            $vForm.UseWaitCursor = $false
            return
        }

        $script:vMeta = $dbfData.Meta
        $m = $script:vMeta

        $lblMeta1.Text = "Записей: $($m.NumRecords) | Полей: $($m.Fields.Count) | Длина записи: $($m.RecordLength) байт | Кодировка: $($dbfData.Enc.WebName)"

        $structView.Items.Clear()
        $fi = 0
        foreach ($f in $m.Fields) {
            $fi++
            $desc = ''
            if ($typeDesc.ContainsKey($f.Type)) { $desc = $typeDesc[$f.Type] }

            $lvi = New-Object System.Windows.Forms.ListViewItem([string]$fi)
            [void]$lvi.SubItems.Add($f.Name)
            [void]$lvi.SubItems.Add($f.Type)
            [void]$lvi.SubItems.Add([string]$f.Length)
            [void]$lvi.SubItems.Add($(if ($f.Decimals -gt 0) { [string]$f.Decimals } else { '-' }))
            [void]$lvi.SubItems.Add($desc)

            $lvi.BackColor = switch ($f.Type) {
                'C'     { [System.Drawing.Color]::FromArgb(255, 255, 230) }
                'N'     { [System.Drawing.Color]::FromArgb(230, 255, 230) }
                'D'     { [System.Drawing.Color]::FromArgb(230, 240, 255) }
                'M'     { [System.Drawing.Color]::FromArgb(255, 230, 240) }
                'L'     { [System.Drawing.Color]::FromArgb(245, 245, 255) }
                default { [System.Drawing.Color]::White }
            }
            [void]$structView.Items.Add($lvi)
        }

        $dt = New-Object System.Data.DataTable
        [void]$dt.Columns.Add('#',   [string])
        [void]$dt.Columns.Add('Del', [string])
        foreach ($f in $m.Fields) {
            [void]$dt.Columns.Add($f.Name, [string])
        }

        foreach ($rec in $dbfData.Records) {
            $row  = $dt.NewRow()
            $props = $rec.PSObject.Properties
            foreach ($p in $props) {
                if ($dt.Columns.Contains($p.Name)) {
                    $row[$p.Name] = if ($null -eq $p.Value) { '' } else { [string]$p.Value }
                }
            }
            $dt.Rows.Add($row) | Out-Null
        }

        $script:vDt     = $dt
        $grid.DataSource = $dt

        foreach ($col in $grid.Columns) {
            $col.SortMode = 'Automatic'
            if ($col.Name -eq '#') {
                $col.Width = 50
            }
            elseif ($col.Name -eq 'Del') {
                $col.Width = 35
            }
            else {
                $fld = $m.Fields | Where-Object { $_.Name -eq $col.Name } | Select-Object -First 1
                if ($fld) {
                    $col.Width = [Math]::Max(80, [Math]::Min(250, $fld.Length * 8))
                }
                else {
                    $col.Width = 100
                }
            }
        }

        if ($HighlightRecNo -gt 0 -and $HighlightRecNo -le $grid.Rows.Count) {
            $ri = $HighlightRecNo - 1
            $grid.FirstDisplayedScrollingRowIndex = [Math]::Max(0, $ri - 5)
            $grid.Rows[$ri].Selected = $true
            $grid.Rows[$ri].DefaultCellStyle.BackColor = [System.Drawing.Color]::Yellow
        }

        if ($SearchTerm.Length -gt 0) {
            $cmp = [StringComparison]::OrdinalIgnoreCase
            foreach ($row in $grid.Rows) {
                foreach ($cell in $row.Cells) {
                    if ($cell.Value -and ([string]$cell.Value).IndexOf($SearchTerm, $cmp) -ge 0) {
                        $cell.Style.BackColor = [System.Drawing.Color]::FromArgb(255, 220, 80)
                    }
                }
            }
        }

        $vForm.Text     = "DBF: $([System.IO.Path]::GetFileName($FilePath)) [$($m.NumRecords) зап.]"
        $statusLbl.Text = "Загружено: $($dbfData.Records.Count) из $($m.NumRecords) | Двойной клик — копировать строку"
        $lblCount.Text  = "Показано: $($dbfData.Records.Count)"
        $vForm.UseWaitCursor = $false
    })

    $doFilter = {
        $fTerm = $txtFind.Text.Trim()
        $dt    = $script:vDt
        if (-not $dt) { return }

        if ($fTerm.Length -eq 0) {
            $grid.DataSource = $dt
            $lblCount.Text   = "Показано: $($dt.Rows.Count)"
            return
        }

        $filtered = $dt.Clone()
        $cmp      = [StringComparison]::OrdinalIgnoreCase

        foreach ($row in $dt.Rows) {
            $found = $false
            foreach ($col in $dt.Columns) {
                $val = [string]$row[$col.ColumnName]
                if ($val.IndexOf($fTerm, $cmp) -ge 0) { $found = $true; break }
            }
            if ($found) { $filtered.ImportRow($row) }
        }

        $grid.DataSource = $filtered
        $lblCount.Text   = "Найдено: $($filtered.Rows.Count) из $($dt.Rows.Count)"

        foreach ($row in $grid.Rows) {
            foreach ($cell in $row.Cells) {
                if ($cell.Value -and ([string]$cell.Value).IndexOf($fTerm, $cmp) -ge 0) {
                    $cell.Style.BackColor = [System.Drawing.Color]::FromArgb(255, 220, 80)
                }
            }
        }
    }

    $btnFind.Add_Click($doFilter)

    $txtFind.Add_KeyDown({
        param($s, $e)
        if ($e.KeyCode -eq [System.Windows.Forms.Keys]::Return) {
            & $doFilter
        }
    })

    $btnReset.Add_Click({
        $txtFind.Text    = ''
        $dt = $script:vDt
        if ($dt) {
            $grid.DataSource = $dt
            $lblCount.Text   = "Показано: $($dt.Rows.Count)"
        }
    })

    $grid.Add_CellDoubleClick({
        param($s, $e)
        if ($e.RowIndex -lt 0) { return }
        $row   = $grid.Rows[$e.RowIndex]
        $parts = [System.Collections.Generic.List[string]]::new()
        foreach ($cell in $row.Cells) {
            $parts.Add("$($cell.OwningColumn.HeaderText): $($cell.Value)")
        }
        [System.Windows.Forms.Clipboard]::SetText($parts -join "`r`n")
        $statusLbl.Text = 'Строка скопирована в буфер обмена'
    })

    $btnExport.Add_Click({
        $dt = $script:vDt
        if (-not $dt) { return }

        $dlg            = New-Object System.Windows.Forms.SaveFileDialog
        $dlg.Filter     = 'CSV файлы (*.csv)|*.csv'
        $dlg.FileName   = [System.IO.Path]::GetFileNameWithoutExtension($script:vFilePath) + '.csv'

        if ($dlg.ShowDialog() -ne 'OK') { return }

        $sb  = New-Object System.Text.StringBuilder
        $hdr = ($dt.Columns | ForEach-Object { '"' + $_.ColumnName + '"' }) -join ';'
        [void]$sb.AppendLine($hdr)

        foreach ($row in $dt.Rows) {
            $parts = $dt.Columns | ForEach-Object { '"' + ([string]$row[$_.ColumnName]).Replace('"','""') + '"' }
            [void]$sb.AppendLine($parts -join ';')
        }

        [System.IO.File]::WriteAllText($dlg.FileName, $sb.ToString(), [System.Text.Encoding]::UTF8)
        $statusLbl.Text = "Экспорт завершён: $($dlg.FileName)"
    })

    [void]$vForm.ShowDialog()
    $vForm.Dispose()
}

