))

$folderDlg = New-Object System.Windows.Forms.FolderBrowserDialog
$folderDlg.Description = "Выберите папку с файлами"

$worker = New-Object System.ComponentModel.BackgroundWorker
$worker.WorkerReportsProgress = $true
$worker.WorkerSupportsCancellation = $true

$script:matchCount = 0
$script:totalFiles = 0

$btnBrowse.Add_Click({
    if ($folderDlg.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) {
        $txtFolder.Text = $folderDlg.SelectedPath
    }
})

$btnCancel.Add_Click({
    if ($worker.IsBusy) {
        $worker.CancelAsync()
        $lblStatus.Text = "Остановка..."
    }
})

$worker.Add_DoWork({
    param($sender, $e)

    $args = $e.Argument
    $folder = $args.Folder
    $term = $args.Term
    $encodings = Get-TestEncodings
    $exts = @('.dbf', '.cdx', '.fpt', '.fpw', '.mem', '.fp', '.tmp')

    $files = Get-ChildItem -LiteralPath $folder -Recurse -File -ErrorAction SilentlyContinue |
        Where-Object { $exts -contains $_.Extension.ToLowerInvariant() }

    $total = @($files).Count
    $sender.ReportProgress(0, @{ Type = 'Init'; Total = $total })

    $i = 0
    foreach ($file in $files) {
        if ($sender.CancellationPending) {
            $e.Cancel = $true
            return
        }

        $i++
        $result = Find-TextInFile -Path $file.FullName -Term $term -Encodings $encodings
        if ($result) {
            $sender.ReportProgress(0, @{ Type = 'Match'; Data = $result })
        }

        $sender.ReportProgress(0, @{ Type = 'Progress'; Current = $i; Total = $total })
    }
})

$worker.Add_ProgressChanged({
    param($sender, $e)

    $data = $e.UserState
    switch ($data.Type) {
        'Init' {
            $script:totalFiles = $data.Total
            $script:matchCount = 0
            $progress.Value = 0
            $lblStatus.Text = "Проверяется файлов: $($script:totalFiles)"
        }
        'Progress' {
            if ($data.Total -gt 0) {
                $percent = [Math]::Min(100, [int](($data.Current * 100) / $data.Total))
                $progress.Value = $percent
                $lblStatus.Text = "Проверено $($data.Current) из $($data.Total), найдено $($script:matchCount)"
            }
        }
        'Match' {
            $script:matchCount++
            $r = $data.Data

            $item = New-Object System.Windows.Forms.ListViewItem($r.Path)
            [void]$item.SubItems.Add($r.Encoding)
            [void]$item.SubItems.Add($r.Preview)
            [void]$listView.Items.Add($item)

            $lblStatus.Text = "Проверено, найдено $($script:matchCount)"
        }
    }
})

$worker.Add_RunWorkerCompleted({
    param($sender, $e)

    $btnSearch.Enabled = $true
    $btnCancel.Enabled = $false
    $form.UseWaitCursor = $false

    if ($e.Cancelled) {
        $lblStatus.Text = "Остановлено. Найдено: $($script:matchCount)"
    } elseif ($e.Error) {
        $lblStatus.Text = "Ошибка: $($e.Error.Message)"
        [System.Windows.Forms.MessageBox]::Show($e.Error.ToString(), "Ошибка") | Out-Null
    } else {
        $lblStatus.Text = "Готово. Найдено: $($script:matchCount)"
        $progress.Value = 100
    }
})

$btnSearch.Add_Click({
    $folder = $txtFolder.Text.Trim()
    $term = $txtTerm.Text.Trim()

    if ([string]::IsNullOrWhiteSpace($folder) -or -not (Test-Path -LiteralPath $folder)) {
        [System.Windows.Forms.MessageBox]::Show("Выбери существующую папку.", "Проверка") | Out-Null
        return
    }

    if ([string]::IsNullOrWhiteSpace($term)) {
        [System.Windows.Forms.MessageBox]::Show("Введи текст для поиска.", "Проверка") | Out-Null
        return
    }

    $listView.Items.Clear()
    $progress.Value = 0
    $lblStatus.Text = "Запуск поиска..."
    $btnSearch.Enabled = $false
    $btnCancel.Enabled = $true
    $form.UseWaitCursor = $true

    $worker.RunWorkerAsync(@{
        Folder = $folder
        Term   = $term
    })
})

$form.AcceptButton = $btnSearch
[void]$form.ShowDialog()
