        "Запусти скрипт в STA-режиме (обычный powershell.exe 5.1).",
        "PowerShell"
    ) | Out-Null
    return
}

function Get-TestEncodings {
    $list = New-Object System.Collections.Generic.List[System.Text.Encoding]
    foreach ($codePage in 866, 1251, 65001, 1200, 1201, 20127) {
        try {
            $list.Add([System.Text.Encoding]::GetEncoding($codePage))
        } catch { }
    }
    try { $list.Add([System.Text.Encoding]::Default) } catch { }
    $list | Select-Object -Unique
}

function Find-TextInFile {
    param(
        [Parameter(Mandatory = $true)][string]$Path,
        [Parameter(Mandatory = $true)][string]$Term,
        [System.Text.Encoding[]]$Encodings
    )

    try {
        $bytes = [System.IO.File]::ReadAllBytes($Path)
    } catch {
        return $null
    }

    foreach ($enc in $Encodings) {
        try {
            $text = $enc.GetString($bytes)
        } catch {
            continue
        }

        $idx = $text.IndexOf($Term, [System.StringComparison]::OrdinalIgnoreCase)
        if ($idx -ge 0) {
            $start = [Math]::Max(0, $idx - 40)
            $len = [Math]::Min(120, $text.Length - $start)
            $snippet = $text.Substring($start, $len)
            $snippet = $snippet -replace "[`r`n`t]+", " "
            $snippet = $snippet -replace "\s{2,}", " "
            return [pscustomobject]@{
                Path     = $Path
                Encoding = $enc.WebName
                Preview  = $snippet
            }
        }
    }

    return $null
}

