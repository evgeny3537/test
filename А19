function Show-Visualizer {
    # Сбор актуальных геометрических данных из расчетов
    $m = Get-Val "Модуль нормальный (M)" 5.0
    $z1_raw = Get-Val "Число зубьев (Z1)" 27
    $z1 = [int]$z1_raw
    $x1 = Get-Val "Коэффициент смещения (X1)" 0.0
    $da1 = Get-Val "Наружный диаметр (DL1)" 145.0
    $H1 = Get-Val "Высота головки зуба (H1)" 5.0
    $H = Get-Val "Полная высота зуба (H)" 8.5
    $df1 = $da1 - 2 * $H # Диаметр впадин детали 1
    $d1 = $m * $z1

    # Данные сопряженного зацепления
    $z2_raw = Get-Val "Число зубьев (Z2)"
    $z2 = if ($null -ne $z2_raw) { [int]$z2_raw } else { $null }
    
    # ИСПРАВЛЕНО: удалена лишняя закрывающая скобка на конце строки
    $da2 = Get-Val "Наружный диаметр (DL2)"
    
    $x2 = Get-Val "Коэф. смещения (X2)" 0.0
    $a12 = Get-Val "Межосевое расстояние (A12)"

    $WindowWidth = 1200
    $WindowHeight = 900
    $Padding = 120

    # Процедурная генерация деталей с корректным наложением впадин
    $gear1_pts = Get-ProceduralGearPoints -Cx 0 -Cy 0 -m $m -z $z1 -x_coeff $x1 -Da_override $da1 -Df_override $df1
    $gear2_pts = $null
    
    if ($null -ne $z2 -and $null -ne $da2 -and $null -ne $a12) {
        $df2 = $da2 - 2.0 * $H # Рассчитываем точную впадину сопряженной шестерни
        $gear2_pts = Get-ProceduralGearPoints -Cx $a12 -Cy 0 -m $m -z $z2 -x_coeff $x2 -Da_override $da2 -Df_override $df2
    }

    # Расчет общих габаритов сцены для позиционирования размерных линий
    $minX = -($da1/2) - 10
    $maxX = if ($null -ne $gear2_pts) { $a12 + ($da2/2) + 10 } else { ($da1/2) + 10 }
    $minY = -([Math]::Max($da1, $da2)/2) - 10
    $maxY = ([Math]::Max($da1, $da2)/2) + 10
    
    $width = $maxX - $minX
    $height = $maxY - $minY

    # Окно рендера
    $vForm = New-Object System.Windows.Forms.Form
    $vForm.Text = "Визуализация и контроль эвольвентного зацепления"
    $vForm.Width = $WindowWidth
    $vForm.Height = $WindowHeight
    $vForm.StartPosition = 'CenterParent'
    $vForm.BackColor = [System.Drawing.Color]::White

    $pic = New-Object System.Windows.Forms.PictureBox
    $pic.SizeMode = 'Zoom'
    $pic.Width = $vForm.Width
    $pic.Height = $vForm.Height
    $pic.Left = 0; $pic.Top = 0
    $vForm.Controls.Add($pic)

    # --- Рендеринг сцены ---
    $penLine = New-Object System.Drawing.Pen([System.Drawing.Color]::Black, 1.5)
    $penLine2 = New-Object System.Drawing.Pen([System.Drawing.Color]::Blue, 1.2)
    $penCenter = New-Object System.Drawing.Pen([System.Drawing.Color]::Red, 2)
    $fontData = New-Object System.Drawing.Font("Segoe UI", 9, [System.Drawing.FontStyle]::Bold)
    $fontSmall = New-Object System.Drawing.Font("Consolas", 8)
    $brushBlack = [System.Drawing.Brushes]::Black

    # Настройка чертежных кистей по образу и подобию примера DXF
    $gridPen = New-Object System.Drawing.Pen([System.Drawing.Color]::FromArgb(235, 235, 235), 1)
    $penOuter = New-Object System.Drawing.Pen([System.Drawing.Color]::DarkOrange, 1)
    $penOuter.DashStyle = [System.Drawing.Drawing2D.DashStyle]::DashDot
    $penInner = New-Object System.Drawing.Pen([System.Drawing.Color]::Purple, 1)
    $penInner.DashStyle = [System.Drawing.Drawing2D.DashStyle]::Dash
    $penPitch = New-Object System.Drawing.Pen([System.Drawing.Color]::ForestGreen, 1)
    $penPitch.DashStyle = [System.Drawing.Drawing2D.DashStyle]::DashDotDot

    $penCenterLine = New-Object System.Drawing.Pen([System.Drawing.Color]::Red, 1)
    $penCenterLine.DashStyle = [System.Drawing.Drawing2D.DashStyle]::DashDot

    $penDimGlobal = New-Object System.Drawing.Pen([System.Drawing.Color]::Blue, 1.5)
    $arrowCap = New-Object System.Drawing.Drawing2D.AdjustableArrowCap(4, 4)
    $penDimGlobal.CustomStartCap = $arrowCap
    $penDimGlobal.CustomEndCap   = $arrowCap

    $penLocalDim = New-Object System.Drawing.Pen([System.Drawing.Color]::DarkOrange, 1.2)
    $penLocalDim.CustomStartCap = $arrowCap
    $penLocalDim.CustomEndCap   = $arrowCap

    $fontDimGlobal = New-Object System.Drawing.Font('Segoe UI', 10, [System.Drawing.FontStyle]::Bold)
    $formatCenter = New-Object System.Drawing.StringFormat
    $formatCenter.Alignment = [System.Drawing.StringAlignment]::Center
    $formatCenter.LineAlignment = [System.Drawing.StringAlignment]::Center

    $scaleX = ($WindowWidth - 2 * $Padding) / $width
    $scaleY = ($WindowHeight - 2 * $Padding) / $height
    $scale = [Math]::Min($scaleX, $scaleY)
    $padX = ($WindowWidth - ($width * $scale)) / 2
    $padY = ($WindowHeight - ($height * $scale)) / 2

    # Внутренняя функция преобразования в экранные координаты
    $ConvertPoint = {
        param([double]$X, [double]$Y)
        $sx = $padX + (($X - $minX) * $scale)
        $sy = ($WindowHeight - $padY) - (($Y - $minY) * $scale)
        return New-Object System.Drawing.PointF([float]$sx, [float]$sy)
    }

    # Внутренний хелпер рисования текста с фоном
    $DrawTextWithBg = {
        param($Graphics, $Text, $Font, $Brush, $X, $Y, $Format)
        $size = $Graphics.MeasureString($Text, $Font)
        $rect = New-Object System.Drawing.RectangleF(($X - $size.Width/2), ($Y - $size.Height/2), $size.Width, $size.Height)
        $bg = New-Object System.Drawing.SolidBrush([System.Drawing.Color]::FromArgb(235, 255, 255, 255))
        $Graphics.FillRectangle($bg, $rect)
        $Graphics.DrawString($Text, $Font, $Brush, $X, $Y, $Format)
        $bg.Dispose()
    }

    $DrawCanvas = {
        param([System.Drawing.Graphics]$g, [double]$angle)
        $g.SmoothingMode = [System.Drawing.Drawing2D.SmoothingMode]::AntiAlias
        $g.Clear([System.Drawing.Color]::White)

        # 1. Отрисовка фоновой сетки
        for ($gx = [Math]::Floor($minX/20.0)*20.0; $gx -le $maxX; $gx += 20.0) {
            $p1 = &$ConvertPoint $gx $minY
            $p2 = &$ConvertPoint $gx $maxY
            $g.DrawLine($gridPen, $p1.X, $p1.Y, $p2.X, $p2.Y)
        }
        for ($gy = [Math]::Floor($minY/20.0)*20.0; $gy -le $maxY; $gy += 20.0) {
            $p1 = &$ConvertPoint $minX $gy
            $p2 = &$ConvertPoint $maxX $gy
            $g.DrawLine($gridPen, $p1.X, $p1.Y, $p2.X, $p2.Y)
        }

        # 2. Отрисовка детали 1 (ведущая)
        $saved = $g.Save()
        $pCenter1 = &$ConvertPoint 0 0
        $g.TranslateTransform($pCenter1.X, $pCenter1.Y)
        $g.RotateTransform([float]$angle)
        $g.TranslateTransform(-$pCenter1.X, -$pCenter1.Y)

        for ($idx = 0; $idx -lt $gear1_pts.Count - 1; $idx++) {
            $pa = &$ConvertPoint $gear1_pts[$idx].X $gear1_pts[$idx].Y
            $pb = &$ConvertPoint $gear1_pts[$idx+1].X $gear1_pts[$idx+1].Y
            $g.DrawLine($penLine, $pa, $pb)
        }
        $g.Restore($saved)

        # 3. Вспомогательные окружности детали 1 (Da, D, Df)
        $r1OutPx = ($da1 / 2.0) * $scale
        $r1PitchPx = ($d1 / 2.0) * $scale
        $r1InPx = ($df1 / 2.0) * $scale
        $g.DrawEllipse($penOuter, [float]($pCenter1.X - $r1OutPx), [float]($pCenter1.Y - $r1OutPx), [float]($r1OutPx*2), [float]($r1OutPx*2))
        $g.DrawEllipse($penPitch, [float]($pCenter1.X - $r1PitchPx), [float]($pCenter1.Y - $r1PitchPx), [float]($r1PitchPx*2), [float]($r1PitchPx*2))
        $g.DrawEllipse($penInner, [float]($pCenter1.X - $r1InPx), [float]($pCenter1.Y - $r1InPx), [float]($r1InPx*2), [float]($r1InPx*2))

        # Высота зуба детали 1
        $g.DrawLine($penLocalDim, $pCenter1.X, ($pCenter1.Y - $r1InPx), $pCenter1.X, ($pCenter1.Y - $r1OutPx))
        &$DrawTextWithBg $g ("Высота зуба H: {0:N2} мм" -f $H) $fontData [System.Drawing.Brushes]::DarkOrange ($pCenter1.X + 85) ($pCenter1.Y - $r1InPx - ($r1OutPx - $r1InPx)/2) $formatCenter

        # Отрисовка детали 2 (ведомая)
        if ($null -ne $gear2_pts) {
            $saved = $g.Save()
            $pCenter2 = &$ConvertPoint $a12 0
            $g.TranslateTransform($pCenter2.X, $pCenter2.Y)
            
            # Вращение ведомой детали с идеальным межосевым фазовым сдвигом
            $ratio = -($z1 / $z2)
            $phase_shift = 180.0 / $z2 
            $g.RotateTransform([float](($angle * $ratio) + $phase_shift))
            $g.TranslateTransform(-$pCenter2.X, -$pCenter2.Y)

            for ($idx = 0; $idx -lt $gear2_pts.Count - 1; $idx++) {
                $pa = &$ConvertPoint $gear2_pts[$idx].X $gear2_pts[$idx].Y
                $pb = &$ConvertPoint $gear2_pts[$idx+1].X $gear2_pts[$idx+1].Y
                $g.DrawLine($penLine2, $pa, $pb)
            }
            $g.Restore($saved)

            # Вспомогательные окружности детали 2 (Da, D, Df)
            $r2OutPx = ($da2 / 2.0) * $scale
            $r2PitchPx = (($m * $z2) / 2.0) * $scale
            $r2InPx = ($df2 / 2.0) * $scale
            $g.DrawEllipse($penOuter, [float]($pCenter2.X - $r2OutPx), [float]($pCenter2.Y - $r2OutPx), [float]($r2OutPx*2), [float]($r2OutPx*2))
            $g.DrawEllipse($penPitch, [float]($pCenter2.X - $r2PitchPx), [float]($pCenter2.Y - $r2PitchPx), [float]($r2PitchPx*2), [float]($r2PitchPx*2))
            $g.DrawEllipse($penInner, [float]($pCenter2.X - $r2InPx), [float]($pCenter2.Y - $r2InPx), [float]($r2InPx*2), [float]($r2InPx*2))

            # Размерная линия связи и А12
            $g.DrawLine($penCenterLine, $pCenter1, $pCenter2)
            $g.DrawLine($penDimGlobal, $pCenter1.X, ($pCenter1.Y + 40), $pCenter2.X, ($pCenter2.Y + 40))
            &$DrawTextWithBg $g ("Межосевое расстояние А12: $a12 мм" -f $a12) $fontDimGlobal [System.Drawing.Brushes]::Red (($pCenter1.X + $pCenter2.X)/2) ($pCenter1.Y + 40) $formatCenter
            
            # Блок характеристик ведомой детали
            $info2 = "Сопряженное колесо Z2`nЗубья (Z): $z2`nМодуль (m): $m мм`nВнеш. диам. (Da2): $da2 мм`nВнутр. диам. (Df2): $df2 мм"
            &$DrawTextWithBg $g $info2 $fontData [System.Drawing.Brushes]::Blue $pCenter2.X ($pCenter2.Y - $r2OutPx - 50) $formatCenter
        }

        # Блок характеристик ведущей детали
        $info1 = "Деталь Z1 (вал)`nЗубья (Z): $z1`nМодуль (m): $m мм`nВнеш. диам. (Da1): $da1 мм`nВнутр. диам. (Df1): $df1 мм"
        &$DrawTextWithBg $g $info1 $fontData [System.Drawing.Brushes]::Black $pCenter1.X ($pCenter1.Y - $r1OutPx - 50) $formatCenter

        # Центры
        $g.DrawLine($penCenter, ($pCenter1.X - 8), $pCenter1.Y, ($pCenter1.X + 8), $pCenter1.Y)
        $g.DrawLine($penCenter, $pCenter1.X, ($pCenter1.Y - 8), $pCenter1.X, ($pCenter1.Y + 8))
        if ($null -ne $gear2_pts) {
            $g.DrawLine($penCenter, ($pCenter2.X - 8), $pCenter2.Y, ($pCenter2.X + 8), $pCenter2.Y)
            $g.DrawLine($penCenter, $pCenter2.X, ($pCenter2.Y - 8), $pCenter2.X, ($pCenter2.Y + 8))
        }

        # 4. Глобальные габаритные размеры на чертеже (из примера)
        $pBottomLeft  = &$ConvertPoint $minX $minY
        $pBottomRight = &$ConvertPoint $maxX $minY
        $pTopRight    = &$ConvertPoint $maxX $maxY

        # Общая ширина (снизу)
        $dimY = $pBottomLeft.Y + 45
        $g.DrawLine($penDimGlobal, $pBottomLeft.X, $dimY, $pBottomRight.X, $dimY)
        &$DrawTextWithBg $g ("Общая ширина контура: {0:N3} мм" -f $width) $fontDimGlobal [System.Drawing.Brushes]::Blue (($pBottomLeft.X + $pBottomRight.X) / 2) $dimY $formatCenter

        # Общая высота (сбоку справа)
        $savedSide = $g.Save()
        $dimX = $pBottomRight.X + 55
        $g.DrawLine($penDimGlobal, $dimX, $pBottomRight.Y, $dimX, $pTopRight.Y)
        $g.TranslateTransform($dimX, (($pBottomRight.Y + $pTopRight.Y) / 2))
        $g.RotateTransform(-90)
        &$DrawTextWithBg $g ("Общая высота контура: {0:N3} мм" -f $height) $fontDimGlobal [System.Drawing.Brushes]::Blue 0 0 $formatCenter
        $g.Restore($savedSide)

        # 5. Полупрозрачный системный технологический штамп в левом верхнем углу
        $stampBrush = New-Object System.Drawing.SolidBrush([System.Drawing.Color]::FromArgb(235, 240, 240, 250))
        $g.FillRectangle($stampBrush, 15, 15, 300, 110)
        $g.DrawRectangle($penLine, 15, 15, 300, 110)
        
        $stampFont = New-Object System.Drawing.Font('Courier New', 8.5, [System.Drawing.FontStyle]::Bold)
        $stampText = "САПР РАСЧЕТА ЧЕРВЯЧНЫХ ФРЕЗ`nГОСТ 6033-80 / Модульный шаг`n`nМодуль нарезки (M): $m мм`nУгол зацепления (UD): $UD°`nНаправление витков: Правое`nДата контроля: " + (Get-Date -Format "dd.MM.yyyy")
        $g.DrawString($stampText, $stampFont, [System.Drawing.Brushes]::DarkBlue, 20, 20)
        $stampBrush.Dispose()
    }

    # Таймер анимации вращения
    $script:visAngle = 0.0
    $vBmp = New-Object System.Drawing.Bitmap($WindowWidth, $WindowHeight)
    $vTimer = New-Object System.Windows.Forms.Timer
    $vTimer.Interval = 20
    $vTimer.Add_Tick({
        $script:visAngle += 0.8
        $g = [System.Drawing.Graphics]::FromImage($vBmp)
        &$DrawCanvas $g $script:visAngle
        $g.Dispose()
        $pic.Image = $vBmp
    })

    # Сохранение чертежа в JPG (высокое качество)
    $btnSave = New-Object System.Windows.Forms.Button
    $btnSave.Text = "Сохранить JPG"
    $btnSave.Width = 110; $btnSave.Height = 25; $btnSave.Top = 15; $btnSave.Left = $vForm.Width - 140
    $btnSave.Add_Click({
        $vTimer.Stop()
        $sfd = New-Object System.Windows.Forms.SaveFileDialog
        $sfd.Filter = "JPEG Image|*.jpg"
        if ($sfd.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) {
            $vBmp.Save($sfd.FileName, [System.Drawing.Imaging.ImageFormat]::Jpeg)
        }
        $vTimer.Start()
    })
    $vForm.Controls.Add($btnSave)
    $btnSave.BringToFront()

    $vForm.Add_FormClosing({ $vTimer.Stop() })
    $vTimer.Start()
    $vForm.ShowDialog() | Out-Null
}

