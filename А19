# ПОЛНЫЙ МАТЕМАТИЧЕСКИЙ РАСЧЕТНЫЙ БЛОК (52 ШАГА)
# ==============================================================================
function Get-CalculationSteps {
    $M     = Get-Val "Модуль нормальный (M)" 5.0
    $UD    = Get-Val "Угол профиля (UD)" 30.0
    $ZU    = Get-Val "Число зубьев фрезы (ZU)" 10.0
    $DLU   = Get-Val "Наружный диаметр фрезы (DLU)" 90.0
    $U     = Get-Val "Число заходов (U)" 1.0
    $DL    = Get-Val "Длина фрезы (DL)" 85.0
    $AV    = Get-Val "Задний угол (AV)" 4.0
    $Z2    = Get-Val "Число зубьев (Z2)" 27.0
    $DL2   = Get-Val "Наружный диаметр (DL2)" 145.0
    $X2    = Get-Val "Коэф. смещения (X2)" 0.0
    $Z1    = Get-Val "Число зубьев (Z1)" 27.0
    $DL1   = Get-Val "Наружный диаметр (DL1)" 145.0
    $X1    = Get-Val "Коэффициент смещения (X1)" 0.0
    $H1    = Get-Val "Высота головки зуба (H1)" 5.0
    $H     = Get-Val "Полная высота зуба (H)" 8.5
    $SD1   = Get-Val "Толщина зуба по I оконч. (SD1)" 7.578
    $SD2   = Get-Val "Дуга дел. окр. I под шевинг. (SD2)" 7.578
    $DRD   = Get-Val "Диаметр ролика (DRD)" 8.4
    $A12_UI= Get-Val "Межосевое расстояние (A12)" 136.476

    $steps = New-Object System.Collections.ArrayList

    # Прямая конвертация без вызова функций для обхода багов парсера PowerShell
    $AU = $UD
    $AU_rad = $AU * [math]::PI / 180.0
    $MU = $M
    $TU = [math]::PI * $MU
    $SU_no = $TU - $SD1
    $HU1 = $H - $H1
    $HU = $H + 0.3 * $M
    
    # 9. Падение затылка
    $AV_rad = $AV * [math]::PI / 180.0
    $K = ([math]::PI * $DLU / $ZU) * [math]::Tan($AV_rad)
    
    $DU = $DLU - 2 * $HU1 - 0.5 * $K
    $W_rad = [math]::Asin(($MU * $U) / $DU)
    $W = $W_rad * 180.0 / [math]::PI
    
    $TX = ($TU * $U) / [math]::Cos($W_rad)
    $DT = $DLU - 2 * $HU1 - 0.2 * $K
    $K1 = 1.3 * $K
    $HK = $HU + (($K + $K1) / 2.0) + 0.7
    $R1 = (0.12 * $MU) / (1.0 - [math]::Sin($AU_rad))
    $R2 = 0.3 * $M
    $T0 = $TU / [math]::Cos($W_rad)
    $T = $T0 * [math]::Pow((1.0 / [math]::Tan($W_rad)), 2)
    
    $AOC_rad = [math]::Atan([math]::Tan($AU_rad) / [math]::Cos($W_rad))
    $AOC = $AOC_rad * 180.0 / [math]::PI
    
    $SOC = $TU / (2.0 * [math]::Cos($W_rad))
    $SU_with = $SU_no - (0.532559265 * $M)
    $HUR = (($SOC - ($SU_with / [math]::Cos($W_rad))) / (2.0 * [math]::Tan($AOC_rad))) + $HU1

    $inv_UD = [math]::Tan($AU_rad) - $AU_rad
    $inv_AW = (2.0 * ($X2 + $X1) * [math]::Tan($AU_rad)) / ($Z2 + $Z1) + $inv_UD
    $AW_z_rad = Get-AlphaFromInv $inv_AW
    $AW_z = $AW_z_rad * 180.0 / [math]::PI
    $A12_calc = 0.5 * $M * ($Z2 + $Z1) * ([math]::Cos($AU_rad) / [math]::Cos($AW_z_rad))

    $DD1 = $M * $Z1
    $DD2 = $M * $Z2
    $DO1 = $DD1 * [math]::Cos($AU_rad)
    $DO2 = $DD2 * [math]::Cos($AU_rad)

    $P1 = $A12_calc * [math]::Sin($AW_z_rad) - 0.5 * [math]::Sqrt([math]::Pow($DL2, 2) - [math]::Pow($DO2, 2))
    $HY = $HU1 - (($DD1 / 2.0) * [math]::Sin($AU_rad) - $P1 - (($SD2 - $SD1) / 2.0) * [math]::Sin($AU_rad))
    $C = $HY / [math]::Cos($AOC_rad)
    $A = (($SD2 - $SD1) / 2.0) + 0.05
    $F = 0.75
    $AUF = $AU + 10.0
    $AUF_rad = $AUF * [math]::PI / 180.0
    $DC = $DL1 - 2.0 * $F
    
    $AC_rad = [math]::Acos(($DD1 * [math]::Cos($AU_rad)) / $DC)
    $AC = $AC_rad * 180.0 / [math]::PI
    $AFC_rad = [math]::Acos(($DD1 * [math]::Cos($AUF_rad)) / $DC)
    $AFC = $AFC_rad * 180.0 / [math]::PI

    # Расчет HF
    $num_HF = $DD1 * ([math]::Tan($AU_rad) - $AU_rad - [math]::Tan($AC_rad) + $AC_rad - [math]::Tan($AUF_rad) + $AUF_rad + [math]::Tan($AFC_rad) - $AFC_rad)
    $den_HF = 2.0 * ([math]::Tan($AU_rad) - [math]::Tan($AUF_rad))
    $HF = $num_HF / $den_HF

    $E = ($HU1 + $HF) / [math]::Cos($AU_rad)
    $AE_rad = [math]::Acos(($DD1 * [math]::Cos($AU_rad)) / $DL1)
    $AE = $AE_rad * 180.0 / [math]::PI
    
    # Инвалюты шагов
    $inv_AE = [math]::Tan($AE_rad) - $AE_rad
    $inv_AC = [math]::Tan($AC_rad) - $AC_rad
    $inv_AFC = [math]::Tan($AFC_rad) - $AFC_rad
    
    $SE = $DL1 * (($SD2 / $DD1) + $inv_UD - $inv_AE)
    $SC = $DC * (($SD2 / $DD1) + $inv_UD - $inv_AC)
    
    $AFE_rad = [math]::Acos(($DD1 * [math]::Cos($AUF_rad)) / $DL1)
    $AFE = $AFE_rad * 180.0 / [math]::PI
    $inv_AFE = [math]::Tan($AFE_rad) - $AFE_rad
    
    $SFE = $DL1 * (($SC / $DC) + $inv_AFC - $inv_AFE)
    $Q = ($SE - $SFE) / 2.0

    $DPOS = if ($DLU -ge 90) { 32 } elseif ($DLU -ge 70) { 27 } else { 22 }
    $DZAKR = $DPOS + 18
    $LZAKR = 4
    $LPOL_val = 20

    # Шаги 1-52
    $steps.Add(@("Шаг 1. Расчет профильного угла по нормали", "AU=UD=30", "AU=30")) | Out-Null
    $steps.Add(@("Шаг 2. Расчет модуля нормального", "MU=M=5", "MU=5")) | Out-Null
    $steps.Add(@("Шаг 3. Расчет шага нормального", "TU=Pi*MU", "TU=$([math]::Round($TU, 12))")) | Out-Null
    $steps.Add(@("Шаг 4. Расчет толщины зуба по нормали без учета припуска", "SU=TU-SD1", "SU=$([math]::Round($SU_no, 12))")) | Out-Null
    $steps.Add(@("Шаг 5. Получение расчетной высоты головки фрезы", "HU1=H-H1", "HU1=$HU1")) | Out-Null
    $steps.Add(@("Шаг 6. Получение полной высоты зуба", "HU=H+0.3*M", "HU=$HU")) | Out-Null
    $steps.Add(@("Шаг 7. Наружный диаметр фрезы", "DLU=$DLU", "DLU=$DLU")) | Out-Null
    $steps.Add(@("Шаг 8. Число зубьев фрезы", "ZU=$ZU", "ZU=$ZU")) | Out-Null
    $steps.Add(@("Шаг 9. Получение падения затылка", "K=(Pi*DLU/ZU)*tg(AV)", "K=$([math]::Round($K, 12))")) | Out-Null
    $steps.Add(@("Шаг 10. Получение диаметра начальной окружности фрезы", "DU=DLU-2*HU1-0.5*K", "DU=$([math]::Round($DU, 12))")) | Out-Null
    $steps.Add(@("Шаг 11. Получение угла подъема витков на начальной окружности", "W=arcsin((MU*U)/DU)", "W=$([math]::Round($W, 12))")) | Out-Null
    $steps.Add(@("Шаг 12. Получение хода витков по оси", "TX=(TU*U)/cos(W)", "TX=$([math]::Round($TX, 12))")) | Out-Null
    $steps.Add(@("Шаг 13. Определение направления витков фрезы", "Правое", "NAPR=Правое")) | Out-Null
    $steps.Add(@("Шаг 14. Направление винтовых стружечных канавок", "Стружечные канавки осевые", "NKAN=Осевые")) | Out-Null
    $steps.Add(@("Шаг 15. Получение среднего расчетного диаметра", "DT=DLU-2*HU1-0.2*K", "DT=$([math]::Round($DT, 12))")) | Out-Null
    $steps.Add(@("Шаг 16. Получение двойного затылования", "K1=1.3*K", "K1=$([math]::Round($K1, 12))")) | Out-Null
    $steps.Add(@("Шаг 17. Получение глубины канавки", "HK=HU+(K+K1)/2+0.7", "HK=$([math]::Round($HK, 12))")) | Out-Null
    $steps.Add(@("Шаг 18. Получение радиуса закругления головки зуба", "R1=(0.12*MU)/(1-sin(AU))", "R1=$([math]::Round($R1, 12))")) | Out-Null
    $steps.Add(@("Шаг 19. Получение радиуса закругления у ножки зуба", "R2=0.3*M", "R2=$R2")) | Out-Null
    $steps.Add(@("Шаг 20. Получение шага по оси", "T0=TU/cos(W)", "T0=$([math]::Round($T0, 12))")) | Out-Null
    $steps.Add(@("Шаг 21. Получение осевого шага винтовой стружечной канавки", "T=T0*sgr(ctg(W))", "T=$([math]::Round($T, 9))")) | Out-Null
    $steps.Add(@("Шаг 22. Получение профильного угла по оси", "AOC=arctg(tg(AU)/cos(W))", "AOC=$([math]::Round($AOC, 12))")) | Out-Null
    $steps.Add(@("Шаг 23. Получение толщины зуба исходной рейки по оси", "SOC=TU/2*cos(W)", "SOC=$([math]::Round($SOC, 12))")) | Out-Null
    $steps.Add(@("Шаг 24. Получение высоты головки зуба исходной рейки", "HUR=((SOC-SU/cos(W))/(2*tg(AOC)))+HU1", "HUR=$([math]::Round($HUR, 12))")) | Out-Null
    $steps.Add(@("Шаг 25. Получение инвалюты угла зацепления", "INVAW=(2*(X2+X1)*tg(UD))/(z2+z1)+inv(UD)", "INVAW=$([math]::Round($inv_AW, 12))")) | Out-Null
    $steps.Add(@("Шаг 26. Получение значения угла зацепления", "AW=inv_back(INVAW)", "AW=$([math]::Round($AW_z, 12))")) | Out-Null
    $steps.Add(@("Шаг 27. Получение значения межосевого расстояния", "A12=0.5*M*(Z2+Z1)*(cos(UD)/cos(AW))", "A12=$([math]::Round($A12_calc, 12))")) | Out-Null
    $steps.Add(@("Шаг 28. Получение диаметра делительной окружности детали", "DD1=M*Z1", "DD1=$DD1")) | Out-Null
    $steps.Add(@("Шаг 29. Получение диаметра делительной окружности сопряженной детали", "DD2=M*Z2", "DD2=$DD2")) | Out-Null
    $steps.Add(@("Шаг 30. Получение диаметра основной окружности детали", "DO1=DD1*cos(UD)", "DO1=$([math]::Round($DO1, 12))")) | Out-Null
    $steps.Add(@("Шаг 31. Получение диаметра основной окружности сопряженной детали", "DO2=DD2*cos(UD)", "DO2=$([math]::Round($DO2, 12))")) | Out-Null
    $steps.Add(@("Шаг 32. Получение радиуса кривизны эвольвенты", "P1=A12*sin(AW)-0.5*sqrt(DL2^2-DO2^2)", "P1=$([math]::Round($P1, 12))")) | Out-Null
    $steps.Add(@("Шаг 33. Получение расстояния от головки зуба фрезы до активного участка", "HY=HU1-((DD1/2)*sin(AU)-P1-(SD2-SD1)/2*sin(AU))", "HY=$([math]::Round($HY, 12))")) | Out-Null
    $steps.Add(@("Шаг 34. Получение длины усика для фрез с осевыми канавками", "C=HY/cos(AOC)", "C=$([math]::Round($C, 12))")) | Out-Null
    $steps.Add(@("Шаг 35. Получение значения высоты усика", "A=(SD2-SD1)/2+0.05", "A=$A")) | Out-Null
    $steps.Add(@("Шаг 36. Величина фаски зуба фрезы", "F=0.75", "F=$F")) | Out-Null
    $steps.Add(@("Шаг 37. Получение значения угла фланка", "AUF=AU+10", "AUF=$AUF")) | Out-Null
    $steps.Add(@("Шаг 38. Получение значения диаметра начала фланка", "DC=DL1-2*F", "DC=$DC")) | Out-Null
    $steps.Add(@("Шаг 39. Получение значения угла давления на диаметре DC", "AC=arccos((DD1*cos(AU))/DC)", "AC=$([math]::Round($AC, 12))")) | Out-Null
    $steps.Add(@("Шаг 40. Получение значения угла давления на диаметре DC фланка", "AFC=arccos((DD1*cos(AUF))/DC)", "AFC=$([math]::Round($AFC, 12))")) | Out-Null
    $steps.Add(@("Шаг 41. Получение значения расстояния от начала фланка до делительной прямой", "HF=复杂公式", "HF=$([math]::Round($HF, 12))")) | Out-Null
    $steps.Add(@("Шаг 42. Получение значения чертежных размеров фланка", "E=(HU1+HF)/cos(AU)", "E=$([math]::Round($E, 12))")) | Out-Null
    $steps.Add(@("Шаг 43. Получение угла давления на головке зуба шестерни", "AE=arccos((DD1*cos(AU))/DL1)", "AE=$([math]::Round($AE, 12))")) | Out-Null
    $steps.Add(@("Шаг 44. Получение толщины головки зуба шестерни", "SE=DL1*(SD2/DD1+inv(UD)-inv(AE))", "SE=$([math]::Round($SE, 12))")) | Out-Null
    $steps.Add(@("Шаг 45. Получение толщины зуба на диаметре DC", "SC=DC*(SD2/DD1+inv(UD)-inv(AC))", "SC=$([math]::Round($SC, 12))")) | Out-Null
    $steps.Add(@("Шаг 46. Получение угла давления на головке зуба шестерни для фланка", "AFE=arccos((DD1*cos(AUF))/DL1)", "AFE=$([math]::Round($AFE, 12))")) | Out-Null
    $steps.Add(@("Шаг 47. Получение толщины головки зуба шестерни для фланка", "SFE=DL1*(SC/DC+inv(AFC)-inv(AFE))", "SFE=$([math]::Round($SFE, 12))")) | Out-Null
    $steps.Add(@("Шаг 48. Получение среза головки зуба на одну сторону", "Q=(SE-SFE)/2", "Q=$([math]::Round($Q, 12))")) | Out-Null
    $steps.Add(@("Шаг 49. Получение посадочного диаметра фрезы", "DPOS=$DPOS", "DPOS=$DPOS")) | Out-Null
    $steps.Add(@("Шаг 50. Получение диаметра выступающей части фрезы", "DZAKR=$DZAKR", "DZAKR=$DZAKR")) | Out-Null
    $steps.Add(@("Шаг 51. Получение ширины выступающей части фрезы", "LZAKR=$LZAKR", "LZAKR=$LZAKR")) | Out-Null
    $steps.Add(@("Шаг 52. Получение ширины слева и справа до полости", "LPOL=$LPOL_val", "LPOL=$LPOL_val")) | Out-Null

    return $steps
}

# ==============================================================================
# ПОШАГОВАЯ СИСТЕМА ДИНАМИЧЕСКИХ ВЫЧИСЛЕНИЙ
# ==============================================================================
function Get-DynamicSteps {
    $M   = Get-Val "Модуль нормальный (M)"
    $UD  = Get-Val "Угол профиля (UD)"
    $ZU  = Get-Val "Число зубьев фрезы (ZU)"
    $DLU = Get-Val "Наружный диаметр фрезы (DLU)"
    $U   = Get-Val "Число заходов (U)"
    $DL  = Get-Val "Длина фрезы (DL)"
    $AV  = Get-Val "Задний угол (AV)"
    
    $Z1   = Get-Val "Число зубьев (Z1)"
    $DL1  = Get-Val "Наружный диаметр (DL1)"
    $X1   = Get-Val "Коэффициент смещения (X1)"
    $H1   = Get-Val "Высота головки зуба (H1)"
    $H    = Get-Val "Полная высота зуба (H)"
    $SD1  = Get-Val "Толщина зуба по I оконч. (SD1)"
    $SD2  = Get-Val "Дуга дел. окр. I под шевинг. (SD2)"
    $DRD  = Get-Val "Диаметр ролика (DRD)"
    
    $Z2  = Get-Val "Число зубьев (Z2)"
    $DL2 = Get-Val "Наружный диаметр (DL2)"
    $X2  = Get-Val "Коэф. смещения (X2)"

    $steps = New-Object System.Collections.ArrayList

    if ($null -eq $M -or $null -eq $UD -or $null -eq $SD1 -or $null -eq $H1 -or $null -eq $H) {
        $steps.Add(@("КРИТИЧЕСКАЯ ОШИБКА РАСЧЕТА", "Не заполнены базовые параметры", "Заполните M, UD, SD1, H1, H для старта")) | Out-Null
        return $steps
    }

    $AU = $UD
    $AU_rad = $AU * [math]::PI / 180.0
    $MU = $M
    $TU = [math]::PI * $MU
    $SU_no = $TU - $SD1
    $HU1 = $H - $H1
    $HU = $H + 0.3 * $M

    $steps.Add(@("1. Расчет профильного угла по нормали", "AU = UD", "AU = $AU")) | Out-Null
    $steps.Add(@("2. Расчет модуля нормального", "MU = M", "MU = $MU")) | Out-Null
    $steps.Add(@("3. Расчет шага нормального", "TU = Pi * MU = 3.14159 * $MU", "TU = $([math]::Round($TU, 12)) мм")) | Out-Null
    $steps.Add(@("4. Расчет толщины зуба без учета припуска", "SU = TU - SD1 = $([math]::Round($TU,4)) - $SD1", "SU = $([math]::Round($SU_no, 12)) мм")) | Out-Null
    $steps.Add(@("5. Получение расчетной высоты головки фрезы", "HU1 = H - H1 = $H - $H1", "HU1 = $HU1 мм")) | Out-Null
    $steps.Add(@("6. Получение полной высоты зуба", "HU = H + 0.3 * M = $H + 1.5", "HU = $HU мм")) | Out-Null

    if ($null -ne $DLU) {
        $steps.Add(@("7. Наружный диаметр фрезы", "DLU = константа", "DLU = $DLU мм")) | Out-Null
    }
    if ($null -ne $ZU) {
        $steps.Add(@("8. Число зубьев фрезы", "ZU = константа", "ZU = $ZU")) | Out-Null
    }

    if ($null -ne $DLU -and $null -ne $ZU -and $null -ne $AV) {
        $AV_rad = $AV * [math]::PI / 180.0
        $K = ([math]::PI * $DLU / $ZU) * [math]::Tan($AV_rad)
        $steps.Add(@("9. Получение падения затылка", "K = (Pi * DLU / ZU) * tg(AV)", "K = $([math]::Round($K, 12)) мм")) | Out-Null

        $DU = $DLU - 2.0 * $HU1 - 0.5 * $K
        $W_rad = [math]::Asin(($MU * $U) / $DU)
        $W = $W_rad * 180.0 / [math]::PI
        $steps.Add(@("10. Получение диаметра начальной окружности фрезы", "DU = DLU - 2*HU1 - 0.5*K", "DU = $([math]::Round($DU, 12)) мм")) | Out-Null

        if ($null -ne $U) {
            $steps.Add(@("11. Получение угла подъема витков на начальной окружности", "W = arcsin((MU * U) / DU)", "W = $([math]::Round($W, 12))°")) | Out-Null

            $TX = ($TU * $U) / [math]::Cos($W_rad)
            $steps.Add(@("12. Получение хода витков по оси", "TX = (TU * U) / cos(W)", "TX = $([math]::Round($TX, 12)) мм")) | Out-Null
        }
    }

    $steps.Add(@("13. Направление витков фрезы", "Направление спирали режущей части", "NAPR = Правое")) | Out-Null
    $steps.Add(@("14. Направление винтовых стружечных канавок", "Положение канавок для вывода стружки", "NKAN=Осевые")) | Out-Null

    if ($null -ne $K) {
        $DT = $DLU - 2 * $HU1 - 0.2 * $K
        $steps.Add(@("15. Получение среднего расчетного диаметра", "DT = DLU - 2*HU1 - 0.2*K", "DT = $([math]::Round($DT, 12)) мм")) | Out-Null

        $K1 = 1.3 * $K
        $steps.Add(@("16. Получение двойного затылования", "K1 = 1.3 * K", "K1 = $([math]::Round($K1, 12)) мм")) | Out-Null

        $HK = $HU + (($K + $K1) / 2.0) + 0.7
        $steps.Add(@("17. Получение глубины канавки", "HK = HU + (K + K1)/2 + 0.7", "HK = $([math]::Round($HK, 12)) мм")) | Out-Null
    }

    $R1 = (0.12 * $MU) / (1.0 - [math]::Sin($AU_rad))
    $steps.Add(@("18. Получение радиуса закругления головки зуба", "R1=(0.12*MU)/(1-sin(AU))", "R1=$([math]::Round($R1, 12))")) | Out-Null
    $steps.Add(@("19. Получение радиуса закругления у ножки зуба", "R2=0.3*M", "R2=$R2")) | Out-Null
    $steps.Add(@("20. Получение шага по оси", "T0=TU/cos(W)", "T0=$([math]::Round($T0, 12))")) | Out-Null
    $steps.Add(@("21. Получение осевого шага винтовой стружечной канавки", "T=T0*sgr(ctg(W))", "T=$([math]::Round($T, 9))")) | Out-Null
    $steps.Add(@("22. Получение профильного угла по оси", "AOC=arctg(tg(AU)/cos(W))", "AOC=$([math]::Round($AOC, 12))")) | Out-Null
    $steps.Add(@("23. Получение толщины зуба исходной рейки по оси", "SOC=TU/2*cos(W)", "SOC=$([math]::Round($SOC, 12))")) | Out-Null
    $steps.Add(@("24. Получение высоты головки зуба исходной рейки", "HUR=((SOC-SU/cos(W))/(2*tg(AOC)))+HU1", "HUR=$([math]::Round($HUR, 12))")) | Out-Null

    # Расчеты зацепления сопряженной пары (25-27)
    if ($null -ne $Z2 -and $null -ne $X2 -and $null -ne $X1) {
        $inv_UD = [math]::Tan($AU_rad) - $AU_rad
        $inv_AW = (2.0 * ($X2 + $X1) * [math]::Tan($AU_rad)) / ($Z2 + $Z1) + $inv_UD
        $AW_z_rad = Get-AlphaFromInv $inv_AW
        $AW_z = $AW_z_rad * 180.0 / [math]::PI
        $steps.Add(@("25. Получение инвалюты угла зацепления", "INVAW = (2*(X2+X1)*tg(UD))/(Z2+Z1) + inv(UD)", "INVAW = $([math]::Round($inv_AW, 12))")) | Out-Null
        $steps.Add(@("26. Получение угла зацепления", "AW = inv_back(INVAW)", "AW = $([math]::Round($AW_z, 12))°")) | Out-Null

        $A12_calc = 0.5 * $M * ($Z2 + $Z1) * ([math]::Cos($AU_rad) / [math]::Cos($AW_z_rad))
        $steps.Add(@("27. Получение межосевого расстояния передачи", "A12 = 0.5*M*(Z2+Z1)*(cos(UD)/cos(AW))", "A12 = $([math]::Round($A12_calc, 12)) мм")) | Out-Null
    } else {
        $steps.Add(@("Шаги 25-27 пропущены", "Не заполнены параметры Z2, X2 сопряженной детали.", "Пропущено")) | Out-Null
    }

    # Делительные диаметры
    $DD1 = $M * $Z1
    $steps.Add(@("28. Получение делительного диаметра детали", "DD1 = M * Z1 = $M * $Z1", "DD1 = $DD1 мм")) | Out-Null

    if ($null -ne $Z2) {
        $DD2 = $M * $Z2
        $steps.Add(@("29. Получение делительного диаметра сопряженной детали", "DD2 = M * Z2 = $M * $Z2", "DD2 = $DD2 мм")) | Out-Null
    }

    $DO1 = $DD1 * [math]::Cos($AU_rad)
    $steps.Add(@("30. Получение основного диаметра детали", "DO1 = DD1 * cos(UD)", "DO1 = $([math]::Round($DO1, 12)) мм")) | Out-Null

    if ($null -ne $Z2) {
        $DO2 = $DD2 * [math]::Cos($AU_rad)
        $steps.Add(@("31. Получение основного диаметра сопряженной детали", "DO2 = DD2 * cos(UD)", "DO2 = $([math]::Round($DO2, 12)) мм")) | Out-Null
    }

    # Расчет фасок и фланкирования (32-48)
    if ($null -ne $A12_calc -and $null -ne $DL2) {
        $P1 = $A12_calc * [math]::Sin($AW_z_rad) - 0.5 * [math]::Sqrt([math]::Pow($DL2, 2) - [math]::Pow($DO2, 2))
        $steps.Add(@("32. Получение радиуса кривизны эвольвенты", "P1 = A12*sin(AW) - 0.5*sqrt(DL2^2-DO2^2)", "P1 = $([math]::Round($P1, 12)) мм")) | Out-Null

        $SD2_val = if ($null -ne $SD2) { $SD2 } else { $SD1 }
        $HY = $HU1 - (($DD1 / 2.0) * [math]::Sin($AU_rad) - $P1 - (($SD2_val - $SD1) / 2.0) * [math]::Sin($AU_rad))
        $steps.Add(@("33. Получение расстояния до активного участка", "HY = HU1 - (DD1/2*sin(AU) - P1 - (SD2-SD1)/2*sin(AU))", "HY = $([math]::Round($HY, 12)) мм")) | Out-Null

        if ($null -ne $AOC_rad) {
            $C = $HY / [math]::Cos($AOC_rad)
            $steps.Add(@("34. Получение длины усика для фрез", "C = HY / cos(AOC)", "C = $([math]::Round($C, 12)) мм")) | Out-Null
        }

        $A_val = (($SD2_val - $SD1) / 2.0) + 0.05
        $steps.Add(@("35. Получение значения высоты усика", "A = (SD2 - SD1)/2 + 0.05", "A = $A_val мм")) | Out-Null
    }

    $F = 0.75
    $steps.Add(@("36. Величина фаски зуба фрезы", "F = константа", "F = $F мм")) | Out-Null

    $AUF = $AU + 10.0
    $AUF_rad = $AUF * [math]::PI / 180.0
    $steps.Add(@("37. Получение значения угла фланка фрезы", "AUF = AU + 10 = $AU + 10", "AUF = $AUF°")) | Out-Null

    $DC = $DL1 - 2.0 * $F
    $steps.Add(@("38. Получение диаметра начала фланка", "DC = DL1 - 2*F = $DL1 - 1.5", "DC = $DC мм")) | Out-Null

    $AC_rad = [math]::Acos(($DD1 * [math]::Cos($AU_rad)) / $DC)
    $AC = $AC_rad * 180.0 / [math]::PI
    $steps.Add(@("39. Получение угла давления на диаметре DC", "AC = arccos((DD1*cos(AU))/DC)", "AC = $([math]::Round($AC, 12))°")) | Out-Null

    $AFC_rad = [math]::Acos(($DD1 * [math]::Cos($AUF_rad)) / $DC)
    $AFC = $AFC_rad * 180.0 / [math]::PI
    $steps.Add(@("40. Получение угла давления на диаметре DC фланка", "AFC = arccos((DD1*cos(AUF))/DC)", "AFC = $([math]::Round($AFC, 12))°")) | Out-Null

    # Шаг 41: Высота фланка HF
    $num_HF = $DD1 * ([math]::Tan($AU_rad) - $AU_rad - [math]::Tan($AC_rad) + $AC_rad - [math]::Tan($AUF_rad) + $AUF_rad + [math]::Tan($AFC_rad) - $AFC_rad)
    $den_HF = 2.0 * ([math]::Tan($AU_rad) - [math]::Tan($AUF_rad))
    $HF = $num_HF / $den_HF
    $steps.Add(@("41. Получение расстояния от начала фланка до делительной прямой", "HF = сложная трансцендентная функция углов зацепления", "HF = $([math]::Round($HF, 12)) мм")) | Out-Null

    $E = ($HU1 + $HF) / [math]::Cos($AU_rad)
    $steps.Add(@("42. Получение чертежного размера фланка E", "E = (HU1 + HF) / cos(AU)", "E = $([math]::Round($E, 12)) мм")) | Out-Null

    $AE_rad = [math]::Acos(($DD1 * [math]::Cos($AU_rad)) / $DL1)
    $AE = $AE_rad * 180.0 / [math]::PI
    $steps.Add(@("43. Получение угла давления на головке зуба шестерни", "AE = arccos((DD1*cos(AU))/DL1)", "AE = $([math]::Round($AE, 12))°")) | Out-Null

    $SD2_val = if ($null -ne $SD2) { $SD2 } else { $SD1 }
    $inv_AE = [math]::Tan($AE_rad) - $AE_rad
    $SE = $DL1 * (($SD2_val / $DD1) + $inv_UD - $inv_AE)
    $steps.Add(@("44. Получение толщины головки зуба шестерни SE", "SE = DL1*(SD2/DD1 + inv(UD) - inv(AE))", "SE = $([math]::Round($SE, 12)) мм")) | Out-Null

    $inv_AC = [math]::Tan($AC_rad) - $AC_rad
    $SC = $DC * (($SD2_val / $DD1) + $inv_UD - $inv_AC)
    $steps.Add(@("45. Получение толщины зуба на диаметре фланка SC", "SC = DC*(SD2/DD1 + inv(UD) - inv(AC))", "SC = $([math]::Round($SC, 12)) мм")) | Out-Null

    $AFE_rad = [math]::Acos(($DD1 * [math]::Cos($AUF_rad)) / $DL1)
    $AFE = $AFE_rad * 180.0 / [math]::PI
    $steps.Add(@("46. Получение угла давления на головке зуба для фланка", "AFE = arccos((DD1*cos(AUF))/DL1)", "AFE = $([math]::Round($AFE, 12))°")) | Out-Null

    $inv_AFC = [math]::Tan($AFC_rad) - $AFC_rad
    $inv_AFE = [math]::Tan($AFE_rad) - $AFE_rad
    $SFE = $DL1 * (($SC / $DC) + $inv_AFC - $inv_AFE)
    $steps.Add(@("47. Получение толщины головки зуба шестерни (фланк) SFE", "SFE = DL1*(SC/DC + inv(AFC) - inv(AFE))", "SFE = $([math]::Round($SFE, 12)) мм")) | Out-Null

    $Q = ($SE - $SFE) / 2.0
    $steps.Add(@("48. Получение величины среза головки зуба на одну сторону Q", "Q = (SE - SFE)/2", "Q = $([math]::Round($Q, 12)) мм")) | Out-Null

    # Конструктивные элементы вала
    $DPOS = if ($DLU -ge 90) { 32 } elseif ($DLU -ge 70) { 27 } else { 22 }
    $steps.Add(@("49. Получение посадочного диаметра фрезы", "DPOS = выбран конструктивно", "DPOS = $DPOS мм")) | Out-Null

    $DZAKR = $DPOS + 18
    $steps.Add(@("50. Получение диаметра выступающей части фрезы", "DZAKR = выбран конструктивно", "DZAKR = $DZAKR мм")) | Out-Null

    $steps.Add(@("51. Получение ширины выступающей части фрезы", "LZAKR = выбран конструктивно", "LZAKR = 4 мм")) | Out-Null
    $steps.Add(@("52. Получение ширины слева и справа до полости", "LPOL = выбран конструктивно", "LPOL = 20 мм")) | Out-Null

    return $steps
}

# Вспомогательное построение полей в родительской группе
function Add-InputRow {
    param(
        [System.Windows.Forms.GroupBox]$Parent,
        [string]$LabelText,
        [int]$Y,             
        [int]$InputX,        
        [string]$ControlType = "TextBox",
        [string]$DefaultValue = "",
        [string[]]$ComboItems = @()
    )
    
    $lbl = New-Object System.Windows.Forms.Label
    $lbl.Text = $LabelText
    $lbl.Location = New-Object System.Drawing.Point(10, $Y)
    $lbl.Font = New-Object System.Drawing.Font("Tahoma", 8)
    $lbl.AutoSize = $true
    $Parent.Controls.Add($lbl)

    if ($ControlType -eq "ComboBox") {
        $input = New-Object System.Windows.Forms.ComboBox
        $input.DropDownStyle = [System.Windows.Forms.ComboBoxStyle]::DropDownList
        $input.Font = New-Object System.Drawing.Font("Tahoma", 8)
        if ($ComboItems.Count -gt 0) {
            $input.Items.AddRange($ComboItems)
        }
        $input.Text = $DefaultValue
    } else {
        $input = New-Object System.Windows.Forms.TextBox
        $input.Font = New-Object System.Drawing.Font("Tahoma", 8)
        $input.Text = $DefaultValue
    }
    
    $input.Location = New-Object System.Drawing.Point($InputX, ([int]$Y - 3))
    $input.Size = New-Object System.Drawing.Size(80, 20)
    $Parent.Controls.Add($input)
    
    $script:UI_Elements[$LabelText] = $input
}

