# ПОЛНЫЙ МАТЕМАТИЧЕСКИЙ РАСЧЕТТНЫЙ БЛОК (52 ШАГА)
# ==============================================================================
function Get-CalculationSteps {
    $M     = Get-Val "Модуль нормальный (M)" 5.0
    $UD    = Get-Val "Угол профиля (UD)" 30.0
    $ZU    = Get-Val "Число зубьев фрезы (ZU)" 10.0
    $DLU   = Get-Val "Наружный диаметр фрезы (DLU)" 90.0
    $U     = Get-Val "Число заходов (U)" 1.0
    $DL    = Get-Val "Длина фрезы (DL)" 85.0
    $AV    = Get-Val "Задний угол (AV)" 4.0
    $Z2    = Get-Val "Число зубьев (Z2)" 27.0
    $DL2   = Get-Val "Наружный диаметр (DL2)" 145.0
    $X2    = Get-Val "Коэф. смещения (X2)" 0.0
    $Z1    = Get-Val "Число зубьев (Z1)" 27.0
    $DL1   = Get-Val "Наружный диаметр (DL1)" 145.0
    $X1    = Get-Val "Коэффициент смещения (X1)" 0.0
    $H1    = Get-Val "Высота головки зуба (H1)" 5.0
    $H     = Get-Val "Полная высота зуба (H)" 8.5
    $SD1   = Get-Val "Толщина зуба по I оконч. (SD1)" 7.578
    $SD2   = Get-Val "Дуга дел. окр. I под шевинг. (SD2)" 7.578
    $DRD   = Get-Val "Диаметр ролика (DRD)" 8.4
    $A12_UI= Get-Val "Межосевое расстояние (A12)" 136.476

    $steps = New-Object System.Collections.ArrayList

    # Прямая конвертация без вызова функций для обхода багов парсера PowerShell
    $AU = $UD
    $AU_rad = $AU * [math]::PI / 180.0
    $MU = $M
    $TU = [math]::PI * $MU
    $SU_no = $TU - $SD1
    $HU1 = $H - $H1
    $HU = $H + 0.3 * $M
    
    # 9. Падение затылка
    $AV_rad = $AV * [math]::PI / 180.0
    $K = ([math]::PI * $DLU / $ZU) * [math]::Tan($AV_rad)
    
    $DU = $DLU - 2 * $HU1 - 0.5 * $K
    $W_rad = [math]::Asin(($MU * $U) / $DU)
    $W = $W_rad * 180.0 / [math]::PI
    
    $TX = ($TU * $U) / [math]::Cos($W_rad)
    $DT = $DLU - 2 * $HU1 - 0.2 * $K
    $K1 = 1.3 * $K
    $HK = $HU + (($K + $K1) / 2.0) + 0.7
    $R1 = (0.12 * $MU) / (1.0 - [math]::Sin($AU_rad))
    $R2 = 0.3 * $M
    $T0 = $TU / [math]::Cos($W_rad)
    $T = $T0 * [math]::Pow((1.0 / [math]::Tan($W_rad)), 2)
    
    $AOC_rad = [math]::Atan([math]::Tan($AU_rad) / [math]::Cos($W_rad))
    $AOC = $AOC_rad * 180.0 / [math]::PI
    
    $SOC = $TU / (2.0 * [math]::Cos($W_rad))
    $SU_with = $SU_no - (0.532559265 * $M)
    $HUR = (($SOC - ($SU_with / [math]::Cos($W_rad))) / (2.0 * [math]::Tan($AOC_rad))) + $HU1

    $inv_UD = [math]::Tan($AU_rad) - $AU_rad
    $inv_AW = (2.0 * ($X2 + $X1) * [math]::Tan($AU_rad)) / ($Z2 + $Z1) + $inv_UD
    $AW_z_rad = Get-AlphaFromInv $inv_AW
    $AW_z = $AW_z_rad * 180.0 / [math]::PI
    $A12_calc = 0.5 * $M * ($Z2 + $Z1) * ([math]::Cos($AU_rad) / [math]::Cos($AW_z_rad))

    $DD1 = $M * $Z1
    $DD2 = $M * $Z2
    $DO1 = $DD1 * [math]::Cos($AU_rad)
    $DO2 = $DD2 * [math]::Cos($AU_rad)

    $P1 = $A12_calc * [math]::Sin($AW_z_rad) - 0.5 * [math]::Sqrt([math]::Pow($DL2, 2) - [math]::Pow($DO2, 2))
    $HY = $HU1 - (($DD1 / 2.0) * [math]::Sin($AU_rad) - $P1 - (($SD2 - $SD1) / 2.0) * [math]::Sin($AU_rad))
    $C = $HY / [math]::Cos($AOC_rad)
    $A = (($SD2 - $SD1) / 2.0) + 0.05
    $F = 0.75
    $AUF = $AU + 10.0
    $AUF_rad = $AUF * [math]::PI / 180.0
    $DC = $DL1 - 2.0 * $F
    
    $AC_rad = [math]::Acos(($DD1 * [math]::Cos($AU_rad)) / $DC)
    $AC = $AC_rad * 180.0 / [math]::PI
    $AFC_rad = [math]::Acos(($DD1 * [math]::Cos($AUF_rad)) / $DC)
    $AFC = $AFC_rad * 180.0 / [math]::PI

    # Расчет HF
    $num_HF = $DD1 * ([math]::Tan($AU_rad) - $AU_rad - [math]::Tan($AC_rad) + $AC_rad - [math]::Tan($AUF_rad) + $AUF_rad + [math]::Tan($AFC_rad) - $AFC_rad)
    $den_HF = 2.0 * ([math]::Tan($AU_rad) - [math]::Tan($AUF_rad))
    $HF = $num_HF / $den_HF

    $E = ($HU1 + $HF) / [math]::Cos($AU_rad)
    $AE_rad = [math]::Acos(($DD1 * [math]::Cos($AU_rad)) / $DL1)
    $AE = $AE_rad * 180.0 / [math]::PI
    
    # Инвалюты шагов
    $inv_AE = [math]::Tan($AE_rad) - $AE_rad
    $inv_AC = [math]::Tan($AC_rad) - $AC_rad
    $inv_AFC = [math]::Tan($AFC_rad) - $AFC_rad
    
    $SE = $DL1 * (($SD2 / $DD1) + $inv_UD - $inv_AE)
    $SC = $DC * (($SD2 / $DD1) + $inv_UD - $inv_AC)
    
    $AFE_rad = [math]::Acos(($DD1 * [math]::Cos($AUF_rad)) / $DL1)
    $AFE = $AFE_rad * 180.0 / [math]::PI
    $inv_AFE = [math]::Tan($AFE_rad) - $AFE_rad
    
    $SFE = $DL1 * (($SC / $DC) + $inv_AFC - $inv_AFE)
    $Q = ($SE - $SFE) / 2.0

    $DPOS = if ($DLU -ge 90) { 32 } elseif ($DLU -ge 70) { 27 } else { 22 }
    $DZAKR = $DPOS + 18
    $LZAKR = 4
    $LPOL_val = 20

    # Шаги 1-52
    $steps.Add(@("Шаг 1. Расчет профильного угла по нормали", "AU=UD=30", "AU=30")) | Out-Null
    $steps.Add(@("Шаг 2. Расчет модуля нормального", "MU=M=5", "MU=5")) | Out-Null
    $steps.Add(@("Шаг 3. Расчет шага нормального", "TU=Pi*MU", "TU=$([math]::Round($TU, 12))")) | Out-Null
    $steps.Add(@("Шаг 4. Расчет толщины зуба по нормали без учета припуска", "SU=TU-SD1", "SU=$([math]::Round($SU_no, 12))")) | Out-Null
    $steps.Add(@("Шаг 5. Получение расчетной высоты головки фрезы", "HU1=H-H1", "HU1=$HU1")) | Out-Null
    $steps.Add(@("Шаг 6. Получение полной высоты зуба", "HU=H+0.3*M", "HU=$HU")) | Out-Null
    $steps.Add(@("Шаг 7. Наружный диаметр фрезы", "DLU=$DLU", "DLU=$DLU")) | Out-Null
    $steps.Add(@("Шаг 8. Число зубьев фрезы", "ZU=$ZU", "ZU=$ZU")) | Out-Null
    $steps.Add(@("Шаг 9. Получение падения затылка", "K=(Pi*DLU/ZU)*tg(AV)", "K=$([math]::Round($K, 12))")) | Out-Null
    $steps.Add(@("Шаг 10. Получение диаметра начальной окружности фрезы", "DU=DLU-2*HU1-0.5*K", "DU=$([math]::Round($DU, 12))")) | Out-Null
    $steps.Add(@("Шаг 11. Получение угла подъема витков на начальной окружности", "W=arcsin((MU*U)/DU)", "W=$([math]::Round($W, 12))")) | Out-Null
    $steps.Add(@("Шаг 12. Получение хода витков по оси", "TX=(TU*U)/cos(W)", "TX=$([math]::Round($TX, 12))")) | Out-Null
    $steps.Add(@("Шаг 13. Определение направления витков фрезы", "Правое", "NAPR=Правое")) | Out-Null
    $steps.Add(@("Шаг 14. Направление винтовых стружечных канавок", "Стружечные канавки осевые", "NKAN=Осевые")) | Out-Null
    $steps.Add(@("Шаг 15. Получение среднего расчетного диаметра", "DT=DLU-2*HU1-0.2*K", "DT=$([math]::Round($DT, 12))")) | Out-Null
    $steps.Add(@("Шаг 16. Получение двойного затылования", "K1=1.3*K", "K1=$([math]::Round($K1, 12))")) | Out-Null
    $steps.Add(@("Шаг 17. Получение глубины канавки", "HK=HU+(K+K1)/2+0.7", "HK=$([math]::Round($HK, 12))")) | Out-Null
    $steps.Add(@("Шаг 18. Получение радиуса закругления головки зуба", "R1=(0.12*MU)/(1-sin(AU))", "R1=$([math]::Round($R1, 12))")) | Out-Null
    $steps.Add(@("Шаг 19. Получение радиуса закругления у ножки зуба", "R2=0.3*M", "R2=$R2")) | Out-Null
    $steps.Add(@("Шаг 20. Получение шага по оси", "T0=TU/cos(W)", "T0=$([math]::Round($T0, 12))")) | Out-Null
    $steps.Add(@("Шаг 21. Получение осевого шага винтовой стружечной канавки", "T=T0*sgr(ctg(W))", "T=$([math]::Round($T, 9))")) | Out-Null
    $steps.Add(@("Шаг 22. Получение профильного угла по оси", "AOC=arctg(tg(AU)/cos(W))", "AOC=$([math]::Round($AOC, 12))")) | Out-Null
    $steps.Add(@("Шаг 23. Получение толщины зуба исходной рейки по оси", "SOC=TU/2*cos(W)", "SOC=$([math]::Round($SOC, 12))")) | Out-Null
    $steps.Add(@("Шаг 24. Получение высоты головки зуба исходной рейки", "HUR=((SOC-SU/cos(W))/(2*tg(AOC)))+HU1", "HUR=$([math]::Round($HUR, 12))")) | Out-Null
    $steps.Add(@("Шаг 25. Получение инвалюты угла зацепления", "INVAW=(2*(X2+X1)*tg(UD))/(z2+z1)+inv(UD)", "INVAW=$([math]::Round($inv_AW, 12))")) | Out-Null
    $steps.Add(@("Шаг 26. Получение значения угла зацепления", "AW=inv_back(INVAW)", "AW=$([math]::Round($AW_z, 12))")) | Out-Null
    $steps.Add(@("Шаг 27. Получение значения межосевого расстояния", "A12=0.5*M*(Z2+Z1)*(cos(UD)/cos(AW))", "A12=$([math]::Round($A12_calc, 12))")) | Out-Null
    $steps.Add(@("Шаг 28. Получение диаметра делительной окружности детали", "DD1=M*Z1", "DD1=$DD1")) | Out-Null
    $steps.Add(@("Шаг 29. Получение диаметра делительной окружности сопряженной детали", "DD2=M*Z2", "DD2=$DD2")) | Out-Null
    $steps.Add(@("Шаг 30. Получение диаметра основной окружности детали", "DO1=DD1*cos(UD)", "DO1=$([math]::Round($DO1, 12))")) | Out-Null
    $steps.Add(@("Шаг 31. Получение диаметра основной окружности сопряженной детали", "DO2=DD2*cos(UD)", "DO2=$([math]::Round($DO2, 12))")) | Out-Null
    $steps.Add(@("Шаг 32. Получение радиуса кривизны эвольвенты", "P1=A12*sin(AW)-0.5*sqrt(DL2^2-DO2^2)", "P1=$([math]::Round($P1, 12))")) | Out-Null
    $steps.Add(@("Шаг 33. Получение расстояния от головки зуба фрезы до активного участка", "HY=HU1-((DD1/2)*sin(AU)-P1-(SD2-SD1)/2*sin(AU))", "HY=$([math]::Round($HY, 12))")) | Out-Null
    $steps.Add(@("Шаг 34. Получение длины усика для фрез с осевыми канавками", "C=HY/cos(AOC)", "C=$([math]::Round($C, 12))")) | Out-Null
    $steps.Add(@("Шаг 35. Получение значения высоты усика", "A=(SD2-SD1)/2+0.05", "A=$A")) | Out-Null
    $steps.Add(@("Шаг 36. Величина фаски зуба фрезы", "F=0.75", "F=$F")) | Out-Null
    $steps.Add(@("Шаг 37. Получение значения угла фланка", "AUF=AU+10", "AUF=$AUF")) | Out-Null
    $steps.Add(@("Шаг 38. Получение значения диаметра начала фланка", "DC=DL1-2*F", "DC=$DC")) | Out-Null
    $steps.Add(@("Шаг 39. Получение значения угла давления на диаметре DC", "AC=arccos((DD1*cos(AU))/DC)", "AC=$([math]::Round($AC, 12))")) | Out-Null
    $steps.Add(@("Шаг 40. Получение значения угла давления на диаметре DC фланка", "AFC=arccos((DD1*cos(AUF))/DC)", "AFC=$([math]::Round($AFC, 12))")) | Out-Null
    $steps.Add(@("Шаг 41. Получение значения расстояния от начала фланка до делительной прямой", "HF=复杂公式", "HF=$([math]::Round($HF, 12))")) | Out-Null
    $steps.Add(@("Шаг 42. Получение значения чертежных размеров фланка", "E=(HU1+HF)/cos(AU)", "E=$([math]::Round($E, 12))")) | Out-Null
    $steps.Add(@("Шаг 43. Получение угла давления на головке зуба шестерни", "AE=arccos((DD1*cos(AU))/DL1)", "AE=$([math]::Round($AE, 12))")) | Out-Null
    $steps.Add(@("Шаг 44. Получение толщины головки зуба шестерни", "SE=DL1*(SD2/DD1+inv(UD)-inv(AE))", "SE=$([math]::Round($SE, 12))")) | Out-Null
    $steps.Add(@("Шаг 45. Получение толщины зуба на диаметре DC", "SC=DC*(SD2/DD1+inv(UD)-inv(AC))", "SC=$([math]::Round($SC, 12))")) | Out-Null
    $steps.Add(@("Шаг 46. Получение угла давления на головке зуба шестерни для фланка", "AFE=arccos((DD1*cos(AUF))/DL1)", "AFE=$([math]::Round($AFE, 12))")) | Out-Null
    $steps.Add(@("Шаг 47. Получение толщины головки зуба шестерни для фланка", "SFE=DL1*(SC/DC+inv(AFC)-inv(AFE))", "SFE=$([math]::Round($SFE, 12))")) | Out-Null
    $steps.Add(@("Шаг 48. Получение среза головки зуба на одну сторону", "Q=(SE-SFE)/2", "Q=$([math]::Round($Q, 12))")) | Out-Null
    $steps.Add(@("Шаг 49. Получение посадочного диаметра фрезы", "DPOS=$DPOS", "DPOS=$DPOS")) | Out-Null
    $steps.Add(@("Шаг 50. Получение диаметра выступающей части фрезы", "DZAKR=$DZAKR", "DZAKR=$DZAKR")) | Out-Null
    $steps.Add(@("Шаг 51. Получение ширины выступающей части фрезы", "LZAKR=$LZAKR", "LZAKR=$LZAKR")) | Out-Null
    $steps.Add(@("Шаг 52. Получение ширины слева и справа до полости", "LPOL=$LPOL_val", "LPOL=$LPOL_val")) | Out-Null

    return $steps
}

