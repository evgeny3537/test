function Show-DbfViewer {
    param(
        [string]$FilePath,
        [int]$HighlightRecNo = -1,
        [string]$SearchTerm  = '',
        [System.Text.Encoding[]]$Encodings
    )

    $vForm = [System.Windows.Forms.Form]@{
        Text          = "Просмотр DBF: $([System.IO.Path]::GetFileName($FilePath))"
        Size          = [System.Drawing.Size]::new(1200, 750)
        StartPosition = 'CenterScreen'
        MinimumSize   = [System.Drawing.Size]::new(800, 500)
    }

    # ── Панель информации ──
    $pnlInfo = [System.Windows.Forms.Panel]@{
        Dock      = 'Top'
        Height    = 90
        BackColor = [System.Drawing.Color]::FromArgb(240, 248, 255)
    }

    $lblFilePath = [System.Windows.Forms.Label]@{
        Text      = "Файл: $FilePath"
        Location  = '8,6'
        Size      = '1160,18'
        Font      = [System.Drawing.Font]::new('Consolas', 8)
        ForeColor = [System.Drawing.Color]::DarkBlue
    }
    $lblMeta1 = [System.Windows.Forms.Label]@{ Location = '8,26'; Size = '580,18'; Font = [System.Drawing.Font]::new('Segoe UI', 9) }
    $lblMeta2 = [System.Windows.Forms.Label]@{ Location = '8,46'; Size = '780,18'; Font = [System.Drawing.Font]::new('Segoe UI', 9) }

    # Строка поиска внутри вьюера
    $lblFind = [System.Windows.Forms.Label]@{ Text = 'Фильтр:'; Location = '8,68'; AutoSize = $true }
    $txtFind = [System.Windows.Forms.TextBox]@{ Location = '62,65'; Size = '260,22'; Text = $SearchTerm }
    $btnFind = [System.Windows.Forms.Button]@{ Text = 'Найти'; Location = '332,63'; Size = '80,26' }
    $btnReset= [System.Windows.Forms.Button]@{ Text = 'Сброс'; Location = '420,63'; Size = '80,26' }
    $lblCount= [System.Windows.Forms.Label]@{ Location = '510,68'; AutoSize = $true; ForeColor = [System.Drawing.Color]::DarkRed }

    $pnlInfo.Controls.AddRange(@($lblFilePath,$lblMeta1,$lblMeta2,$lblFind,$txtFind,$btnFind,$btnReset,$lblCount))

    # ── Вкладки: Данные / Структура ──
    $tabs = [System.Windows.Forms.TabControl]@{ Dock = 'Fill' }
    $tabData   = [System.Windows.Forms.TabPage]@{ Text = '📋 Данные' }
    $tabStruct = [System.Windows.Forms.TabPage]@{ Text = '🗂 Структура полей' }
    $tabs.TabPages.AddRange(@($tabData, $tabStruct))

    # ── DataGridView для данных ──
    $grid = [System.Windows.Forms.DataGridView]@{
        Dock                    = 'Fill'
        ReadOnly                = $true
        AllowUserToAddRows      = $false
        AllowUserToDeleteRows   = $false
        AllowUserToResizeRows   = $false
        AutoSizeColumnsMode     = 'None'
        SelectionMode           = 'FullRowSelect'
        BackgroundColor         = [System.Drawing.Color]::White
        AlternatingRowsDefaultCellStyle = [System.Windows.Forms.DataGridViewCellStyle]@{
            BackColor = [System.Drawing.Color]::FromArgb(245, 250, 255)
        }
        ColumnHeadersDefaultCellStyle = [System.Windows.Forms.DataGridViewCellStyle]@{
            BackColor = [System.Drawing.Color]::FromArgb(70, 130, 180)
            ForeColor = [System.Drawing.Color]::White
            Font      = [System.Drawing.Font]::new('Segoe UI', 9, [System.Drawing.FontStyle]::Bold)
        }
        EnableHeadersVisualStyles = $false
        Font                    = [System.Drawing.Font]::new('Consolas', 9)
        RowHeadersWidth         = 50
    }

    # ── ListView для структуры полей ──
    $structView = [System.Windows.Forms.ListView]@{
        Dock          = 'Fill'
        View          = 'Details'
        FullRowSelect = $true
        GridLines     = $true
        Font          = [System.Drawing.Font]::new('Consolas', 10)
    }
    [void]$structView.Columns.Add('#',        40)
    [void]$structView.Columns.Add('Имя поля', 160)
    [void]$structView.Columns.Add('Тип',       70)
    [void]$structView.Columns.Add('Длина',      70)
    [void]$structView.Columns.Add('Дес.',       60)
    [void]$structView.Columns.Add('Описание',  360)

    # Расшифровка типов FoxPro
    $typeDesc = @{
        'C' = 'Character — строка'
        'N' = 'Numeric — число'
        'F' = 'Float — число с плавающей точкой'
        'D' = 'Date — дата (ГГГГММДД)'
        'T' = 'DateTime — дата и время'
        'L' = 'Logical — логическое (T/F)'
        'M' = 'Memo — длинный текст (FPT)'
        'G' = 'General — OLE-объект'
        'P' = 'Picture — изображение'
        'B' = 'Double — двойная точность'
        'I' = 'Integer — целое'
        'Y' = 'Currency — валюта'
        'V' = 'VarChar — переменная длина'
        'Q' = 'VarBinary'
        'W' = 'Blob'
    }

    $tabData.Controls.Add($grid)
    $tabStruct.Controls.Add($structView)

    # Статусбар
    $statusBar = [System.Windows.Forms.StatusStrip]::new()
    $statusLbl = [System.Windows.Forms.ToolStripStatusLabel]::new('Загрузка...')
    $statusBar.Items.Add($statusLbl) | Out-Null

    $vForm.Controls.AddRange(@($pnlInfo, $tabs, $statusBar))

    # ── Загрузка данных ──
    $dbfData  = $null
    $allRows  = $null
    $dt       = $null

    $vForm.Add_Shown({
        $vForm.UseWaitCursor = $true
        $statusLbl.Text = 'Загрузка файла...'
        [System.Windows.Forms.Application]::DoEvents()

        $dbfData = Read-DbfAllRecords -Path $FilePath -Encodings $Encodings -MaxRecords 10000
        if (-not $dbfData) {
            $statusLbl.Text = 'Ошибка чтения файла или файл повреждён.'
            $vForm.UseWaitCursor = $false
            return
        }

        $meta = $dbfData.Meta
        $lblMeta1.Text = "Записей: $($meta.NumRecords)  |  Полей: $($meta.Fields.Count)  |  Длина записи: $($meta.RecordLength) байт  |  Длина заголовка: $($meta.HeaderLength) байт"
        $lblMeta2.Text = "Кодировка: $($dbfData.Enc.WebName)  |  Файл: $([System.IO.FileInfo]::new($FilePath).Length) байт"

        # ── Заполнение структуры ──
        $structView.Items.Clear()
        $fIdx = 0
        foreach ($f in $meta.Fields) {
            $fIdx++
            $desc = if ($typeDesc.ContainsKey([string]$f.Type)) { $typeDesc[[string]$f.Type] } else { 'Неизвестный тип' }
            $lvi  = [System.Windows.Forms.ListViewItem]::new([string]$fIdx)
            [void]$lvi.SubItems.Add($f.Name)
            [void]$lvi.SubItems.Add([string]$f.Type)
            [void]$lvi.SubItems.Add([string]$f.Length)
            [void]$lvi.SubItems.Add(if ($f.Decimals -gt 0) { [string]$f.Decimals } else { '—' })
            [void]$lvi.SubItems.Add($desc)
            # Цветовая маркировка типов
            $lvi.BackColor = switch ([string]$f.Type) {
                'C'     { [System.Drawing.Color]::FromArgb(255, 255, 240) }
                'N'     { [System.Drawing.Color]::FromArgb(240, 255, 240) }
                'D'     { [System.Drawing.Color]::FromArgb(240, 248, 255) }
                'M'     { [System.Drawing.Color]::FromArgb(255, 240, 245) }
                'L'     { [System.Drawing.Color]::FromArgb(248, 248, 255) }
                default { [System.Drawing.Color]::White }
            }
            [void]$structView.Items.Add($lvi)
        }

        # ── Заполнение DataGridView ──
        $allRows = $dbfData.Records

        # Создаём DataTable для удобной работы
        $dt = [System.Data.DataTable]::new()
        [void]$dt.Columns.Add('#',   [string])
        [void]$dt.Columns.Add('Del', [string])
        foreach ($f in $meta.Fields) {
            [void]$dt.Columns.Add($f.Name, [string])
        }

        foreach ($rec in $allRows) {
            $row = $dt.NewRow()
            $props = $rec.PSObject.Properties
            foreach ($p in $props) {
                if ($dt.Columns.Contains($p.Name)) {
                    $row[$p.Name] = if ($null -eq $p.Value) { '' } else { [string]$p.Value }
                }
            }
            $dt.Rows.Add($row) | Out-Null
        }

        $grid.DataSource = $dt

        # Настройка ширины столбцов
        foreach ($col in $grid.Columns) {
            $col.SortMode = 'Automatic'
            $w = switch ($col.Name) {
                '#'     { 50  }
                'Del'   { 35  }
                default {
                    $f = $meta.Fields | Where-Object { $_.Name -eq $col.Name } | Select-Object -First 1
                    if ($f) { [Math]::Max(80, [Math]::Min(300, $f.Length * 8)) }
                    else    { 100 }
                }
            }
            $col.Width = $w
        }

        # Подсветка найденной записи
        if ($HighlightRecNo -gt 0 -and $HighlightRecNo -le $grid.Rows.Count) {
            $rowIdx = $HighlightRecNo - 1
            $grid.FirstDisplayedScrollingRowIndex = [Math]::Max(0, $rowIdx - 5)
            $grid.Rows[$rowIdx].Selected = $true
            $grid.Rows[$rowIdx].DefaultCellStyle.BackColor = [System.Drawing.Color]::Yellow
        }

        # Подсветка ячеек с термином поиска
        if ($SearchTerm.Length -gt 0) {
            $cmp = [StringComparison]::OrdinalIgnoreCase
            foreach ($row in $grid.Rows) {
                foreach ($cell in $row.Cells) {
                    if ($cell.Value -and [string]$cell.Value -and
                        ([string]$cell.Value).IndexOf($SearchTerm, $cmp) -ge 0) {
                        $cell.Style.BackColor = [System.Drawing.Color]::FromArgb(255, 220, 100)
                        $cell.Style.ForeColor = [System.Drawing.Color]::Black
                    }
                }
            }
        }

        $statusLbl.Text = "Загружено записей: $($allRows.Count) из $($meta.NumRecords)  |  Двойной клик — скопировать строку"
        $vForm.Text     = "Просмотр DBF: $([System.IO.Path]::GetFileName($FilePath))  [$($meta.NumRecords) зап., $($meta.Fields.Count) полей]"
        $vForm.UseWaitCursor = $false
        $lblCount.Text  = "Показано: $($allRows.Count)"
    })

    # ── Фильтрация по тексту ──
    $filterAction = {
        $fTerm = $txtFind.Text.Trim()
        if (-not $dt) { return }

        if ($fTerm.Length -eq 0) {
            $grid.DataSource = $dt
            $lblCount.Text   = "Показано: $($dt.Rows.Count)"
            return
        }

        $filtered = $dt.Clone()
        $cmp = [StringComparison]::OrdinalIgnoreCase
        foreach ($row in $dt.Rows) {
            $found = $false
            foreach ($col in $dt.Columns) {
                $val = [string]$row[$col.ColumnName]
                if ($val.IndexOf($fTerm, $cmp) -ge 0) { $found = $true; break }
            }
            if ($found) { $filtered.ImportRow($row) }
        }

        $grid.DataSource = $filtered
        $lblCount.Text   = "Найдено: $($filtered.Rows.Count) из $($dt.Rows.Count)"

        # Подсветка в отфильтрованных
        foreach ($row in $grid.Rows) {
            foreach ($cell in $row.Cells) {
                if ($cell.Value -and ([string]$cell.Value).IndexOf($fTerm, $cmp) -ge 0) {
                    $cell.Style.BackColor = [System.Drawing.Color]::FromArgb(255, 220, 100)
                }
            }
        }
    }

    $btnFind.Add_Click($filterAction)
    $txtFind.Add_KeyDown({
        if ($_.KeyCode -eq 'Return') { & $filterAction }
    })
    $btnReset.Add_Click({
        $txtFind.Text    = ''
        $grid.DataSource = $dt
        if ($dt) { $lblCount.Text = "Показано: $($dt.Rows.Count)" }
    })

    # ── Копирование строки по двойному клику ──
    $grid.Add_CellDoubleClick({
        if ($_.RowIndex -lt 0) { return }
        $row = $grid.Rows[$_.RowIndex]
        $parts = [System.Collections.Generic.List[string]]::new()
        foreach ($cell in $row.Cells) {
            $parts.Add("$($cell.OwningColumn.HeaderText): $($cell.Value)")
        }
        [System.Windows.Forms.Clipboard]::SetText($parts -join "`r`n")
        $statusLbl.Text = 'Строка скопирована в буфер обмена'
    })

    # ── Экспорт в CSV ──
    $btnExport = [System.Windows.Forms.Button]@{
        Text     = '💾 Экспорт CSV'
        Location = '660,63'
        Size     = '110,26'
    }
    $pnlInfo.Controls.Add($btnExport)

    $btnExport.Add_Click({
        if (-not $dt) { return }
        $dlg = [System.Windows.Forms.SaveFileDialog]@{
            Filter   = 'CSV файлы (*.csv)|*.csv'
            FileName = [System.IO.Path]::GetFileNameWithoutExtension($FilePath) + '.csv'
        }
        if ($dlg.ShowDialog() -ne 'OK') { return }
        $sb  = [System.Text.StringBuilder]::new()
        $hdr = ($dt.Columns | ForEach-Object { '"' + $_.ColumnName + '"' }) -join ';'
        [void]$sb.AppendLine($hdr)
        foreach ($row in $dt.Rows) {
            $line = ($dt.Columns | ForEach-Object { '"' + [string]$row[$_.ColumnName] + '"' }) -join ';'
            [void]$sb.AppendLine($line)
        }
        [System.IO.File]::WriteAllText($dlg.FileName, $sb.ToString(), [System.Text.Encoding]::UTF8)
        $statusLbl.Text = "Экспортировано: $($dlg.FileName)"
    })

    [void]$vForm.ShowDialog()
}

