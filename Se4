$folderDlg = [System.Windows.Forms.FolderBrowserDialog]@{
    Description = 'Выберите папку с файлами FoxPro'
}

$btnBrowse.Add_Click({
    if ($folderDlg.ShowDialog() -eq 'OK') { $txtFolder.Text = $folderDlg.SelectedPath }
})

$btnClear.Add_Click({
    $listView.Items.Clear()
    $progress.Value   = 0
    $statusLbl.Text   = 'Готово'
    $btnOpen.Enabled  = $false
})

# Активируем кнопку "Открыть" при выборе строки
$listView.Add_SelectedIndexChanged({
    $sel = $listView.SelectedItems
    if ($sel.Count -gt 0) {
        $ext = [System.IO.Path]::GetExtension($sel[0].Text).ToLowerInvariant()
        $btnOpen.Enabled = ($ext -eq '.dbf')
    } else {
        $btnOpen.Enabled = $false
    }
})

# Двойной клик — открыть вьюер
$listView.Add_DoubleClick({
    $sel = $listView.SelectedItems
    if ($sel.Count -eq 0) { return }
    $item = $sel[0]
    $ext  = [System.IO.Path]::GetExtension($item.Text).ToLowerInvariant()
    if ($ext -eq '.dbf') {
        $recNo = 0
        try { $recNo = [int]$item.SubItems[2].Text } catch {}
        Show-DbfViewer -FilePath $item.Text `
                       -HighlightRecNo $recNo `
                       -SearchTerm $txtTerm.Text.Trim() `
                       -Encodings (Get-TestEncodings)
    }
})

$btnOpen.Add_Click({
    $sel = $listView.SelectedItems
    if ($sel.Count -eq 0) { return }
    $item  = $sel[0]
    $recNo = 0
    try { $recNo = [int]$item.SubItems[2].Text } catch {}
    Show-DbfViewer -FilePath $item.Text `
                   -HighlightRecNo $recNo `
                   -SearchTerm $txtTerm.Text.Trim() `
                   -Encodings (Get-TestEncodings)
})

# ── ПОИСК ──
$btnSearch.Add_Click({
    $folder = $txtFolder.Text.Trim()
    $term   = $txtTerm.Text.Trim()

    if (-not (Test-Path -LiteralPath $folder)) {
        [System.Windows.Forms.MessageBox]::Show(
            'Укажите существующую папку.', 'Проверка',
            [System.Windows.Forms.MessageBoxButtons]::OK,
            [System.Windows.Forms.MessageBoxIcon]::Warning) | Out-Null
        return
    }
    if ([string]::IsNullOrWhiteSpace($term)) {
        [System.Windows.Forms.MessageBox]::Show(
            'Введите текст для поиска.', 'Проверка',
            [System.Windows.Forms.MessageBoxButtons]::OK,
            [System.Windows.Forms.MessageBoxIcon]::Warning) | Out-Null
        return
    }

    $listView.Items.Clear()
    $progress.Value      = 0
    $btnSearch.Enabled   = $false
    $btnClear.Enabled    = $false
    $btnOpen.Enabled     = $false
    $form.UseWaitCursor  = $true

    $encodings = Get-TestEncodings
    $exts      = '.dbf','.cdx','.fpt','.fpw','.mem','.fp','.tmp','.mnx','.mnt','.frx','.lbx','.vcx'
    $recurse   = $chkSubdir.Checked

    $files = @(Get-ChildItem -LiteralPath $folder -Recurse:$recurse -File -ErrorAction SilentlyContinue |
               Where-Object { $exts -contains $_.Extension.ToLowerInvariant() })

    $total = $files.Count
    if ($total -eq 0) {
        $statusLbl.Text    = 'Файлы не найдены.'
        $btnSearch.Enabled = $true
        $btnClear.Enabled  = $true
        $form.UseWaitCursor = $false
        return
    }

    $found = 0
    $i     = 0

    $colors = @(
        [System.Drawing.Color]::White,
        [System.Drawing.Color]::FromArgb(240, 248, 255)
    )
    $hitColor = [System.Drawing.Color]::FromArgb(255, 255, 200)

    foreach ($file in $files) {
        $i++
        $ext  = $file.Extension.ToLowerInvariant()
        $hits = @()

        if ($ext -eq '.dbf') {
            $hits = @(Search-DbfFile -Path $file.FullName -Term $term -Encodings $encodings)
            if ($hits.Count -eq 0) {
                $raw = @(Search-RawFile -Path $file.FullName -Term $term -Encodings $encodings)
                if ($raw.Count -gt 0) { $hits = $raw }
            }
        } else {
            $raw = @(Search-RawFile -Path $file.FullName -Term $term -Encodings $encodings)
            if ($raw.Count -gt 0) { $hits = $raw }
        }

        foreach ($hit in $hits) {
            $found++
            $recStr = if ($hit.RecNo -gt 0) { [string]$hit.RecNo } else { '—' }

            $lvi = [System.Windows.Forms.ListViewItem]::new($hit.Path)
            [void]$lvi.SubItems.Add($hit.Source)
            [void]$lvi.SubItems.Add($recStr)
            [void]$lvi.SubItems.Add($hit.Preview)

            $lvi.BackColor = if ($found % 2 -eq 0) { $colors[1] } else { $colors[0] }
            $lvi.UseItemStyleForSubItems = $true

            [void]$listView.Items.Add($lvi)
        }

        $progress.Value = [Math]::Min(100, [int](($i / $total) * 100))
        $statusLbl.Text = "Проверено: $i / $total  |  Найдено: $found"
        [System.Windows.Forms.Application]::DoEvents()
    }

    $statusLbl.Text    = "✅ Готово. Найдено: $found совпадений (файлов проверено: $total)  |  Двойной клик / кнопка 'Открыть DBF' — просмотр"
    $btnSearch.Enabled = $true
    $btnClear.Enabled  = $true
    $form.UseWaitCursor = $false
    $progress.Value    = 100
})

$form.AcceptButton = $btnSearch
[void]$form.ShowDialog()
